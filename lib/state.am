|| state.am -- strict state functor / applicative / monad
||
|| Note: the strictness of this implementation somewhat relies upon the inlining optimizations
|| in the compiler (e.g. inlining runState, (>>=), etc.) If this is compiled with inlining
|| disabled, then extra thunks are created which may cause space leaks


%export +

%import <base>
%import <lens>


state * ** == (* -> (**, *))

|| running
runState :: state * ** -> * -> (**, *)
runState m s = m s

evalState :: state * ** -> * -> **
evalState m s = fst $ runState m s

execState :: state * ** -> * -> *
execState m s = snd $ runState m s


|| state access
get :: state * *
get = \s -> (s, s)

put :: * -> state * ()
put s' = const ((), s')

modify :: (* -> *) -> state * ()
modify f = \s -> case f s of s' -> ((), s')


|| lift lens operations into state
view :: lens * ** -> state * **
view lns = get <&> lens.view lns

over :: lens * ** -> (** -> **) -> state * ()
over lns f = modify (lens.over lns f)

set :: lens * ** -> ** -> state * ()
set lns x = modify (lens.set lns x)


|| monad interface

pure :: ** -> state * **
pure a = \s -> (a, s)

(>>=) :: state * ** -> (** -> state * ***) -> state * ***
m >>= f = \s -> case runState m s of (a, s') -> runState (f a) s'

(>=>) :: (** -> state * ***) -> (*** -> state * ****) -> ** -> state * ****
f >=> g = \x -> f x >>= g

join :: state * (state * **) -> state * **
join ma = \s -> runState ma s |> uncurry runState

mapM :: (** -> state * ***) -> [**] -> state * [***]
mapM f xs = foldr (f .> liftA2 (:)) (pure []) xs

|| since mapM_ runs the function f for its effect only, and can be used on
|| very large ranges for the list, it is better to write and explicit loop with
|| a tail call, rather than a foldr with state operations
mapM_ :: (** -> state * ***) -> [**] -> state * ()
mapM_ f xs
    = go xs
      where
        go []       s = ((), s)
        go (x : xs) s = case f x of m -> case m s of (_, s') -> go xs s'

forM :: [**] -> (** -> state * ***) -> state * ()
forM xs f = mapM_ f xs

filterM :: (** -> state * bool) -> [**] -> state * [**]
filterM p xs
    = foldr check (pure []) xs
      where
        check x       = liftA2 (cond x) (p x)
        cond  x False = id
        cond  x True  = (x :)

foldM :: (*** -> ** -> state * ***) -> *** -> [**] -> state * ***
foldM f z0 xs
    = foldr c pure xs z0
      where
        c x k z = f z x >>= k

sequence :: [state * **] -> state * [**]
sequence xs = foldr (liftA2 (:)) (pure []) xs

sequence_ :: [state * **] -> state * ()
sequence_ xs = foldr (>>) (pure ()) xs


|| functor interface

(<$>) :: (** -> ***) -> state * ** -> state * ***
f <$> m = m >>= (f .> pure)

(<&>) :: state * ** -> (** -> ***) -> state * ***
m <&> f = f <$> m


|| applicative interface

(<*>) :: state * (** -> ***) -> state * ** -> state * ***
mf <*> ma = mf >>= (<$> ma)

liftA2 :: (** -> *** -> ****) -> state * ** -> state * *** -> state * ****
liftA2 f ma mb = f <$> ma <*> mb

liftA3 :: (** -> *** -> **** -> *****) -> state * ** -> state * *** -> state * **** -> state * *****
liftA3 f ma mb mc = liftA2 f ma mb <*> mc

liftA4 :: (** -> *** -> **** -> ***** -> ******) -> state * ** -> state * *** -> state * **** -> state * ***** -> state * ******
liftA4 f ma mb mc md = liftA3 f ma mb mc <*> md

liftA5 :: (** -> *** -> **** -> ***** -> ****** -> *******) -> state * ** -> state * *** -> state * **** -> state * ***** -> state * ****** ->
             state * *******
liftA5 f ma mb mc md me = liftA4 f ma mb mc md <*> me

liftA6 :: (** -> *** -> **** -> ***** -> ****** -> ******* -> ********) ->
             state * ** -> state * *** -> state * **** -> state * ***** -> state * ****** -> state * ******* -> state * ********
liftA6 f ma mb mc md me mf = liftA5 f ma mb mc md me <*> mf

(<<) :: state * ** -> state * *** -> state * **
ma << mb = liftA2 const ma mb

(>>) :: state * ** -> state * *** -> state * ***
ma >> mb = liftA2 (converse const) ma mb

|| lift multiple independent state actions and bind them to an N-ary function
bind2 :: state * ** -> state * *** -> (** -> *** -> state * ****) -> state * ****
bind2 ma mb f = join (liftA2 f ma mb)

bind3 :: state * ** -> state * *** -> state * **** -> (** -> *** -> **** -> state * *****) -> state * *****
bind3 ma mb mc f = join (liftA3 f ma mb mc)

bind4 :: state * ** -> state * *** -> state * **** -> state * ***** -> (** -> *** -> **** -> ***** -> state * ******) -> state * ******
bind4 ma mb mc md f = join (liftA4 f ma mb mc md)

bind5 :: state * ** -> state * *** -> state * **** -> state * ***** -> state * ****** ->
            (** -> *** -> **** -> ***** -> ****** -> state * *******) -> state * *******
bind5 ma mb mc md me f = join (liftA5 f ma mb mc md me)
