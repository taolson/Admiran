|| ioStream.am -- io with streams
||
|| This currently only implements "streamFile", which is a readFile replacement
|| that returns a stream of char rather than a list of char, which can prevent
|| space leaks on large files when the entire list is retained. It may be expanded
|| with more stream versions of io functions if they are useful.

%export +

%import <io>
%import <stream>

streamFile :: string -> io (stream char word#)
streamFile fn world
    = case allocByteStream# 256# of
        s# -> case writeByteStream s# fn of
                _ -> case openFileRead# s# of
                       fs# -> (Stream next fs#, world)
      where
        next fs#
            = case readByteStream# fs# of
                c# -> case c# $cmp# 0# of
                        1# -> case readFile# fs# of
                                0# -> case closeFile# fs# of _ -> Done
                                _  -> next fs#
                        _  -> Yield (C# c#) fs#
