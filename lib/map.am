|| map.am -- implementation of a strict map from key to value, using AVL trees


%export + avl.empty avl.null avl.isSingleton avl.size avl.first avl.last avl.toList

%import <avl>
%import <maybe>  as mb
%import <stdlib> as std

map * ** == avlTree (*, **)

singleton :: * -> ** -> map * **
singleton k v = v $seq avl.singleton (k, v)     || strict value

member :: ordI * -> * -> map * ** -> bool
member cmp k
    = go
      where
        go AVLLeaf = False
        go (AVLNode (k', v) l r h)
            = case cmp k k' of
                EQ -> True
                LT -> go l
                GT -> go r

insert :: ordI * -> * -> ** -> map * ** -> map * **
insert cmp k v
    = go
      where
        go AVLLeaf = singleton k v
        go (AVLNode p l r h)
            = case fst p of k' ->
              case cmp k k' of
                EQ -> case v of v' -> AVLNode (k, v') l r h       || strict value
                LT -> case go l of l' -> balance $ AVLNode p l' r h
                GT -> case go r of r' -> balance $ AVLNode p l r' h

|| combination of insertWith / adjust / delete, depending upon result of f:
|| f Nothing  = Nothing -> no modification (i.e. delete absent key)
|| f Nothing  = Just v  -> insert k v
|| f (Just v) = Nothing -> delete k
|| f (Just v) = Just v' -> adjust k v
alter :: ordI * -> (maybe ** -> maybe **) -> * -> map * ** -> map * **
alter cmp f k
    = \m -> fromMaybe m $ go m
      where
        go AVLLeaf = f Nothing mb.<&> singleton k
        go (AVLNode p l r h)
            = case p of (k', v') ->
                  case cmp k k' of
                    EQ -> case f (Just v') of
                            Nothing -> Just $ moveR l r     || delete the node
                            Just v  -> Just $ AVLNode (k, v) l r h
                    LT -> go l mb.<&> insL
                    GT -> go r mb.<&> insR
              where
                insL l' = balance $ AVLNode p l' r h
                insR r' = balance $ AVLNode p l r' h

|| insert v if k not found in the map, otherwise insert the result of applying
|| f to the existing value and v
insertWith :: ordI * -> (** -> ** -> **) -> * -> ** -> map * ** -> map * **
insertWith cmp f k v
    = alter cmp f' k
      where
        f' Nothing   = Just v
        f' (Just v') = Just $ f v v'

delete :: ordI * -> * -> map * ** -> map * **
delete cmp k = alter cmp (const Nothing) k

|| return the original map if the key wasn't found, otherwise return the adjusted map
adjust :: ordI * -> (** -> **) -> * -> map * ** -> map * **
adjust cmp f k = alter cmp (mb.<&> f) k

lookup :: ordI * -> * -> map * ** -> maybe **
lookup cmp k
    = go
      where
        go AVLLeaf = Nothing
        go (AVLNode (k', v') l r h)
          = case cmp k k' of
              EQ -> Just v'
              LT -> go l
              GT -> go r

findWithDefault :: ordI * -> ** -> * -> map * ** -> **
findWithDefault cmp d k = lookup cmp k .> fromMaybe d

fromList :: ordI * -> [(*, **)] -> map * **
fromList cmp
    = std.foldl ins empty
      where
        ins m (k, v) = insert cmp k v m

elems :: map * ** -> [**]
elems AVLLeaf = []
elems (AVLNode (k, v) l r h)
    = elems l ++ [v] ++ elems r

keys :: map * ** -> [*]
keys AVLLeaf = []
keys (AVLNode (k, v) l r h)
    = keys l ++ [k] ++ keys r

|| extract the map's keys as a set
|| note that it extracts to an avlTree (parent of set) to prevent
|| having a dependency on the set module.  Since the map's keys
|| are guaranteed to be unique, they naturally form a set
keysSet :: map * ** -> avlTree *
keysSet AVLLeaf = AVLLeaf
keysSet (AVLNode (k, v) l r h)
    = case keysSet l of ls ->
      case keysSet r of rs ->
      AVLNode k ls rs h

union :: ordI * -> map * ** -> map * ** -> map * **
union cmp m1 m2
    = std.foldl addEntry m1 $ toList m2
      where
        addEntry m (k, v) = insert cmp k v m

filter :: ordI * -> (** -> bool) -> map * ** -> map * **
filter cmp p
    = filterWithKey cmp (ignoreKey p)
      where
        ignoreKey p (k, x) = p x

filterWithKey :: ordI * -> ((*, **) -> bool) -> map * ** -> map * **
filterWithKey cmp p = toList .> std.filter p .> fromList cmp

mapAccumL :: (**** -> ** -> (****, ***)) -> **** -> map * ** -> (****, map * ***)
mapAccumL f s
    = go
      where
        go AVLLeaf = (s, AVLLeaf)
        go (AVLNode (k, v) l r h)
             = case go l   of (s1, l') ->
               case f s1 v of (s2, v') ->
               case go r   of (s3, r') ->
               (s3, AVLNode (k, v') l' r' h)

|| functor interface
|| note: lazy operation here, because some computations
|| like loeb depend upon that
(<$>) :: (** -> ***) -> map * ** -> map * ***
(<$>) f
    = go
      where
        go  AVLLeaf = AVLLeaf
        go (AVLNode (k, v) l r h)
            = AVLNode (k, v') l' r' h
              where
                v' = f v
                l' = go l
                r' = go r

(<&>) :: map * ** -> (** -> ***) -> map * ***
(<&>) m f =  f <$> m

fmapWithKey :: (* -> ** -> ***) -> map * ** -> map * ***
fmapWithKey f
    = go
      where
        go AVLLeaf = AVLLeaf
        go (AVLNode (k, v) l r h)
            = AVLNode (k, v') l' r' h
              where
                v' = f k v
                l' = go l
                r' = go r

|| foldable interface
foldr :: (** -> *** -> ***) -> *** -> map * ** -> ***
foldr f z
    = go z
      where
        go z' AVLLeaf                = z'
        go z' (AVLNode (k, v) l r h) = go z' r |> f v |> ($go l)

foldl :: (*** -> ** -> ***) -> *** -> map * ** -> ***
foldl f z
    = go z
      where
        go z1 AVLLeaf                = z1
        go z1 (AVLNode (k, v) l r h) = case go z1 l of z2 -> f z2 v |> ($go r)
