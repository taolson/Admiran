|| dequeue.am -- a double-ended queue of elements that allows quick insertion / deletion at both ends
|| implemented using a fingerTree


%export + -cmpdequeue -isSat

%import <base>
%import <maybe>


dequeue * ::=
    FT0         |
    FT1 *       |
    FT2 * *     |
    FT3 * * *   |
    FTN (dequeue *) (dequeue (dequeue *)) (dequeue *)

|| don't auto-derive ord instance for dq
cmpdequeue = undef

|| is the finger-tree node saturated?
isSat :: dequeue * -> bool
isSat (FT3 a b c) = True
isSat _           = False

empty :: dequeue *
empty = FT0

singleton :: * -> dequeue *
singleton x = FT1 x

null :: dequeue * -> bool
null FT0 = True
null _   = False

size :: dequeue * -> int
size FT0         = 0
size (FT1 a)     = 1
size (FT2 a b)   = 2
size (FT3 a b c) = 3
size (FTN l m r) = size l + 3 * size m + size r

addL :: * -> dequeue * -> dequeue *
addL a FT0         = FT1 a
addL a (FT1 b)     = FT2 a b
addL a (FT2 b c)   = FT3 a b c
addL a (FT3 b c d) = FTN (FT1 a) FT0 (FT3 b c d)
addL a (FTN l m r)
    = FTN (addL a l) m r,       if ~isSat l
    = FTN (FT1 a) (addL l m) r, otherwise

addR :: * -> dequeue * -> dequeue *
addR z FT0         = FT1 z
addR z (FT1 y)     = FT2 y z
addR z (FT2 x y)   = FT3 x y z
addR z (FT3 w x y) = FTN (FT3 w x y) FT0 (FT1 z)
addR z (FTN l m r)
    = FTN l m (addR z r),       if ~isSat r
    = FTN l (addR r m) (FT1 z), otherwise

viewL :: dequeue * -> maybe (*, dequeue *)
viewL FT0         = Nothing
viewL (FT1 a)     = Just (a, FT0)
viewL (FT2 a b)   = Just (a, FT1 b)
viewL (FT3 a b c) = Just (a, FT2 b c)
viewL (FTN l m r)
    = Just (a, fillL (FTN l' m r))
      where
        (a, l') = fromJust $ viewL l

        fillL (FTN FT0 FT0 r) = r
        fillL (FTN FT0 m   r) = FTN l m' r where (l, m') = fromJust $ viewL m
        fillL q               = q

viewR :: dequeue * -> maybe (*, dequeue *)
viewR FT0         = Nothing
viewR (FT1 z)     = Just (z, FT0)
viewR (FT2 y z)   = Just (z, FT1 y)
viewR (FT3 x y z) = Just (z, FT2 x y)
viewR (FTN l m r)
    = Just (z, fillR (FTN l m r'))
      where
        (z, r') = fromJust $ viewR r

        fillR (FTN l FT0 FT0) = l
        fillR (FTN l m   FT0) = FTN l m' r where (r, m') = fromJust $ viewR m
        fillR q               = q

fromList :: [*] -> dequeue *
fromList = foldl (converse addR) empty

toList :: dequeue * -> [*]
toList FT0         = []
toList (FT1 a)     = [a]
toList (FT2 a b)   = [a, b]
toList (FT3 a b c) = [a, b, c]
toList (FTN l m r) = toList l ++ (toList .> concatMap toList) m ++ toList r
