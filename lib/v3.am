||  v3.am -- 3D vectors and associated operations


%export +

%import <base>
%import <lens>
%import <maybe>
%import <stdlib> as std


v3 * ::= V3 * * *

|| lenses for v3
viewV3_0 (V3 a b c) = a; overV3_0 fn (V3 a b c) = V3 (fn a) b c; lensV3_0 = Lens viewV3_0 overV3_0
viewV3_1 (V3 a b c) = b; overV3_1 fn (V3 a b c) = V3 a (fn b) c; lensV3_1 = Lens viewV3_1 overV3_1
viewV3_2 (V3 a b c) = c; overV3_2 fn (V3 a b c) = V3 a b (fn c); lensV3_2 = Lens viewV3_2 overV3_2


|| monad interface

pure :: * -> v3 *
pure x = V3 x x x

(>>=) :: v3 * -> (* -> v3 **) -> v3 **
(V3 a b c) >>= f
    = V3 a' b' c'
      where
        V3 a' _  _  = f a
        V3 _  b' _  = f b
        V3 _  _  c' = f c

sequence :: [v3 *] -> v3 [*]
sequence xs = std.foldr (liftA2 (:)) (pure []) xs


|| functor interface

(<$>) :: (* -> **) -> v3 * -> v3 **
f <$> (V3 a b c) = V3 (f a) (f b) (f c)

(<&>) :: v3 * -> (* -> **) -> v3 **
v <&> f = f <$> v


|| applicative interface

(<*>) :: v3 (* -> **) -> v3 * -> v3 **
(<*>) (V3 fa fb fc) (V3 a b c) = V3 (fa a) (fb b) (fc c)

liftA2 :: (* -> ** -> ***) -> v3 * -> v3 ** -> v3 ***
liftA2 f (V3 a b c) (V3 g h i) = V3 (f a g) (f b h) (f c i)


|| foldable interface

foldr :: (* -> ** -> **) -> ** -> v3 * -> **
foldr f z (V3 a b c) = f c z |> f b |> f a

foldl :: (** -> * -> **) -> ** -> v3 * -> **
foldl f z (V3 a b c) = f z a |> ($f b) |> ($f c)


abs, neg, signum :: v3 int -> v3 int
abs    a = std.abs     <$> a
neg    a = std.neg     <$> a
signum a = base.signum <$> a

add, sub, mul, quot, rem, div, mod :: v3 int -> v3 int -> v3 int
add  a b = liftA2 (+)      a b
sub  a b = liftA2 (-)      a b
mul  a b = liftA2 (*)      a b
quot a b = liftA2 std.quot a b
rem  a b = liftA2 std.rem  a b
div  a b = liftA2 std.div  a b
mod  a b = liftA2 std.mod  a b

max, min :: ordI * -> v3 * -> v3 * -> v3 *
max cmp a b = liftA2 (max2 cmp) a b
min cmp a b = liftA2 (min2 cmp) a b

sum, product :: v3 int -> int
sum     a = foldl (+) 0 a
product a = foldl (*) 1 a

|| manhattan distance
dist :: v3 int -> v3 int -> int
dist a b = sub a b |> abs |> sum

|| cross-product
cross :: v3 int -> v3 int -> v3 int
cross (V3 x1 y1 z1) (V3 x2 y2 z2) = V3 (y1 * z2 - z1 * y2) (z1 * x2 - x1 * z2) (x1 * y2 - y1 * x2)
