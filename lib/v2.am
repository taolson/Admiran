||  v2.am -- 2D vectors and associated operations


%export +

%import <base>
%import <lens>
%import <maybe>
%import <stdlib> as std

v2 * ::= V2 * *

|| lenses for v2
viewV2_0 (V2 a b) = a; overV2_0 fn (V2 a b) = V2 (fn a) b; lensV2_0 = Lens viewV2_0 overV2_0
viewV2_1 (V2 a b) = b; overV2_1 fn (V2 a b) = V2 a (fn b); lensV2_1 = Lens viewV2_1 overV2_1


|| monad interface

pure :: * -> v2 *
pure x = V2 x x

(>>=) :: v2 * -> (* -> v2 **) -> v2 **
(V2 a b) >>= f
    = V2 a' b'
      where
        V2 a' _ = f a
        V2 _ b' = f b

sequence :: [v2 *] -> v2 [*]
sequence xs = std.foldr (liftA2 (:)) (pure []) xs


|| functor interface

(<$>) :: (* -> **) -> v2 * -> v2 **
f <$> (V2 a b) = V2 (f a) (f b)

(<&>) :: v2 * -> (* -> **) -> v2 **
v <&> f = f <$> v


|| applicative interface

(<*>) :: v2 (* -> **) -> v2 * -> v2 **
(<*>) (V2 fa fb) (V2 a b) = V2 (fa a) (fb b)

liftA2 :: (* -> ** -> ***) -> v2 * -> v2 ** -> v2 ***
liftA2 f (V2 a b) (V2 c d) = V2 (f a c) (f b d)


|| foldable interface
foldr :: (* -> ** -> **) -> ** -> v2 * -> **
foldr f z (V2 a b) = f a (f b z)

foldl :: (** -> * -> **) -> ** -> v2 * -> **
foldl f z (V2 a b) = f (f z a) b


abs, neg, signum :: v2 int -> v2 int
abs    a  = std.abs     <$> a
neg    a  = std.neg     <$> a
signum a  = base.signum <$> a

add, sub, mul, quot, rem, div, mod :: v2 int -> v2 int -> v2 int
add  a b = liftA2 (+)      a b
sub  a b = liftA2 (-)      a b
mul  a b = liftA2 (*)      a b
quot a b = liftA2 std.quot a b
rem  a b = liftA2 std.rem  a b
div  a b = liftA2 std.div  a b
mod  a b = liftA2 std.mod  a b

cmul :: v2 int -> v2 int -> v2 int
cmul (V2 ar ai) (V2 br bi)
    = V2 cr ci
      where
        cr = ar * br - ai * bi
        ci = ar * bi + ai * br

max, min :: ordI * -> v2 * -> v2 * -> v2 *
max cmp a b = liftA2 (max2 cmp) a b
min cmp a b = liftA2 (min2 cmp) a b

sum, product :: v2 int -> int
sum     a = foldl (+) 0 a
product a = foldl (*) 1 a

|| manhattan distance
dist :: v2 int -> v2 int -> int
dist a b = sub a b |> abs |> sum
