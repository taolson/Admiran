|| zipper.am -- implementation of a list with a cursor


%export +

%import <base>


zipper * ::= Zipper [*] ! [*] !

empty :: zipper *
empty = Zipper [] []

null :: zipper * -> bool
null (Zipper [] []) = True
null _              = False

singleton :: * -> zipper *
singleton x = Zipper [] [x]

fromList :: [*] -> zipper *
fromList xs = Zipper [] xs

toList :: zipper * -> [*]
toList (Zipper ls rs) = reverse ls ++ rs

beginp, endp :: zipper * -> bool
beginp (Zipper [] _) = True
beginp _             = False

endp  (Zipper _ []) = True
endp  _             = False

begin, end :: zipper * -> zipper *
begin (Zipper ls rs) = Zipper [] (reverse ls ++ rs)
end   (Zipper ls rs) = Zipper (reverse rs ++ ls) []

cursor :: zipper * -> *
cursor (Zipper _ (a : _)) = a
cursor z                  = error "cursor: null zipper"

left, right :: zipper * -> zipper *
left (Zipper (a : ls) rs) = Zipper ls (a : rs)
left z                    = z

right (Zipper ls (a : rs)) = Zipper (a : ls) rs
right z                    = z

|| insert an element before the cursor
insert :: * -> zipper * -> zipper *
insert a (Zipper ls rs) = Zipper (a : ls) rs

|| delete the element at the cursor
delete :: zipper * -> zipper *
delete (Zipper ls (_ : rs)) = Zipper ls rs
delete z                    = z

|| push an element before the cursor
push :: * -> zipper * -> zipper *
push a (Zipper ls rs) = Zipper (a : ls) rs

|| delete the element before the cursor
pop :: zipper * -> zipper *
pop (Zipper (_ : ls) rs) = Zipper ls rs
pop z                    = error "pop: empty zipper"

|| modify the element at the cursor
modify :: (* -> *) -> zipper * -> zipper *
modify f (Zipper ls (a : rs)) = Zipper ls (f a : rs)
modify f z                    = error "modify: empty zipper"

|| functor instance for zipper
(<$>) :: (* -> **) -> zipper * -> zipper **
(<$>) f (Zipper ls rs) = Zipper (map f ls) (map f rs)

(<&>) :: zipper * -> (* -> **) -> zipper **
(<&>) z f = (<$>) f z


|| fold instance for zipper
fold :: (** -> * -> **) -> ** -> zipper * -> **
fold f z (Zipper ls rs) = foldl f (foldl f z ls) rs
