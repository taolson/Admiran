|| maybeState.am -- functor / applicative / monad / alternative for a state monad augmented with maybe
||
|| Note: the strictness of this implementation somewhat relies upon the inlining optimizations
|| in the compiler (e.g. inlining runState, (>>=), etc.) If this is compiled with inlining
|| disabled, then extra thunks are created which may cause space leaks


%export + runState evalState execState

%import <maybe> as mb
%import <lens>
%import <state> as st


maybeState * ** == state * (maybe **)

|| state access
get :: maybeState * *
get = mb.pure st.<$> st.get

put :: * -> maybeState * ()
put s' = mb.pure st.<$> st.put s'

modify :: (* -> *) -> maybeState * ()
modify f = mb.pure st.<$> st.modify f

liftMaybe :: maybe ** -> maybeState * **
liftMaybe m = st.pure m

liftState :: state * ** -> maybeState * **
liftState m = mb.pure st.<$> m

|| lift lens operations into state
view :: lens * ** -> maybeState * **
view lns = lens.view lns <$> get

over :: lens * ** -> (** -> **) -> maybeState * ()
over lns f = modify (lens.over lns f)

set :: lens * ** -> ** -> maybeState * ()
set lns x = modify (lens.set lns x)


|| monad interface

pure :: ** -> maybeState * **
pure a = a |> mb.pure |> st.pure

fail :: maybeState * **
fail = st.pure Nothing

(>>=) :: maybeState * ** -> (** -> maybeState * ***) -> maybeState * ***
m >>= f = m st.>>= fromMaybef fail f

(>=>) :: (** -> maybeState * ***) -> (*** -> maybeState * ****) -> ** -> maybeState * ****
f >=> g = \x -> f x >>= g

join :: maybeState * (maybeState * **) -> maybeState * **
join m = m st.>>= fromMaybef fail runState

mapM :: (** -> maybeState * ***) -> [**] -> maybeState * [***]
mapM f xs = foldr (f .> liftA2 (:)) (pure []) xs

mapM_ :: (** -> maybeState * ***) -> [**] -> maybeState * ()
mapM_ f xs = foldr (f .> (>>)) (pure ()) xs

forM :: [**] -> (** -> maybeState * ***) -> maybeState * ()
forM xs f = mapM_ f xs

filterM :: (** -> maybeState * bool) -> [**] -> maybeState * [**]
filterM p xs
    = foldr check (pure []) xs
      where
        check x       = liftA2 (cond x) (p x)
        cond  x False = id
        cond  x True  = (x :)

foldM :: (*** -> ** -> maybeState * ***) -> *** -> [**] -> maybeState * ***
foldM f z0 xs
    = foldr c pure xs z0
      where
        c x k z = f z x >>= k

sequence :: [maybeState * **] -> maybeState * [**]
sequence xs = foldr (liftA2 (:)) (pure []) xs

sequence_ :: [maybeState * **] -> maybeState * ()
sequence_ xs = foldr (>>) (pure ()) xs


|| functor interface

(<$>) :: (** -> ***) -> maybeState * ** -> maybeState * ***
f <$> m = m >>= (f .> pure)

(<&>) :: maybeState * ** -> (** -> ***) -> maybeState * ***
m <&> f =  f <$> m

|| applicative interface
(<*>) :: maybeState * (** -> ***) -> maybeState * ** -> maybeState * ***
mf <*> ma = mf >>= (<$> ma)

liftA2 :: (** -> *** -> ****) -> maybeState * ** -> maybeState * *** -> maybeState * ****
liftA2 f ma mb = f <$> ma <*> mb

liftA3 :: (** -> *** -> **** -> *****) -> maybeState * ** -> maybeState * *** -> maybeState * **** -> maybeState * *****
liftA3 f ma mb mc = liftA2 f ma mb <*> mc

liftA4 :: (** -> *** -> **** -> ***** -> ******) -> maybeState * ** -> maybeState * *** -> maybeState * **** -> maybeState * ***** -> maybeState * ******
liftA4 f ma mb mc md = liftA3 f ma mb mc <*> md

(<<) :: maybeState * ** -> maybeState * *** -> maybeState * **
(<<) ma mb = liftA2 const ma mb

(>>) :: maybeState * ** -> maybeState * *** -> maybeState * ***
(>>) ma mb = liftA2 (converse const) ma mb


|| lift multiple independent state actions and bind them to an N-ary function
bind2 :: maybeState * ** -> maybeState * *** -> (** -> *** -> maybeState * ****) -> maybeState * ****
bind2 ma mb f = join (liftA2 f ma mb)

bind3 :: maybeState * ** -> maybeState * *** -> maybeState * **** -> (** -> *** -> **** -> maybeState * *****) -> maybeState * *****
bind3 ma mb mc f = join (liftA3 f ma mb mc)

bind4 :: maybeState * ** -> maybeState * *** -> maybeState * **** -> maybeState * ***** -> (** -> *** -> **** -> ***** ->
             maybeState * ******) -> maybeState * ******
bind4 ma mb mc md f = join (liftA4 f ma mb mc md)


|| alternative interface

(<|>) :: maybeState * ** -> maybeState * ** -> maybeState * **
ma <|> mb
    = go
      where
        go s = alt $ runState ma s
               where
                 alt (Nothing, _) = runState mb s
                 alt ra           = ra

some :: maybeState * ** -> maybeState * [**]
some ma = liftA2 (:) ma (many ma)

many :: maybeState * ** -> maybeState * [**]
many ma = some ma <|> pure []
