|| trieMap.am -- strict map from a key to a value, where the key is a list of elements
|| this has lower size / higher performance than a regular map if the keys have large common prefixes
|| implemented using Patricia tries, which are prefix tries with variable-sized prefixes
||
|| timing on insert / lookup for all of /usr/share/dict/words (~236K words):
|| trieMap: insert = 1.260s, lookup = 0.993s
|| map:     insert = 1.638s, lookup = 0.404s
||
|| trieMap is faster for insert, here, because no rebalancing required as in map
|| map is faster for lookup, here, because the trieBranches have a lot of short, mostly single-character prefixes to compare
||
|| trieMap space is much smaller (about 1/3 the size) of map space, because duplicate prefix characters aren't copied


%export +

%import <base>
%import <either>
%import <maybe>  as mb
%import <stdlib> as std


|| a trieBranch holds a prefix key and its associated sub-trie
trieBranch * ** == ([*], trie * **)

|| result of matching a key with a trieBranch
matchResult * ** ::=
    Mfail                               |
    Mkey  (trie * **) [*] [*]           |  || match full prefix -- t, remaining key, prefix
    Mpre  (trie * **) [*] [*]           |  || match full key    -- t, key,           remaining prefix
    Mpart (trie * **) [*] [*] [*]          || partial match     -- t, remaining key, remaining prefix, match

|| compare the key with the prefix key stored in the trieBranch
tb_match :: ordI * -> [*] -> trieBranch * ** -> matchResult * **
tb_match cmp ks (ps, t)
    = go ks ps []
      where
        go (k : ks) (p : ps) m = go ks ps (k : m), if _eq cmp k p
        go ks' ps' ms
            = Mfail,                        if std.null ms
            = Mkey  t ks' ps,               if std.null ps'
            = Mpre  t ks  ps',              if std.null ks'
            = Mpart t ks' ps' (reverse ms), otherwise

|| find a trieBranch prefix-matching the key
tb_find :: ordI * -> [*] -> [trieBranch * **] -> matchResult * **
tb_find cmp k bs
    = std.foldr find Mfail bs
      where
        find b cont
            = case tb_match cmp k b of
                Mfail -> cont
                r     -> r

|| modify a trieBranch prefix-matching the key with the supplied function, and return the modified trieBranch list
|| return Nothing if no prefix-match found
|| the modification function returns a maybe trieBranch: if it returns Nothing, then the match and modification fails
tb_modify :: ordI * -> (matchResult * ** -> maybe (trieBranch * **)) -> [*] -> [trieBranch * **] -> maybe [trieBranch * **]
tb_modify cmp check k bs
    = go k bs
      where
        go k [] = Nothing                       || no match found
        go k (b : bs)
            = case check $ tb_match cmp k b of
                Nothing -> go k bs mb.<&> (b :) || branch didn't match or failed check; merge this branch with the result of checking the remaining
                Just b' -> Just (b' : bs)       || branch passed check; return modified branch along with remaining unexamined branches

|| a trie is a list of trieBranches to continue prefix matching and a possible value stored at this trie level
trie * ** ::= Trie [trieBranch * **] (maybe **)

empty :: trie * **
empty = Trie [] Nothing

null :: trie * ** -> bool
null (Trie [] _) = True
null _           = False

|| lookup the value for a key, returning Nothing if the key is not present
lookup :: ordI * -> [*] -> trie * ** -> maybe **
lookup cmp k t
    = go k t
      where
        go [] (Trie bs mv) = mv
        go k  (Trie bs mv)
            = case tb_find cmp k bs of
                Mkey t k _ -> go k t    || matched full prefix; continue with remaining key and matching trieBranch
                _          -> Nothing   || no match for all other cases

findWithDefault :: ordI * -> ** -> [*] -> trie * ** -> **
findWithDefault cmp d xs t
    = fromMaybe d $ lookup cmp xs t

|| lookup the first value that matches a prefix of the key
prefix :: ordI * -> [*] -> trie * ** -> maybe **
prefix cmp k t
    = go k t
      where
        go [] (Trie bs mv) = mv
        go k  (Trie bs mv) = mv <|> lookup k bs

        lookup k bs
            = case tb_find cmp k bs of
                Mkey t k _ -> go k t    || matched full prefix; continue with remaining key and matching trieNBranch
                _          -> Nothing

|| insert a key-value pair
insert :: ordI * -> [*] -> ** -> trie * ** -> trie * **
insert cmp k v t
    = go k t
      where
        tNew bs = v $seq Trie bs (Just v)               || create a new Trie with an existing trieBranch list and the value

        go [] (Trie bs mv) = tNew bs                    || trie matches key -- replace value
        go k  (Trie bs mv)
            = case tb_modify cmp check k bs of
                Nothing  -> b' $seq Trie (b' : bs) mv   || no matching trieBranch -- insert a new one
                Just bs' -> Trie bs' mv                 || partial match found -- replace branches
              where
                b' = case tNew [] of t' -> (k, t')

        check Mfail           = Nothing
        check (Mkey  t k p)   = case go k t        of t' -> Just (p, t')                                || continue matching k, insert under p
        check (Mpre  t k p)   = case tNew [(p, t)] of t' -> Just (k, t')                                || insert remaining p under new trieBranch k
        check (Mpart t k p m) = case tNew []       of t' -> Just (m, Trie [(k, t'), (p, t)] Nothing)    || split, insert remaining k and p under new

|| insert a key-value pair using supplied insertion function
insertWith :: ordI * -> (** -> ** -> **) -> [*] -> ** -> trie * ** -> trie * **
insertWith cmp f k v t
    = go k t
      where
        tNew bs = v $seq Trie bs (Just v)               || create a new Trie with an existing trieBranch list and the value

        go [] (Trie bs mv)
            = case mv of
                Nothing -> tNew bs
                Just v' -> case f v v' of fv' -> Trie bs (Just fv')

        go k  (Trie bs mv)
            = case tb_modify cmp check k bs of
                Nothing  -> b' $seq Trie (b' : bs) mv   || no matching trieBranch -- insert a new one
                Just bs' -> Trie bs' mv                 || partial match found -- replace branches
              where
                b' = case tNew [] of t' -> (k, t')

        check Mfail           = Nothing
        check (Mkey  t k p)   = case go k t        of t' -> Just (p, t')                                || continue matching k, insert under p
        check (Mpre  t k p)   = case tNew [(p, t)] of t' -> Just (k, t')                                || insert remaining p under new trieBranch k
        check (Mpart t k p m) = case tNew []       of t' -> Just (m, Trie [(k, t'), (p, t)] Nothing)    || split, insert remaining k and p under new

|| delete a key-value pair in the trieMap (simply replace the value with Nothing, leaving the key intact)
delete :: ordI * -> [*] -> trie * ** -> trie * **
delete cmp k t
    = fromMaybe t $ go k t
      where
        go [] (Trie bs mv) = Just $ Trie bs Nothing     || trie matches key -- remove value
        go k  (Trie bs mv) = tb_modify cmp check k bs mb.<&> converse Trie mv

        check (Mkey t k p) = go k t mb.<&> pair p       || continue matching k, return modified trieBranch if a deletion occurred
        check _            = Nothing

adjust :: ordI * -> (** -> **) -> [*] -> trie * ** -> trie * **
adjust cmp f k t
    = fromMaybe t $ go k t
      where
        go [] (Trie bs mv) = mv mb.<&> (f .> Just .> Trie bs)   || trie matches key -- perform adjustment if value exists
        go k  (Trie bs mv) = tb_modify cmp check k bs mb.<&> converse Trie mv

        check (Mkey t k p) = go k t mb.<&> pair p       || continue matching k, return modified trieBranch if an adjust occurred
        check _            = Nothing

|| filter the elements of a trieMap with a predicate function and return the filtered trieMap
|| this can be done by simply deleting the elements that don't pass the predicate function, keeping the same
|| trie structure
filter :: (** -> bool) -> trie * ** -> trie * **
filter f t
    = go t
      where
        go (Trie bs mv)
            = case map goNext bs of
                bs' -> case mv of
                         Nothing -> Trie bs' Nothing
                         Just v  -> case f v of
                                      False -> Trie bs' Nothing
                                      True  -> Trie bs' (Just v)
        goNext (p, t) = case go t of t' -> (p, t')

union :: ordI * -> trie * ** -> trie * ** -> trie * **
union cmp t1 t2
    = std.foldl ins t1 $ toList t2
      where
        ins t (k, v) = insert cmp k v t

toList :: trie * ** -> [([*], **)]
toList t
    = go [] t
      where
        go p1 (Trie bs mv)
            = case mv of
                Nothing -> next
                Just v  -> (p1, v) : next
              where
                next = concatMap goNext bs

                goNext (p2, t') = go (p1 ++ p2) t'

fromList :: ordI * -> [([*], **)] -> trie * **
fromList cmp
    = std.foldl ins empty
      where
        ins t (k, v) = insert cmp k v t

keys :: trie * ** -> [[*]]
keys t = map fst $ toList t

elems :: trie * ** -> [**]
elems t = map snd $ toList t


|| functor interace
(<$>) :: (** -> ***) -> trie * ** -> trie * ***
f <$> t
    = go t
      where
        go (Trie bs mv) = case map goNext bs of bs' -> case mv mb.<&> f of mv' -> Trie bs' mv'
        goNext (p, t)   = case go t of t' -> (p, t')

(<&>) :: trie * ** -> (** -> ***) -> trie * ***
t <&> f =  f <$> t


|| foldable interace
foldr :: (** -> *** -> ***) -> *** -> trie * ** -> ***
foldr f z
    = go z
      where
        go z' (Trie bs mv) = std.foldr ftb z' bs |> check mv

        ftb (p, t) z' = go z' t

        check Nothing z'   = z'
        check (Just v) z'  = f v z'

foldl :: (*** -> ** -> ***) -> *** -> trie * ** -> ***
foldl f z
    = go z
      where
        go z' (Trie bs mv) = fromMaybef z' (f z') mv |> converse (std.foldl ftb) bs

        ftb z' (p, t) = go z' t
