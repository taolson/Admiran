|| avl.am -- AVL tree


%export + -height -computeHeight -delta -rotL -rotR -balanceL -balanceR

%import <maybe>
%import <stdlib> as std

avlTree * ::= AVLLeaf | AVLNode * (avlTree *) (avlTree *) int

|| custom ord instance for avlTree, since two trees may hold the same contents, but with
|| differing structures. This instance is also used for the modules that build on avl (bag, map, set)
cmpavlTree :: ordI * -> ordI (avlTree *)
cmpavlTree cmp'
    = cmp
      where
        cmp ta tb = cmplist cmp' (toList ta) (toList tb)

height :: avlTree * -> int
height AVLLeaf           = 0
height (AVLNode _ _ _ h) = h

computeHeight :: avlTree * -> avlTree *
computeHeight AVLLeaf = AVLLeaf
computeHeight (AVLNode v l r _) = case max2 cmpint (height l) (height r) + 1 of h' -> AVLNode v l r h'

delta :: avlTree * -> int
delta AVLLeaf           = 0
delta (AVLNode _ l r _) = height l - height r

rotL :: avlTree * -> avlTree *
rotL (AVLNode v l (AVLNode vr lr rr hr) h)
    = case balance $ AVLNode v l lr h of lr' -> balance $ AVLNode vr lr' rr hr

rotL n = n

rotR :: avlTree * -> avlTree *
rotR (AVLNode v (AVLNode vl ll rl hl) r h)
    = case balance $ AVLNode v rl r h of rl' -> balance $ AVLNode vl ll rl' hl

rotR n = n

moveR :: avlTree * -> avlTree * -> avlTree *
moveR (AVLLeaf)         rn = rn
moveR (AVLNode v l r h) rn
    = case moveR r rn of r' -> balance $ AVLNode v l r' h

balance :: avlTree * -> avlTree *
balance AVLLeaf = AVLLeaf
balance n
    = balanceR n,      if d < -1
    = balanceL n,      if d >  1
    = computeHeight n, otherwise
      where
        d = delta n

balanceR :: avlTree * -> avlTree *
balanceR n
    = go n
      where
        go (AVLNode v l r h)
            = rotL n', if delta r > 0
            = rotL n,  otherwise
              where
                n' = case rotR r of r' -> AVLNode v l r' h

        go AVLLeaf = unreachable

balanceL :: avlTree * -> avlTree *
balanceL n
    = go n
      where
        go (AVLNode v l r h)
            = rotR n', if delta l < 0
            = rotR n,  otherwise
              where
                n' = case rotL l of l' -> AVLNode v l' r h

        go AVLLeaf = unreachable

empty :: avlTree *
empty = AVLLeaf

null :: avlTree * -> bool
null AVLLeaf = True
null _       = False

singleton :: * -> avlTree *
singleton v = AVLNode v AVLLeaf AVLLeaf 1

isSingleton :: avlTree * -> bool
isSingleton (AVLNode _ AVLLeaf AVLLeaf _) = True
isSingleton _                             = False

size :: avlTree * -> int
size AVLLeaf           = 0
size (AVLNode v l r h) = size l + size r + 1

member :: ordI * -> * -> avlTree * -> bool
member cmp v
    = go
      where
        go  AVLLeaf = False
        go (AVLNode v' l r h)
            = case cmp v v' of
                EQ -> True
                LT -> go l
                GT -> go r

first :: avlTree * -> *
first AVLLeaf = error "first: null tree"
first (AVLNode v l r h)
    = v,         if null l
    = first l, otherwise

last :: avlTree * -> *
last AVLLeaf = error "last: null tree"
last (AVLNode v l r h)
    = v,        if null r
    = last r, otherwise

insert :: ordI * -> * -> avlTree * -> avlTree *
insert cmp v
    = go
      where
        go AVLLeaf = singleton v
        go (AVLNode v' l r h)
            = case cmp v v' of
                LT -> case go l of l' -> balance $ AVLNode v' l' r h
                _  -> case go r of r' -> balance $ AVLNode v' l r' h  || EQ case same as GT case, to allow multiple insertions of the same value

|| delete v from tree if present, or return the original tree
delete :: ordI * -> * -> avlTree * -> avlTree *
delete cmp v n
    = fromMaybe n $ go n
      where
        go AVLLeaf = Nothing
        go (AVLNode v' l r h)
            = case cmp v v' of
                EQ -> Just $ moveR l r
                LT -> go l <&> insL
                GT -> go r <&> insR
              where
                insL l' = balance $ AVLNode v' l' r h
                insR r' = balance $ AVLNode v' l r' h

fromList :: ordI * -> [*] -> avlTree *
fromList cmp = std.foldl (converse (insert cmp)) empty

toList :: avlTree * -> [*]
toList AVLLeaf           = []
toList (AVLNode v l r h) = toList l ++ [v] ++ toList r

union :: ordI * -> avlTree * -> avlTree * -> avlTree *
union cmp a1 a2 = std.foldr (insert cmp) a1 (toList a2)


|| functor interface
fmap :: ordI ** -> (* -> **) -> avlTree * -> avlTree **
fmap cmp f = toList .> map f .> fromList cmp      || mapping can change value order, so rebuild from mapped list

rfmap :: ordI ** -> avlTree * -> (* -> **) -> avlTree **
rfmap cmp m f = fmap cmp f m

|| foldable interface
foldr :: (* -> ** -> **) -> ** -> avlTree * -> **
foldr f z
    = go z
      where
        go z' AVLLeaf           = z'
        go z' (AVLNode v l r h) = go z' r |> f v |> ($go l)

foldl :: (** -> * -> **) -> ** -> avlTree * -> **
foldl f z
    = go z
      where
        go z1 AVLLeaf           = z1
        go z1 (AVLNode v l r h) = case go z1 l of z2 -> f z2 v |> ($go r)
