|| bitSet.am -- representation of a set of small (< 64) natural numbers using an int, as an abstract type

|| interface
abstype bitSet with
    empty     :: bitSet
    null      :: bitSet -> bool
    singleton :: int    -> bitSet
    all       :: int    -> bitSet
    size      :: bitSet -> int
    member    :: int    -> bitSet -> bool
    first     :: bitSet -> int
    last      :: bitSet -> int
    insert    :: int    -> bitSet -> bitSet
    delete    :: int    -> bitSet -> bitSet
    union     :: bitSet -> bitSet -> bitSet
    intersect :: bitSet -> bitSet -> bitSet
    fromList  :: [int]  -> bitSet
    toList    :: bitSet -> [int]
    toInt     :: bitSet -> int
    fromInt   :: int -> bitSet
    showbitSet   :: bitSet -> string
    cmpbitSet    :: bitSet -> bitSet -> ordering

|| implementation
bitSet == int

empty = 0

null s = s == 0

singleton n = 1 .<<. n

|| a bitSet of size n with all bits set
all n = (1 .<<. n) - 1

|| number of bits set in the bitSet (popcount)
size s
    = go 0 s
      where
        go n 0 = n
        go n s = case n + (s .&. 1) of n' -> go n' (s .>>. 1)

member n s = (s .&. (1 .<<. n)) ~= 0

|| find index of first set bit
|| returns (-1) if bitSet is empty
first s
    = go (-1) s
      where
        go i 0 = i
        go i s
            = case i + 1 of    i' ->
              case s .>>. 1 of s' ->
              case s .&. 1 == 0 of
                False -> i'
                True  -> go i' s'

|| find index of last bit set
|| returns (-1) if bitSet is empty
last s
    = go (-1) s
      where
        go i 0 = i
        go i s
            = case i + 1 of    i' ->
              case s .>>. 1 of s' ->
              go i' s'

insert n s = s .|. (1 .<<. n)
delete n s = s .&. complement (1 .<<. n)

union s1 s2 = s1 .|. s2

difference :: bitSet -> bitSet -> bitSet
difference s1 s2 = s1 .&. complement s2

intersect s1 s2 = s1 .&. s2

fromList xs = foldr insert 0 xs

toList s
    = go 0 s
      where
        go i 0 = []
        go i s
            = case i + 1 of    i' ->
              case s .>>. 1 of s' ->
              case s .&. 1 == 0 of
                False -> i : go i' s'
                True  ->     go i' s'

toInt   s = s
fromInt n = n

showbitSet s   = showhex s
cmpbitSet s1 s2 = cmpint s1 s2
