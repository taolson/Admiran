|| bitSet.am -- representation of a set of small (< 64) natural numbers using an int, as an abstract type


|| interface
abstype bitSet with
    bs_empty     :: bitSet
    bs_null      :: bitSet -> bool
    bs_singleton :: int    -> bitSet
    bs_all       :: int    -> bitSet
    bs_size      :: bitSet -> int
    bs_member    :: int    -> bitSet -> bool
    bs_first     :: bitSet -> int
    bs_last      :: bitSet -> int
    bs_insert    :: int    -> bitSet -> bitSet
    bs_delete    :: int    -> bitSet -> bitSet
    bs_union     :: bitSet -> bitSet -> bitSet
    bs_intersect :: bitSet -> bitSet -> bitSet
    bs_fromList  :: [int]  -> bitSet
    bs_toList    :: bitSet -> [int]
    bs_toInt     :: bitSet -> int
    bs_fromInt   :: int -> bitSet
    showbitSet   :: bitSet -> string
    cmpbitSet    :: bitSet -> bitSet -> ordering

|| implementation
bitSet == int

bs_empty = 0

bs_null n = n == 0

bs_singleton n = 1 .<<. n

|| a bitSet of size n with all bits set
bs_all n = (1 .<<. n) - 1

|| number of bits set in the bitSet (popcount)
bs_size
    = go 0
      where
        go s 0 = s
        go s n = case s + (n .&. 1) of s' -> go s' (n .>>. 1)

bs_member n bs = (bs .&. (1 .<<. n)) ~= 0

|| find index of first set bit
|| returns (-1) if bitSet is empty
bs_first
    = go (-1)
      where
        go i 0 = i
        go i n
            = case i + 1 of
                i' -> case n .>>. 1 of
                        n' -> case n .&. 1 == 0 of
                                False -> i'
                                True  -> go i' n'

|| find index of last bit set
|| returns (-1) if bitSet is empty
bs_last
    = go (-1)
      where
        go i 0 = i
        go i n
            = case i + 1 of
                i' -> case n .>>. 1 of
                        n' -> go i' n'

bs_insert n bs = bs .|. (1 .<<. n)
bs_delete n bs = bs .&. complement (1 .<<. n)

bs_union s1 s2 = s1 .|. s2

bs_difference :: bitSet -> bitSet -> bitSet
bs_difference s1 s2 = s1 .&. complement s2

bs_intersect s1 s2 = s1 .&. s2

bs_fromList = foldr bs_insert 0

bs_toList
    = go 0
      where
        go i 0 = []
        go i n
            = case i + 1 of
                i' -> case n .>>. 1 of
                        n' -> case n .&. 1 == 0 of
                                False -> i : go i' n'
                                True  ->     go i' n'

bs_toInt   s = s
bs_fromInt s = s

showbitSet = showhex
cmpbitSet  = cmpint
