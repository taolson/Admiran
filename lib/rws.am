|| rws.am -- reader+writer+state functor/applicative/monad with strict writer and state
||
|| Note: the strictness of this implementation somewhat relies upon the inlining optimizations
|| in the compiler (e.g. inlining runState, (>>=), etc.) If this is compiled with inlining
|| disabled, then extra thunks are created which may cause space leaks


%export +

%import <base>
%import <lens>

|| *    is reader (environment) type
|| **   is writer (logging) type
|| ***  is state type
|| **** is result value type
rws * ** *** **** == * -> *** -> [**] -> (****, ***, [**])

|| running
runRWS :: rws * ** *** **** -> * -> *** -> [**] -> (****, ***, [**])
runRWS m r s w = m r s w

evalRWS :: rws * ** *** **** -> * -> *** -> [**] -> (****, [**])
evalRWS m r s w = case runRWS m r s w of (a, s', w') -> (a, w')

execRWS :: rws * ** *** **** -> * -> *** -> [**] -> (***, [**])
execRWS m r s w = case runRWS m r s w of (a, s', w') -> (s', w')


|| reader operations
ask :: rws * ** *** *
ask = \r s w -> (r, s, w)

asks :: (* -> ****) -> rws * ** *** ****
asks f = \r s w -> (f r, s, w)

local :: (* -> *) -> rws * ** *** **** -> rws * ** *** ****
local f m = \r s w -> runRWS m (f r) s w


|| writer operations
tell :: ** -> rws * ** *** ()
tell w = \_ s q -> ((), s, w : q)

tells :: ([**] -> [**]) -> rws * ** *** ()
tells f = \_ s q -> case f q of q' -> ((), s, q')


|| state operations
get :: rws * ** *** ***
get = \_ s w -> (s, s, w)

put :: *** -> rws * ** *** ()
put s = \_ _ w -> ((), s, w)

modify :: (*** -> ***) -> rws * ** *** ()
modify f = \_ s w -> case f s of s' -> ((), s', w)


|| lift lens operations into rws
view :: lens *** **** -> rws * ** *** ****
view lns = lens.view lns <$> get

over :: lens *** **** -> (**** -> ****) -> rws * ** *** ()
over lns f = modify (lens.over lns f)

set :: lens *** **** -> **** -> rws * ** *** ()
set lns x = modify (lens.set lns x)


|| monad interface

pure :: **** -> rws * ** *** ****
pure a = \_ s w -> (a, s, w)

(>>=) :: rws * ** *** **** -> (**** -> rws * ** *** *****) -> rws * ** *** *****
m >>= f
    = go
      where
        go r s w
            = case runRWS m r s w of (a, s', w') ->
              runRWS (f a) r s' w'

(>=>) :: (**** -> rws * ** *** *****) -> (***** -> rws * ** *** ******) -> **** -> rws * ** *** ******
f >=> g = \x -> f x >>= g

join :: rws * ** *** (rws * ** *** ****) -> rws * ** *** ****
join ma
    = go
      where
        go r s w
            = case runRWS ma r s w of (mb, s', w') ->
              runRWS mb r s' w'

mapM :: (**** -> rws * ** *** *****) -> [****] -> rws * ** *** [*****]
mapM f xs = foldr (f .> liftA2 (:)) (pure []) xs

|| since mapM_ runs the function f for its effect only, and can be used on
|| very large ranges for the list, it is better to write and explicit loop with
|| a tail call, rather than a foldr with state operations
mapM_ :: (**** -> rws * ** *** *****) -> [****] -> rws * ** *** ()
mapM_ f xs
    = go xs
      where
        go []       r s w = ((), s, w)
        go (x : xs) r s w = case f x of m -> case m r s w of (_, s', w') -> go xs r s' w'

forM :: [****] -> (**** -> rws * ** *** *****) -> rws * ** *** ()
forM xs f = mapM_ f xs

filterM :: (**** -> rws * ** *** bool) -> [****] -> rws * ** *** [****]
filterM p xs
    = foldr check (pure []) xs
      where
        check x       = liftA2 (cond x) (p x)
        cond  x False = id
        cond  x True  = (x :)

foldM :: (***** -> **** -> rws * ** *** *****) -> ***** -> [****] -> rws * ** *** *****
foldM f z0 xs
    = foldr c pure xs z0
      where
        c x k z = f z x >>= k

sequence :: [rws * ** *** ****] -> rws * ** *** [****]
sequence xs = foldr (liftA2 (:)) (pure []) xs


|| functor interface

(<$>) :: (**** -> *****) -> rws * ** *** **** -> rws * ** *** *****
f <$> m = m >>= (f .> pure)

(<&>) :: rws * ** *** **** -> (**** -> *****) -> rws * ** *** *****
m <&> f = f <$> m


|| applicative interface

(<*>) :: rws * ** *** (**** -> *****) -> rws * ** *** **** -> rws * ** *** *****
mf <*> ma = mf >>= (<$> ma)

liftA2 :: (**** -> ***** -> ******) -> rws * ** *** **** -> rws * ** *** ***** -> rws * ** *** ******
liftA2 f ma mb = f <$> ma <*> mb

liftA3 :: (**** -> ***** -> ****** -> *******) -> rws * ** *** **** -> rws * ** *** ***** -> rws * ** *** ****** -> rws * ** *** *******
liftA3 f ma mb mc = liftA2 f ma mb <*> mc

liftA4 :: (**** -> ***** -> ****** -> ******* -> ********) -> rws * ** *** **** -> rws * ** *** ***** -> rws * ** *** ****** ->
          rws * ** *** ******* -> rws * ** *** ********
liftA4 f ma mb mc md = liftA3 f ma mb mc <*> md

(<<) :: rws * ** *** **** -> rws * ** *** ***** -> rws * ** *** ****
ma << mb = liftA2 const ma mb

(>>) :: rws * ** *** **** -> rws * ** *** ***** -> rws * ** *** *****
ma >> mb = liftA2 (converse const) ma mb


|| lift multiple independent RWS actions and bind them to an N-ary function
bind2 :: rws * ** *** **** -> rws * ** *** ***** -> (**** -> ***** -> rws * ** *** ******) -> rws * ** *** ******
bind2 ma mb f = join (liftA2 f ma mb)

bind3 :: rws * ** *** **** -> rws * ** *** ***** -> rws * ** *** ****** -> (**** -> ***** -> ****** -> rws * ** *** *******) -> rws * ** *** *******
bind3 ma mb mc f = join (liftA3 f ma mb mc)
