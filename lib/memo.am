|| memo.am -- memoization of a single-argument function with a state map
||

%export memoSt memo

%import <base>
%import <map>             as m
%import <maybe> qualified as mb
%import <state>


|| a memoSt type uses a state consisting of an ordI instance for ordering the map's keys,
|| and a map from key (the memoized function's domain) to value (the memoized function's range)
memoSt * ** == state (ordI *, m.map * **) **

memo :: (* -> memoSt * **) -> * -> memoSt * **
memo f a
    = get >>= check
      where
        check (cmp, m)
            = mb.fromMaybef (f a >>= update) pure (lookup cmp a m)
              where
                update fa = pure fa << modify (mapSnd (insert cmp a fa))

|| example of memoizing the fibonacci function
|| fib :: int -> memoSt int int
|| fib
||     = memo fib'
||       where
||         (<+>)  = liftA2 (+)
||         fib' 0 = pure 0
||         fib' 1 = pure 1
||         fib' n = fib (n - 1) <+> fib (n - 2)
||
|| %import <io>
|| main :: io ()
|| main = evalState (fib 80) (cmpint, m.empty) |> showint |> putStrLn
