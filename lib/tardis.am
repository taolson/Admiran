|| tardis.am -- lazy bidirectional state monad


%export +

%import <base>

|| a tardis is a pair of states, one that travels backwards and one that travels forwards
|| *   is the backwards travelling state type
|| **  is the forwards travelling state type
|| *** is the result value type
tardis * ** *** == (*, **) -> (***, (*, **))

|| running
runState :: tardis * ** *** -> (*, **) -> (***, (*, **))
runState m s = m s

evalState :: tardis * ** *** -> (*, **) -> ***
evalState m s = runState m s |> fst

execState :: tardis * ** *** -> (*, **) -> (*, **)
execState m s = runState m s |> snd


|| state access
getPast :: tardis * ** **
getPast = \s -> (snd s, s)

getFuture :: tardis * ** *
getFuture = \s -> (fst s, s)

sendPast :: * -> tardis * ** ()
sendPast bw = \s -> ((), setFst bw s)

sendFuture :: ** -> tardis * ** ()
sendFuture fw = \s -> ((), setSnd fw s)

modifyForwards :: (** -> **) -> tardis * ** ()
modifyForwards f = \s -> ((), mapSnd f s)

modifyBackwards :: (* -> *) -> tardis * ** ()
modifyBackwards f = \s -> ((), mapFst f s)


|| monad interface

(>>=) :: tardis * ** *** -> (*** -> tardis * ** ****) -> tardis * ** ****
(>>=) m f
    = go
      where
        go s = (x2, (bw1, fw2))
               where
                 || written for maximal laziness, by not pattern matching
                 || further than required for each step
                 (x1, s1)   = m (bw2, fw)
                 (x2, s2)   = (f x1) (bw, fw1)
                 (bw,  fw)  = s
                 (bw1, fw1) = s1
                 (bw2, fw2) = s2

join :: tardis * ** (tardis * ** ***) -> tardis * ** ***
join ma = \s -> runState ma s |> uncurry runState

pure :: *** -> tardis * ** ***
pure x = \s -> (x, s)

(>=>) :: (*** -> tardis * ** ****) -> (**** -> tardis * ** *****) -> *** -> tardis * ** *****
(>=>) f g = \x -> f x >>= g


mapM :: (*** -> tardis * ** ****) -> [***] -> tardis * ** [****]
mapM f xs = foldr (f .> liftA2 (:)) (pure []) xs

mapM_ :: (*** -> tardis * ** ****) -> [***] -> tardis * ** ()
mapM_ f xs = foldr (f .> (>>)) (pure ()) xs

forM :: [***] -> (*** -> tardis * ** ****) -> tardis * ** ()
forM xs f = mapM_ f xs

filterM :: (*** -> tardis * ** bool) -> [***] -> tardis * ** [***]
filterM p xs
    = foldr check (pure []) xs
      where
        check x       = liftA2 (cond x) (p x)
        cond  x False = id
        cond  x True  = (x :)

foldM :: (**** -> *** -> tardis * ** ****) -> **** -> [***] -> tardis * ** ****
foldM f z0 xs
    = foldr c pure xs z0
      where
        c x k z = f z x >>= k

sequence_ :: [tardis * ** ***] -> tardis * ** ()
sequence_ xs = foldr (>>) (pure ()) xs


|| functor interface
(<$>) :: (*** -> ****) -> tardis * ** *** -> tardis * ** ****
(<$>) f m = m >>= (f .> pure)

(<&>) :: tardis * ** *** -> (*** -> ****) -> tardis * ** ****
(<&>) m f = (<$>) f m


|| applicative interface
(<*>) :: tardis * ** (*** -> ****) -> tardis * ** *** -> tardis * ** ****
(<*>) mf ma = mf >>= (<$> ma)

liftA2 :: (*** -> **** -> *****) -> tardis * ** *** -> tardis * ** **** -> tardis * ** *****
liftA2 f ma mb = (f <$> ma) <*> mb

liftA3 :: (*** -> **** -> ***** -> ******) -> tardis * ** *** -> tardis * ** **** -> tardis * ** ***** -> tardis * ** ******
liftA3 f ma mb mc = liftA2 f ma mb <*> mc

(<<) :: tardis * ** *** -> tardis * ** **** -> tardis * ** ***
(<<) ma mb = liftA2 const ma mb

(>>) :: tardis * ** *** -> tardis * ** **** -> tardis * ** ****
(>>) ma mb = liftA2 (converse const) ma mb

|| lift multiple independent state actions and bind them to an N-ary function
bind2 :: tardis * ** *** -> tardis * ** **** -> (*** -> **** -> tardis * ** *****) -> tardis * ** *****
bind2 ma mb f = join (liftA2 f ma mb)

bind3 :: tardis * ** *** -> tardis * ** **** -> tardis * ** ***** -> (*** -> **** -> ***** -> tardis * ** *******) -> tardis * ** *******
bind3 ma mb mc f = join (liftA3 f ma mb mc)
