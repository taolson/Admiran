|| vector.am -- immutable and mutable vectors, and the ST monad for sequencing in-place modification
||  O(1) read accesses
||  O(N) write accesses (replace, //) for immutable vectors
||  O(1) write accesses (write, modify) for mutable vectors
||  mutable vector operations sequenced through ST monad


%export +

%import <base>
%import <maybe>         -pure -(>>=) -(>>)
%import <state>  as st
%import <stream>
%import <stdlib> as std

|| immutable and mutable vectors holding elements of type *
vector  * ::= Vector  int word# || vector with size and unboxed pointer to base of vector in memory
mvector * ::= MVector int word# || mutable vector with size and unboxed pointer to base of vector in memory

|| custom ordI instance for vector that compares elements
cmpvector :: ordI * -> vector * -> vector * -> ordering
cmpvector cmp' v1 v2 = cmpstream cmp' (toStream v1) (toStream v2)

|| custom showI instance for vector that shows its elements
showvector :: showI * -> vector * -> string
showvector si v = "(Vector " ++ intercalate ", " (map si (toList v)) ++ ")"

|| ensure that a vector index is within bounds
safeIndex :: int -> int -> int
safeIndex n i
    = i,                                 if 0 <= i < n
    = error "vector index out of bounds", otherwise


|| vector creation

|| create a vector with a single value
singleton :: * -> vector *
singleton x
    = case allocArray# 1# of p# ->
      case writeArray# p# 0# x of _ ->
      Vector 1 p#

|| make a new vector and fill with a repeated value (uses fillArray# which is a low-level memset)
rep :: int -> * -> vector *
rep n x
    = case n of I# n# ->
      case allocArray# n# of p# ->
      case fillArray# p# x of _ ->
      Vector n p#

|| generate a vector from its index values
generate :: int -> (int -> *) -> vector *
generate n f = rangeFromS 0 |> mapS f |> fromStream n

|| iterate a function from an initial value to produce a vector
iterateN :: int -> (* -> *) -> * -> vector *
iterateN n f = iterateS f .> fromStream n


|| vector accessing

length :: vector * -> int
length (Vector n p#) = n

index, (!!) :: vector * -> int -> *
index (Vector n p#) i
    = case safeIndex n i of I# i# ->
      case readArray# p# i# of e -> e

v !! i = index v i

first :: vector * -> *
first v = v !! 0

last :: vector * -> *
last v = v !! (length v - 1)

replace, (//) :: vector * -> [(int, *)] -> vector *
replace v ies
    = runSTVector go v
      where
        n     = length v
        go mv = unsafeReplace mv [(safeIndex n i, e) | (i, e) <- ies]

v // ies = replace v ies


|| common list-like operations on vectors

(<$>) :: (* -> **) -> vector * -> vector **
f <$> v
    = evalState (go mv >> unsafeFreeze mv) ()
      where
        n     = length v
        mv    = unsafeThaw $ rep n undef
        go mv = forM [0 .. n - 1] (\i -> unsafeIndex v i |> f |> unsafeWrite mv i)

(<&>) :: vector * -> (* -> **) -> vector **
v <&> f = f <$> v

fmapWithIndex :: (int -> * -> **) -> vector * -> vector **
fmapWithIndex f v
    = evalState (go mv >> unsafeFreeze mv) ()
      where
        n     = length v
        mv    = unsafeThaw $ rep n undef
        go mv = forM [0 .. n - 1] (\i -> unsafeIndex v i |> f i |> unsafeWrite mv i)

|| filter can change size of a vector, so it's easiest just to convert to/from stream
filter :: (* -> bool) -> vector * -> vector *
filter f = toList .> std.filter f .> fromList || list used so we can get length of filtered list

|| lazy right-fold, to allow early-out of folding function
foldr :: (* -> ** -> **) -> ** -> vector * -> **
foldr f z (Vector n p#)
    = foldrS go z (rangeS 0 (n - 1))
      where
        go (I# i) z = case readArray# p# i of x -> f x z

|| strict left fold
foldl :: (** -> * -> **) -> ** -> vector * -> **
foldl f z (Vector n p#)
    = foldlS go z (rangeS 0 (n - 1))
      where
        go z (I# i) = case readArray# p# i of x -> f z x

append :: vector * -> vector * -> vector *
append va vb
    = appendS (toStream va) (toStream vb) |> fromStream n
      where
        n = length va + length vb

zipWith :: (* -> ** -> ***) -> vector * -> vector ** -> vector ***
zipWith f va vb
    = zipWithS f (toStream va) (toStream vb) |> fromStream n
      where
        n = min2 cmpint (length va) (length vb)

min, max :: ordI * -> vector * -> *
min cmp v = foldl (min2 cmp) (first v) v
max cmp v = foldl (max2 cmp) (first v) v

sum, product :: vector int -> int
sum     = foldl (+) 0
product = foldl (*) 1

any, all :: (* -> bool) -> vector * -> bool
any p = foldr (p .> (\/)) False
all p = foldr (p .> (&))  True

find :: (* -> bool) -> vector * -> maybe *
find p
    = foldr match Nothing
      where
      match x k
          = Just x, if p x
          = k,      otherwise

|| in-place quicksort algorithm on the vector
sortBy :: ordI * -> vector * -> vector *
sortBy cmp v
    = evalState (fullSort >> unsafeFreeze mv) 0 || state being passed through sort is the index i
      where
        mv       = thaw v
        fullSort = sort mv 0 (length v - 1)

        sort mv lo hi
            = pure (),            if lo >= hi \/ lo < 0
            = sortStep >>= sortRest, otherwise
              where
                sortStep   = put (lo - 1) >> unsafeRead mv hi >>= part
                sortRest p = sort mv lo (p - 1) >> sort mv (p + 1) hi

                part pivot
                    = mapM_ cmpSwap [lo .. hi - 1] >> swapWith hi >> get
                      where
                        swapWith j
                            = st.modify (+ 1) >> get >>= doReads
                              where
                                doReads i        = bind2 (unsafeRead mv i) (unsafeRead mv j) (doWrites i)
                                doWrites i vi vj = unsafeWrite mv i vj >> unsafeWrite mv j vi

                        cmpSwap j
                            = unsafeRead mv j >>= check
                              where
                                check vj
                                    = pure (), if _gt cmp vj pivot
                                    = swapWith j, otherwise

|| binary search a sorted vector for a matching entry, based upon the result of the cmp fn
|| return the matching value and its index or Nothing
|| uses a search on the open interval [lo .. hi), which is inclusive of lo but exclusive of hi
search :: (* -> * -> ordering) -> vector * -> * -> maybe (int, *)
search cmp v tgt
    = go 0 $ length v
      where
        go lo hi
            = Nothing, if lo == hi
            = check,   otherwise
              where
                mid   = lo + (hi - lo) $quot 2
                vm    = v !! mid
                check = case cmp vm tgt of
                          EQ -> Just (mid, vm)
                          LT -> go (mid + 1) hi
                          GT -> go lo mid

|| conversions

fromStream :: int -> stream * ** -> vector *
fromStream n (Stream next s)
    = case n of I# n#               ->
      case allocArray# n# of p#     ->
      case fillArray# p# undef of _ ->
      go 0# s
      where
        go i# s
            = case i# $cmp# n# of
                1# -> case next s of
                        Done       -> Vector n p#
                        Skip s'    -> go i# s'
                        Yield x s' -> case writeArray# p# i# x of _ ->
                                      case i# +# 1# of i'# ->
                                      go i'# s'
                _  -> Vector n p#

toStream :: vector * -> stream * int
toStream v
    = Stream next 0
      where
        n = length v
        next i
            = Done,                              if i >= n
            = Yield (unsafeIndex v i) (i + 1), otherwise

fromList :: [*] -> vector *
fromList es = fromStream n (stream.toStream es) where n = #es

toList :: vector * -> [*]
toList = toStream .> stream.fromStream


|| unsafe operations on vectors

unsafeIndex :: vector * -> int -> *
unsafeIndex (Vector n p#) (I# i#) = case readArray# p# i# of e -> e

unsafeThaw :: vector * -> mvector *
unsafeThaw (Vector n p#) = MVector n p#


|| operations on mutable vectors

mlength :: mvector * -> int
mlength (MVector n p#) = n

thaw :: vector * -> mvector *
thaw (Vector n p#)
    = case n of I# n# ->
      case allocArray# n# of d# ->
      case copyArray# d# p# of _ ->
      MVector n d#

|| operations on mutable vectors within the state monad
|| note: uses state ** rather than st to allow for mutable
|| vector operations using more general state

freeze :: mvector * -> state ** (vector *)
freeze (MVector n p#)
    = case n of I# n# ->
      case allocArray# n# of d# ->
      case copyArray# d# p# of _ ->
      pure $ Vector n d#

|| make a mutable copy of a mutable vector
clone :: mvector * -> state ** (mvector *)
clone (MVector n p#)
    = case n of I# n# ->
      case allocArray# n# of d# ->
      case copyArray# d# p# of _ ->
      pure $ MVector n d#

read :: mvector * -> int -> state ** *
read (MVector n p#) i
    = case safeIndex n i of I# i# ->
      case readArray# p# i# of e ->
      pure e

write :: mvector * -> int -> * -> state ** ()
write (MVector n p#) i e
    = case safeIndex n i of I# i# ->
      case writeArray# p# i# e of _ ->
      pure ()

modify :: mvector * -> (* -> *) -> int -> state ** ()
modify (MVector n p#) f i
    = case safeIndex n i of I# i# ->
      case readArray# p# i# of e ->
      case f e of e' ->
      case writeArray# p# i# e' of _ ->
      pure ()

fill :: mvector * -> * -> state ** ()
fill (MVector _ p#) e = case fillArray# p# e of _ -> pure ()


|| unsafe in-place operations on mutable vectors without copying or bounds-checking

unsafeFreeze :: mvector * -> state ** (vector *)
unsafeFreeze (MVector n p#) = pure $ Vector n p#

unsafeRead :: mvector * -> int -> state ** *
unsafeRead (MVector n p#) (I# i#)
    = case readArray# p# i# of e -> pure e

unsafeWrite :: mvector * -> int -> * -> state ** ()
unsafeWrite (MVector n p#) (I# i#) e
    = case writeArray# p# i# e of _ -> pure ()

unsafeModify :: mvector * -> (* -> *) -> int -> state ** ()
unsafeModify (MVector n p#) f (I# i#)
    = case readArray# p# i# of e ->
      case f e of e' ->
      case writeArray# p# i# e' of _ ->
      pure ()

unsafeReplace :: mvector * -> [(int, *)] -> state ** ()
unsafeReplace (MVector n p#) ies
    = doRep ies
      where
        doRep [] = pure ()

        doRep ((I# i#, e) : ies')
            = case writeArray# p# i# e of _ -> doRep ies'


|| ST monad for performing actions on mutable vectors and STRefs
|| Note: the ST monad in Haskell uses an existential type for the state, which is bound
|| to the particular reference to the array being modified.  However, Admiran does not
|| have existential types, so here the ST monad is just the state monad with Unit state
st * == state () *

|| run an STaction and return its value
runST :: st * -> *
runST a = evalState a ()

|| run an STaction on a mutable copy of a vector, then freeze it and return the new vector
runSTVector :: (mvector * -> st **) -> vector * -> vector *
runSTVector f v
    = evalState (f mv >> unsafeFreeze mv) ()
      where
        mv = thaw v

|| STRef implemented using a singleton mvector
stRef * == mvector *

newSTRef :: * -> st (stRef *)
newSTRef x = singleton x |> unsafeThaw |> pure

readSTRef :: stRef * -> st *
readSTRef a = unsafeRead a 0

writeSTRef :: stRef * -> * -> st ()
writeSTRef a = unsafeWrite a 0

modifySTRef :: stRef * -> (* -> *) -> st ()
modifySTRef a f = unsafeModify a f 0
