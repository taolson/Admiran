|| parser.am -- a parser combinator library for strings, based upon the maybeState monad, which tracks line and column position for error reporting
||
|| note: many parser function names shadow stdlib names, so parser should be imported qualified


%export + get put modify pure fail (>>=) (<$>) (<&>) (<*>) (<<) (>>) liftA2 liftA3 liftA4 mapM foldM bind2 bind3

%import <base>
%import <maybe>         -pure -(>>=) -(<$>) -(<&>) -(<*>) -(<<) -(>>) -liftA2 -mapM -foldM
%import <maybeState>
%import <stdlib>        as std


|| state passed through parser is current line and column numbers, and the list of chars not yet parsed
|| the line and column numbers are kept as unboxed word# values to optimize maintaining them during parsing
|| (allows better inlining of any and satisfy)

psSt     == (word#, word#, [std.char])       || current line#, col#, string yet to parse
parser * == maybeState psSt *

parse :: parser * -> [std.char] -> (maybe *, psSt)
parse p cs = p (1#, 1#, cs)

error :: psSt -> [std.char]
error (il, ic, cs) = "parse failed near line " ++ showint (I# il) ++ " col " ++ showint (I# ic)

|| alternative interface
|| note: a simple alias to maybeState (<|>) can't be used, here, because we need to return the
|| one with the the deepest progress of the two parses, if both fail
(<|>) :: parser * -> parser * -> parser *
(<|>) pa pb
    = go
      where
        go ps
            = ra,                if isJust $ fst ra
            = rb,                if isJust $ fst rb
            = max2 cmploc ra rb, otherwise
              where
                ra = runState pa ps
                rb = runState pb ps

                cmploc (_, (l1, c1, _)) (_, (l2, c2, _))
                    = cmpword# l1 l2 $thenCmp cmpword# c1 c2

|| peek and not check for the presence or absence of a token, but don't consume it
peek, not :: parser * -> parser ()
peek pa ps
    = (Just (), ps), if isJust ra
    = (Nothing, ps), otherwise
      where
        (ra, _) = pa ps

not pa ps
    = (Just (), ps), if isNothing ra
    = (Nothing, ps), otherwise
      where
        (ra, _) = pa ps

optional :: parser * -> parser (maybe *)
optional pa ps
    = (Just (Just a), psa), if isJust ra
    = (Just Nothing, ps),   otherwise
      where
        (ra, psa) = pa ps
        Just a    = ra

cons :: parser * -> parser [*] -> parser [*]
cons pa pb = liftA2 (:) pa pb

some :: parser * -> parser [*]
some p = p $cons many p

many :: parser * -> parser [*]
many p = some p <|> pure []

|| fixed count of p
count :: std.int -> parser * -> parser [*]
count n p = mapM (const p) [1 .. n]

|| 1 or more p seperated by ps
someSepBy :: parser * -> parser ** -> parser [**]
someSepBy ps p = p $cons many (ps >> p)

|| 0 or more p seperated by ps
manySepBy :: parser * -> parser ** -> parser [**]
manySepBy ps p = someSepBy ps p <|> pure []

|| 0 or more pa until pb, keeping the list of pas
manyUntil :: parser * -> parser ** -> parser [*]
manyUntil pa pb = (pb >> pure []) <|> (pa $cons manyUntil pa pb)

|| 0 or more pa until pb, keeping pb
skipUntil :: parser * -> parser ** -> parser **
skipUntil pa pb = pb <|> (pa >> skipUntil pa pb)

|| parser which passes only at end of input
end :: parser ()
end (il, ic, []) = (Just (), (il, ic, []))
end ps = (Nothing, ps)

|| parser which accepts any character
any :: parser std.char
any (il, ic, []) = (Nothing, (il, ic, []))
any (il, ic, (c : cs))
    = case c ==. '\n' of
        False -> case ic +# 1# of ic' -> (Just c, (il, ic', cs))
        True  -> case il +# 1# of il' -> (Just c, (il', 1#, cs))

|| parser for a character which satifies a condition
satisfy :: (std.char -> bool) -> parser std.char
satisfy f
    = any >>= fsat
      where
        fsat c = pure c, if f c
               = fail,   otherwise

|| parser which matches a specific character
char :: std.char -> parser std.char
char c = satisfy (c ==.)

notChar :: std.char -> parser std.char
notChar c = satisfy (c ~=.)

digit :: parser std.char
digit = satisfy std.digit

letter :: parser std.char
letter = satisfy std.letter

space :: parser std.char
space = satisfy (member cmpchar " \t\n")

spaces :: parser [std.char]
spaces = many space

comma :: parser std.char
comma = char ','

anyOf :: [std.char] -> parser std.char
anyOf s = satisfy (member cmpchar s)

noneOf :: [std.char] -> parser std.char
noneOf s = satisfy (member cmpchar s .> base.not)

|| structure parsers
inParens, inBrackets, inBraces, inAngles :: parser * -> parser *
inParens   p = char '(' >> p << char ')'
inBrackets p = char '[' >> p << char ']'
inBraces   p = char '{' >> p << char '}'
inAngles   p = char '<' >> p << char '>'

|| parser which matches a specific string
string :: [std.char] -> parser [std.char]
string s = foldr (char .> (>>)) (pure s) s

posint :: parser std.int
posint = (<$>) intval (some digit)

int :: parser std.int
int = liftA2 mkint (optional (char '-')) posint
        where
          mkint mn n =  n, if isNothing mn
                     = -n, otherwise

|| parse a word
word :: parser [std.char]
word = some letter

|| parse a list of ints separated by a comma
intlist :: parser [std.int]
intlist = someSepBy comma int

|| read an intlist from a string, or report an error
readIntlist :: std.string -> [std.int]
readIntlist s
    = fromMaybe err mns
      where
        (mns, ps) = parse intlist s
        err       = std.error (error ps)
