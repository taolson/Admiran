|| fixed-point representation with 16-bit fractional part, as a substitute for floats

%export +

abstype fix16 with
    (+%)            :: fix16  -> fix16 -> fix16
    (-%)            :: fix16  -> fix16 -> fix16
    (*%)            :: fix16  -> fix16 -> fix16
    (/%)            :: fix16  -> fix16 -> fix16
    (==%)           :: fix16  -> fix16 -> bool
    (~=%)           :: fix16  -> fix16 -> bool
    (<%)            :: fix16  -> fix16 -> bool
    (<=%)           :: fix16  -> fix16 -> bool
    (>%)            :: fix16  -> fix16 -> bool
    (>=%)           :: fix16  -> fix16 -> bool
    toFix16Int      :: int    -> fix16
    toFix16Frac     :: int    -> fix16
    fix16Int        :: fix16  -> int
    fix16Frac       :: fix16  -> int
    fix16val        :: string -> fix16
    showfix16       :: fix16  -> string
    showfix16Digits :: int    -> fix16 -> string
    cmpfix16        :: fix16  -> fix16 -> ordering


|| implementation uses int, scaling multiplication and division appropriately

fix16 == int

a +% b = a + b
a -% b = a - b
a *% b = a * b .>>. 16
a /% b = (a .<<. 16) / b

a ==% b = a == b
a ~=% b = a ~= b
a <% b  = a <  b
a <=% b = a <= b
a >% b  = a >  b
a >=% b = a >= b

toFix16Int x  = x .<<. 16
toFix16Frac x = x

|| return integer portion of fix16, adjusting for negative fractional values
fix16Int x
    = ix,     if x > 0 \/ x .&. 0xffff == 0
    = ix + 1, otherwise
      where
        ix = x .>>. 16

|| return fractional portion of fix16, adjusting for negative fractional values
fix16Frac x
    = fx,           if x > 0 \/ fx == 0
    = fx - 0x10000, otherwise
      where
        fx = x .&. 0xffff

|| convert a float string representation to a fix16
fix16val ('-' : xs) = -fix16val xs
fix16val xs
    = goInt 0 xs
      where
        code0 = code '0'

        || parse and convert integer part
        goInt n (x : xs)
            = goInt (n * 10 + code x - code0) xs, if '0' <=. x <=. '9'
            = (n .<<. 16) + goFrac 0 10 xs,       if x ==. '.'
            = n .<<. 16,                          otherwise

        goInt n _ = n .<<. 16

        || parse and convert fractional part
        goFrac n d (x : xs)
            = goFrac n' (d * 10) xs, if '0' <=. x <=. '9'
              where
                n' = n + (code x - code0 .<<. 32) $quot d

        goFrac n _ _ = n .>>. 16

|| show the fix16 fractional value in a field of d digits,
|| returning the string and a potential carry bit into the integer part
|| due to rounding
showFracDigits :: int -> fix16 -> (int, string)
showFracDigits 0 n = (n .>>. 15, [])  || round the next digit up, if remaining frac is > 0.5
showFracDigits i n
    = (c', showdigit d' : s)
      where
        n'       = n * 10
        d        = fix16Int n'
        r        = fix16Frac n'
        (c, s)   = showFracDigits (i - 1) r
        (c', d') = (d + c) $quotrem 10

        showdigit d = decode (d + code '0')

showfix16Digits d n
    = '-' : showfix16Digits d (-n), if n < 0
    = si ++ "." ++ sf,              otherwise
      where
        (c, sf) = showFracDigits d (fix16Frac n)
        ni      = fix16Int n + c
        si      = showint ni

showfix16 n = showfix16Digits 5 n

cmpfix16 a b = cmpint a b
