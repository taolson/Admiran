|| bag.am -- implementation of a strict multiset using AVL trees


%export + m.empty m.null m.size m.member m.first m.last m.lookup m.findWithDefault m.elems m.keys m.keysSet m.toList m.deleteKey
          m.adjust m.alter

%import <avl>
%import <map>    qualified as m   deleteKey/delete
%import <maybe>
%import <stdlib> as std

bag * == m.map * int

singleton :: * -> bag *
singleton x = m.singleton x 1

insert :: ordI * -> * -> bag * -> bag *
insert cmp key = m.insertWith cmp (+) key 1

insertTimes :: ordI * -> * -> int -> bag * -> bag *
insertTimes cmp = m.insertWith cmp (+)

delete :: ordI * -> * -> bag * -> bag *
delete cmp key = deleteTimes cmp key 1

deleteTimes :: ordI * -> * -> int -> bag * -> bag *
deleteTimes cmp k n b
    = fromMaybe b $ go b
      where
        go AVLLeaf = Nothing
        go (AVLNode p l r h)
            = case p of
                (k', n') -> case cmp k k' of
                              EQ -> case nd > 0 of
                                      False -> Just $ moveR l r
                                      True  -> Just $ AVLNode (k, nd) l r h
                              LT -> go l <&> insL
                              GT -> go r <&> insR
                            where
                              nd = n' - n
              where
                insL l' = balance $ AVLNode p l' r h
                insR r' = balance $ AVLNode p l r' h


fromList :: ordI * -> [*] -> bag *
fromList cmp = std.foldl (converse (insert cmp)) empty

fromCountList :: ordI * -> [(*, int)] -> bag *
fromCountList cmp
    = std.foldl addEntry empty
      where
        addEntry b (k, v) = insertTimes cmp k v b

|| make a bag from a list of keys, with zero counts
withKeys :: ordI * -> [*] -> bag *
withKeys cmp
    = std.foldl ins empty
      where
        ins b k = insertTimes cmp k 0 b

union :: ordI * -> bag * -> bag * -> bag *
union cmp b1 b2
    = std.foldl addEntry b1 (toList b2)
      where
        addEntry b (k, v) = insertTimes cmp k v b
