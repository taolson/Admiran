|| set.am -- implementation of a strict set using AVL trees


%export + avl.empty avl.null avl.singleton avl.isSingleton avl.size avl.member avl.first avl.last avl.delete avl.toList avl.foldr avl.foldl

%import <avl>
%import <maybe>  as mb
%import <stdlib> as std


set * == avlTree *

insert :: ordI * -> * -> set * -> set *
insert cmp v
    = go
      where
        go  AVLLeaf = singleton v
        go (AVLNode v' l r h)
            = case cmp v v' of
                EQ -> AVLNode v l r h                   || same value maps to single node
                LT -> case go l of l' -> balance $ AVLNode v' l' r h
                GT -> case go r of r' -> balance $ AVLNode v' l r' h

|| insert a value into the set only if it is not already a member of the set,
|| otherwise return Nothing
|| allows a single traversal to both check for set membership and insert a value
insertIfAbsent :: ordI * -> * -> set * -> maybe (set *)
insertIfAbsent cmp v
    = go
      where
        go  AVLLeaf = Just $ singleton v
        go (AVLNode v' l r h)
            = case cmp v v' of
                EQ -> Nothing
                LT -> go l mb.<&> insL
                GT -> go r mb.<&> insR
              where
                insL l' = balance $ AVLNode v' l' r h
                insR r' = balance $ AVLNode v' l r' h

|| return the minimum element and the rest of the set, or Nothing if the set is empty
viewMin :: set * -> maybe (*, set *)
viewMin AVLLeaf = Nothing
viewMin (AVLNode v l r h)
    = case avl.null l of
        False -> viewMin l mb.<&> balanceL
        True  -> Just (v, r)
      where
        balanceL (v', l') = case balance $ AVLNode v l' r h of n' -> (v', n')

|| return the maximum element and the rest of the set, or Nothing if the set is empty
viewMax :: set * -> maybe (*, set *)
viewMax AVLLeaf = Nothing
viewMax (AVLNode v l r h)
    = case avl.null r of
        False -> viewMax r mb.<&> balanceR
        True  -> Just (v, l)
      where
        balanceR (v', r') = case balance $ AVLNode v l r' h of n' -> (v', n')

|| find the closest value in the set that is <= the given value
lookupLE :: ordI * -> * -> set * -> maybe *
lookupLE cmp v
    = go Nothing
      where
        go b AVLLeaf = b
        go b (AVLNode v' l r h)
            = case cmp v' v of
                EQ -> Just v'
                LT -> go (Just v') r
                GT -> go b l

|| find the closest value in the set that is >= the given value
lookupGE :: ordI * -> * -> set * -> maybe *
lookupGE cmp v
    = go Nothing
      where
        go b AVLLeaf = b
        go b (AVLNode v' l r h)
            = case cmp v' v of
                EQ -> Just v'
                LT -> go b r
                GT -> go (Just v') l

fromList :: ordI * -> [*] -> set *
fromList cmp = std.foldl (converse (insert cmp)) empty

union :: ordI * -> set * -> set * -> set *
union cmp s1 s2 = std.foldl (converse (insert cmp)) s1 $ toList s2

difference :: ordI * -> set * -> set * -> set *
difference cmp s1 s2 = std.foldl (converse (delete cmp)) s1 $ toList s2

intersect :: ordI * -> set * -> set * -> set *
intersect cmp s1 s2
    = fromList cmp (go (toList s1) (toList s2))
      where
        go (x : xs) (y : ys)
            = case cmp x y of
                EQ -> x : go xs       ys
                LT ->     go xs       (y : ys)
                GT ->     go (x : xs) ys
        go xs ys = []

filter :: ordI * -> (* -> bool) -> set * -> set *
filter cmp p = toList .> std.filter p .> fromList cmp


|| functor interface
|| (<$>) changes the key value that is used in the AVL tree, so the easiest
|| way to do it is to serialize to a list, map, then deserialize to the new set
(<$>) :: ordI ** -> (* -> **) -> set * -> set **
(<$>) cmp f = toList .> map f .> fromList cmp

(<&>) :: ordI ** -> set * -> (* -> **) -> set **
(<&>) cmp m f = (<$>) cmp f m
