|| check the files specified on the command line for lines that exceed 159 columns or end with spaces


%import <base>
%import <io>            (>>=)/io_bind (<&>)/io_rfmap


result == (string, [num])

blankOrLong :: string -> bool
blankOrLong s
    = go 0 s
      where
        go n []       = False
        go n [c]      = n >= 159 \/ isSpace c
        go n (c : cs) = go (n + 1) cs

processFile :: string -> io result
processFile fn
    = readFile fn <&> process
      where
        process = lines .> zip2 [1 ..] .> filter (blankOrLong . snd) .> map fst .> pair fn

main :: io ()
main
    = getArgs >>= io_mapM processFile >>= report
      where
        report = filter (not . null . snd) .> map showresult .> io_mapM_ putStrLn
