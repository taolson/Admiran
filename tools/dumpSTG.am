|| dumpSTG -- extract and dump the STG Instructions from a .s file comments

%import <base>
%import <io>
%import <maybe>         -(>>=)

stg ::= Insn string | Label string | Comment string

|| custom showI instance for stg to format insns and labels
showstg :: showI stg
showstg (Insn s)    = "    " ++ s
showstg (Label s)   = s
showstg (Comment s) = "\n# " ++ s

|| classify a line into an STG insn, a code Label, or Nothing
classify :: string -> maybe stg
classify ('#' : ' ' : s)
    = Comment s       |> Just, if null s
    = init s' |> Insn |> Just, if c ==. '('
    =      s  |> Insn |> Just, if isUpper c
    = Comment s       |> Just, otherwise
      where
        c : s' = s

classify ('c' : 'o' : s) = Just $ Label s
classify _               = Nothing

|| extract the STG insns from the file and print
process :: string -> io ()
process fn
    = mtimeFile fs >>= exists
      where
        fs = withSuffix "s" fn

        exists tsm
            = error (fs ++ " required, but not found"), if tsm < 0
            = readFile fs >>= dumpSTG,                  otherwise

        dumpSTG = lines .> map classify .> catMaybes .> mapM_ (showstg .> putStrLn)

main :: io ()
main = getArgs >>= go
       where
         go [fn] = process fn
         go _    = error "usage: dumpSTG <file name>"
