|| genericCtors.am -- experimental post-processing of an amc-generated asm file to use a single generic constructor
|| for each (tag, arity) combination, and to inline tail-calls to generic constructors
|| will be used to determine whether it is worth it to put this optimization into the compiler


%import <base>
%import <map>           qualified as m
%import <maybe>         as mb           -(>>=) -(<$>) -(<<) -(>>) -(<|>)
%import <maybe>         qualified as mb
%import <maybeState>    as mst
%import <parser>        qualified as p
%import <io>                            -(>>=) -(<$>) -(<<) -(>>)
%import <io>            qualified
%import <stdlib>

insn ::= Insn string string | Pseudo string string | LocalLbl string | Comment string

showinsn :: insn -> string
showinsn (Insn op args)   = "\t"  ++ op ++ "\t" ++ args ++ "\n"
showinsn (Pseudo op args) = "\t." ++ op ++ "\t" ++ args ++ "\n"
showinsn (LocalLbl s)     = s ++ ":\n"
showinsn (Comment s)      = "# " ++ s ++ "\n"

viewArgs :: insn -> maybe string
viewArgs (Insn op args)   = Just args
viewArgs (Pseudo op args) = Just args
viewArgs _                = Nothing

setArgs :: string -> insn -> insn
setArgs args (Insn op _)   = Insn op args
setArgs args (Pseudo op _) = Pseudo op args
setArgs _    insn          = insn


|| a code or data basic block of insns, or an assembler segment directive
block ::= Block [insn] string [insn] |  || comment/globl header associated with block, label, instructions
          Directive insn                || stand-alone segment directive

showblock :: block -> string
showblock (Block hdr lbl insns) = concatMap showinsn hdr ++ lbl ++ ":\n" ++ concatMap showinsn insns
showblock (Directive i)         = showinsn i


|| parsing asm file

identChar :: char -> bool
identChar c = letter c \/ digit c \/ c ==. '_'

anyPrefix :: [string] -> string -> bool
anyPrefix ps s = any (\p -> isPrefixOf cmpchar p s) ps

isHeader, isDirective, isData :: string -> bool
isHeader  s   = anyPrefix ["globl"] s
isDirective s = anyPrefix ["text", "data", "p2align"] s
isData    s   = anyPrefix ["quad", "ascii", "byte"] s

p_nl :: p.parser char
p_nl = p.char '\n'

p_space' :: p.parser char
p_space'
    = p.any >>= check
      where
        check c = p.pure c, if c ==. ' ' \/ c ==. '\t'
                = p.fail,   otherwise

p_spaces' :: p.parser string
p_spaces' = p.some p_space'

p_discardLine :: p.parser ()
p_discardLine = p.skipUntil p.any p_nl >> p.pure ()

p_restOfLine :: p.parser string
p_restOfLine = p.many p_space' >> p.manyUntil p.any p_nl

p_identChar :: p.parser char
p_identChar
    = p.any >>= check
      where
        check c = p.pure c, if identChar c
                = p.fail,   otherwise

p_ident :: p.parser string
p_ident = p.some p_identChar

p_pseudo :: (string -> bool) -> p.parser string
p_pseudo tst
    = p.char '.' >> p_ident >>= check
      where
        check s = p.pure s, if tst s
                = p.fail,   otherwise

p_lbl :: p.parser string
p_lbl = p_ident << p.char ':' << p_discardLine

p_localLbl :: p.parser string
p_localLbl = (p.some p.digit) << p.char ':' << p_discardLine

p_comment :: p.parser string
p_comment = p.char '#' >> p_restOfLine

p_insn :: p.parser insn
p_insn
    = p.liftA2 Insn   (p_spaces' >> p_ident)         p_restOfLine <|>
      p.liftA2 Pseudo (p_spaces' >> p_pseudo isData) p_restOfLine <|>
      LocalLbl <$> p_localLbl                                     <|>
      Comment  <$> p_comment

p_headerInsn :: p.parser insn
p_headerInsn
    = (Comment <$> p_comment) <|>
      (p.liftA2 Pseudo (p_spaces' >> p_pseudo isHeader) p_restOfLine)

p_header :: p.parser [insn]
p_header = p.many (p.many p_nl >> p_headerInsn)

p_directive :: p.parser insn
p_directive = p.liftA2 Pseudo (p_spaces' >> p_pseudo isDirective) p_restOfLine

p_block :: p.parser block
p_block
    = p.many p_nl >>
      ( p.liftA3 Block p_header p_lbl (p.many p_insn) <|>
        Directive <$> p_directive
      )


|| block processing

|| (tag, arity) pair
tagAty == (int, int)

|| map from tag and arity to the generic ctor label
ctorMap == m.map tagAty string

|| map from a code label to a generic ctor label and its insns
jmpMap == m.map string (string, [insn])

gSt == (ctorMap, jmpMap)

|| check if ctor block should be installed as a new generic ctor block or
|| be replaced by one (returns Nothing to indicate replacement)
installOrReplace :: block -> tagAty -> maybeState gSt block
installOrReplace (Block hdr lbl insns) ta
    = p.get >>= go
      where
        go (cm, jm)
            = fromMaybef install replace (m.lookup cmptagAty ta cm)
              where
                cm'          = m.insert cmptagAty ta lbl cm
                jm' lbl'     = m.insert cmpstring lbl (lbl', insns) jm
                hdr'         = Comment ("Generic Ctor for " ++ showtagAty ta) : tl hdr
                install      = mst.put (cm', jm' lbl) >> mst.pure (Block hdr' lbl insns)
                replace lbl' = mst.put (cm, jm' lbl') >> mst.fail

installOrReplace _ _ = unreachable      || added to remove compiler warning

|| update the labels in the insns if they are found in the jmp map
|| also perform inlining of a generic ctor in a tail-call position
updateLabels :: [insn] -> maybeState gSt [insn]
updateLabels insns
    = mst.get >>= doUpdate .> mst.pure
      where
        doUpdate (cm, jm)
            = go insns
              where
                go []       = []
                go [i]      = fromMaybe [i] (tryInline i)               || replace tail-call jmp with ctor block
                go (i : is) = fromMaybe i   (tryUpdate i) : go is       || update label with generic ctor label

                tryInline (Insn "jmp" lbl) = snd       mb.<$> m.lookup cmpstring lbl jm
                tryInline i                = singleton mb.<$> tryUpdate i

                tryUpdate i = viewArgs i                              mb.>>=
                              \lbl       -> m.lookup cmpstring lbl jm mb.>>=
                              \(lbl', _) -> Just $ setArgs lbl' i

|| classify a block type and perform the appropriate operation
|| returns Nothing if the block was a replaced ctor block (to remove it from the code)
classify :: block -> maybeState gSt block
classify b
    = case b of
        Directive _         -> mst.pure b
        Block hdr lbl insns ->
            case (checkHdr hdr mb.>> checkCtor insns) of
              Nothing -> Block hdr lbl <$> updateLabels insns   || not a ctor block; update any code labels in insns
              Just ta -> installOrReplace b ta                  || ctor block; install or replace
      where
        replaceParens '(' = ' '
        replaceParens ')' = ' '
        replaceParens c   = c

        checkHdr (Comment s : _) = Nothing, if member cmpchar s '`'     || strict ctors (marked with `Sc in hdr comment) cannot be generic
        checkHdr _               = Just ()

        checkCtor (Comment s : _) = map replaceParens s |> words |> checkComment
        checkCtor _               = Nothing

        checkComment ["Ret", "Imm", "Word", st, "Imm", "Word", sa] = Just (intval st, intval sa)
        checkComment _                                             = Nothing

|| process the file a block at a time, parsing a block from the file stream and
|| writing out the updated block
process :: gSt -> p.psSt -> io p.psSt
process gs ps
    = mst.runState p_block ps |> checkParse                     || parse the next block with the parser state ps
      where
        checkParse (Nothing, ps') = io.pure ps'                 || no more blocks to process
        checkParse (Just b,  ps')
            = mst.runState (classify b) gs |> checkBlock        || process the block with the genericCtor state gs
              where
                checkBlock (Nothing, gs') = process gs' ps'
                checkBlock (Just b', gs') = putStrLn (showblock b') io.>> process gs' ps'


main :: io ()
main = getArgs io.>>= check
       where
         check [fn] = readFile fn io.>>= doProcess io.>>= p.end .> checkResult
         check _    = error "usage: genericCtors <asm file name>"

         doProcess s = process (m.empty, m.empty) (1#, 1#, s)

         checkResult (Nothing, ps) = error (p.error ps)
         checkResult _             = io.pure ()
