|| interface.am -- print the type specifications of a module's exported definitions

%import <base>
%import <either>
%import <io>
%import <lens>
%import <map>
%import <maybe>
%import <state>         (>>=)/st_bind (>>)/st_right

%import "../compiler/admiranParser"
%import "../compiler/module"

|| the "module" module from compiler depends upon the following modules also
|| located in the compiler directory; we explicitly import them here, because
|| the build system currently doesn't have a way of specifying a library directory
|| for module lookup other than the current directory or the system directory
%import "../compiler/ast"
%import "../compiler/config"
%import "../compiler/dependency"
%import "../compiler/exception"
%import "../compiler/grammar"
%import "../compiler/name"
%import "../compiler/parser"
%import "../compiler/predef"
%import "../compiler/tokenizer"

printSpecs :: (string, module) -> io ()
printSpecs (comment, m)
    = putStrLn ("### " ++ mn)     >>
      putStrLn (comment  ++ "\n") >>
      io_forM defStrings putStrLn >>
      putStrLn ""
      where
        mn         = view modName m
        specs      = view modSpecs m |> m_elems
        defs       = view modDefns m |> m_elems
        dataDefs   = filter isDefData defs
        synDefs    = filter isDefSyn  defs
        defStrings = concatMap (map showdefn .> sortBy cmpstring .> map ("    " ++)) [dataDefs, synDefs, specs]

process :: string -> io ()
process s
    = readFile fn >>= doParse
      where
        fs         = fileSpecFromString s
        fn         = fullFileName fs |> withSuffix "am"
        initModule = emptyModule fs m_empty

        doParse s = extractComment s |> mapSnd (parse initModule .> check) |> printSpecs

        extractComment ('|' : '|' : ' ' : xs) = break (==. '\n') xs
        extractComment xs               = ([], xs)

        check (Left _)       = error ("parsing " ++ showfileSpec fs)
        check (Right (m, _)) = m

main :: io ()
main = getArgs >>= io_mapM_ process
