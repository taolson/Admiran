|| dumpX2 -- pretty-print the .x2 file for a module, showing the type specs and definitions


%import <base>
%import <either>        -pure -(>>=)
%import <io>
%import <maybe>         -pure -(>>=)
%import <state>

%import "../compiler/module"

|| the "module" module from compiler depends upon the following modules also
|| located in the compiler directory; we explicitly import them here, because
|| the build system currently doesn't have a way of specifying a library directory
|| for module lookup other than the current directory or the system directory
%import "../compiler/config"            qualified
%import "../compiler/exception"         qualified
%import "../compiler/grammar"           qualified
%import "../compiler/name"              qualified
%import "../compiler/parser"            qualified
%import "../compiler/predef"            qualified
%import "../compiler/pretty"            qualified
%import "../compiler/serialize"
%import "../compiler/tokenizer"         qualified

deserialize :: string -> io module
deserialize fn
    = mtimeFile fx >>= exists
      where
        fx         = withSuffix "x2" fn
        doDeserial = pure . evalState deserialModule

        exists tsm
            = error (fx ++ " required, but not found"), if tsm < 0
            = readFile fx >>= doDeserial,               otherwise

main :: io ()
main
    = getArgs >>= go
      where
        go [fn] = deserialize fn >>= showmodule .> putStrLn
        go _    = error "usage: dumpX2 <file name>"
