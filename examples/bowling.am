|| bowling.am -- demonstration of "tying the knot" using lazy evaluation, performing computations on data from
||               prior and subsequent frames, and simultaneously passing new information forward and backward
||               to the prior and subsequent frames using the tardis monad

%import <base>
%import <io>
%import <tardis> qualified as td

frame ::=
    OpenFrame int int | || first roll, second roll, with some pins remaining; score = sum of both rolls
    Spare int         | || spare: first roll; second roll knocks down remaining pins; score = 10 + pins of next roll
    Strike            | || strike: single roll knocks down all pins; score = 10 + pins of next two rolls
    Extra int           || extra roll(s) in 10th frame due to strike/spare in 10th frame

|| score a frame, given the pin counts of the next two rolls, and
|| return a score and the pin counts for the current two rolls
scoreFrame :: int -> int -> frame -> (int, int, int)
scoreFrame fa fb (OpenFrame a b) = (a + b, a, b)
scoreFrame fa fb (Spare a)       = (10 + fa, a, 10 - a)
scoreFrame fa fb Strike          = (10 + fa + fb, 10, fa)
scoreFrame fa fb (Extra a)       = (0, a, fa)

|| tally a frame list's score and return the running score for each frame
|| the tardis state consists of a backward-traveling pair of the next two roll's pin counts,
|| and a forward-traveling running frame score
tally :: frame -> td.tardis (int, int) int int
tally f
    = td.bind2 td.getPast td.getFuture go       || get the running frame score from the past and the
      where                                     || next two roll's pin counts from the future
        go t (fa, fb)
            = td.sendPast (a, b) >>     || send the current two roll's pin counts to the past
              td.sendFuture t'   >>     || send the new running frame score to the future
              td.pure t'                || and return the current running frame score
              where
                (s, a, b) = scoreFrame fa fb f
                t'        = t + s

game133, game300 :: [frame]
game133 = [OpenFrame 1 4, OpenFrame 4 5, Spare 6, Spare 5, Strike, OpenFrame 0 1, Spare 7, Spare 6, Strike, Spare 2, Extra 6]
game300 = rep 10 Strike ++ rep 2 (Extra 10)

main :: io ()
main = td.evalState (td.mapM tally game133) ((0, 0), 0) |> take 10 |> showlist showint |> putStrLn
