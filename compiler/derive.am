|| derive.am -- derive instances of show and ord for user-defined data types and synonyms


%export deriveInstances

%import <base>
%import <lens>
%import <map>           qualified as m
%import <maybe>         as mb           -(>>=) -(<&>)
%import <maybe>         qualified as mb
%import "exception"     as ex
%import "grammar"
%import "module"
%import "name"
%import "predef"


|| derive a show instance spec and defn for a user-defined data type or synonym
deriveShow :: defn -> (defn, defn)
deriveShow d
    = (defSpec, defFn)
      where
        fn        = "show" ++ getName (defnName d) |> Unqualified
        an        = viewAnno d
        tfd       = view defnTform d
        tvs       = tformVars tfd
        instNames = map (Internal "showtv") [0 ..] |> zip2 tvs
        spec      = foldr (Tarr . ($Tarr stdString)) (tfd $Tarr stdString) tvs
        go        = Unqualified "go"
        ctors     = view dataCtors d
        goDefs    = map genDef ctors
        goDict    = DefMult Mfun goDefs |> m.singleton go

        e = Elet False goDict [] (Evar go), if isDefData d
          = showForType (view defnType d),  otherwise

        defSpec = DefSpec (Tname fn []) spec an
        defFn   = DefFn fn (map (Pvar . snd) instNames) e an

        showForType (Tvar n)     = Tvar n |> findInstName |> fromMaybef builtinFail Evar
        showForType (Ttuple ts)  = map showForType ts |> foldl Eap (makeTupleShow $ #ts)
        showForType (Tlist t)    = showForType t |> Eap stdShowList
        showForType (Tarr t1 t2) = stdShowFn
        showForType (Tstrict t)  = showForType t
        showForType (Tname tn vars)
            = map showForType vars |> foldl Eap (mkShow tn |> Evar)
              where
                mkShow (Qualified  m n) = Qualified  m $ "show" ++ n
                mkShow (Unresolved m n) = Unresolved m $ "show" ++ n
                mkShow n                = Unqualified  $ "show" ++ getName n

        showForType _ = unreachable

        findInstName te = find (fst .> (_eq cmptexpr te)) instNames mb.<&> snd

        genDef (Tname n tas)
            = DefFn go [Pctor n (map Pvar vars)] showExpr an
              where
                ns        = Estring $ getName n
                (_, vars) = genNames "a" 0 tas

                showExpr = ns,                                                                 if null tas
                         = showInParens buildExpr,                                             otherwise

                buildExpr = foldl appendShow ns . map mkShow $ zip2 tas [0 ..],                if ~isSymbol n
                          = foldl appendShow (mkShow (tas ! 0, 0)) [ns, mkShow (tas ! 1, 1)],  if #tas == 2
                          = foldl appendShow (showInParens ns) . map mkShow $ zip2 tas [0 ..], otherwise

                showInParens s   = ap2 stdAppend (Estring "(") . ap2 stdAppend s $ Estring ")"
                appendShow s1 s2 = ap2 stdAppend s1 $ ap2 stdAppend (Estring " ") s2
                mkShow (t, i)    = Eap (showForType t) . Evar $ Internal "a" i

         genDef _ = unreachable

|| derive an ord instance spec and defn for a user-defined data type or synonym
deriveOrd :: defn -> (defn, defn)
deriveOrd d
    = (defSpec, defFn)
      where
        fn        = "cmp" ++ getName (defnName d) |> Unqualified
        an        = viewAnno d
        tfd       = view defnTform d
        tvs       = tformVars tfd
        instNames = map (Internal "cmptv") [0 ..] |> zip2 tvs
        spec      = foldr (cmpSpec .> Tarr) (cmpSpec tfd) tvs
        go        = Unqualified "go"
        ctors     = view dataCtors d
        nullary   = tformVars .> null
        vars      = map Unqualified ["a", "b"]
        tagCmp    = DefFn go (map Pvar vars) (Ecall stdCmpTags (map Evar vars)) an
        goDict    = DefMult Mfun goDefs |> m.singleton go

        goDefs = [genDef a b | a, b <- zip2 ctors [0 ..]],          if #ctors <= 5
               = [genDef a a | a <- zip2 ctors [0 ..]] ++ [tagCmp], otherwise

        e = stdCmpTags,                     if isDefData d & all nullary ctors
          = Elet False goDict [] (Evar go), if isDefData d
          = cmpForType (view defnType d),   otherwise

        defSpec   = DefSpec (Tname fn []) spec an
        defFn     = DefFn fn (map (snd .> Pvar) instNames) e an
        cmpSpec t = t $Tarr t $Tarr stdOrdering

        cmpForType (Tvar n)     = Tvar n |> findInstName |> fromMaybef builtinFail Evar
        cmpForType (Ttuple ts)  = map cmpForType ts |> foldl Eap (makeTupleCmp $ #ts)
        cmpForType (Tlist t)    = cmpForType t |> Eap stdCmpList
        cmpForType (Tarr t1 t2) = stdCmpFn
        cmpForType (Tstrict t)  = cmpForType t

        cmpForType (Tname tn vars)
            = map cmpForType vars |> foldl Eap (mkCmp tn |> Evar)
              where
                mkCmp (Qualified  m n) = Qualified  m $ "cmp" ++ n
                mkCmp (Unresolved m n) = Unresolved m $ "cmp" ++ n
                mkCmp n                = Unqualified  $ "cmp" ++ getName n

        cmpForType _ = unreachable

        findInstName te = find (fst .> (_eq cmptexpr te)) instNames mb.<&> snd

        genDef (c1, tag1) (c2, tag2)
            = DefFn go [genPat c1 "a", genPat c2 "b"] cmpExpr an
              where
                tvs         = tformVars c1
                ctorTvarIdx = zip2 tvs [0 ..]

                cmpExpr = stdLT,                                           if tag1 < tag2
                        = stdGT,                                           if tag1 > tag2
                        = stdEQ,                                           if null tvs
                        = foldr1 (ap2 stdThenCmp) (map mkCmp ctorTvarIdx), otherwise

                mkCmp (t, i) = ap2 (cmpForType t) (Evar (Internal "a" i)) (Evar (Internal "b" i))

                genPat (Tname n tas) s
                    = Pctor n (map Pvar vars)
                      where
                        (_, vars) = genNames s 0 tas

                genPat _ _ = unreachable

|| derive any missing instances for ord, show for the dataDefs
deriveInstances :: globalEnv -> excpt globalEnv
deriveInstances genv
    = ex.foldM insInstance m (shows ++ ords) <&> \m -> set genvMod m genv
      where
        m             = view genvMod genv
        defs          = view modDefns m
        pats          = view modPats m
        ddefs         = m.elems defs |> filter isDerivable
        shows         = filter (missing "show") ddefs |> map deriveShow
        ords          = filter (missing "cmp")  ddefs |> map deriveOrd
        isDerivable d = isDefData d & (not . null . view dataCtors) d \/ isDefSyn d

        insInstance m (ds, df)
            = modInsSpec ds m >>= modInsDef df

        missing s d
            = isNothing (m.lookup cmpname n' defs) & ~any (match n') pats
              where
                n  = defnName d
                n' = Qualified (getModName n) (s ++ getName n)

                match n (DefPat (Pvar n') e an) = _eq cmpname n n'
                match n p                       = False
