|| turn an excpt * into an io *
io_excpt :: excpt * -> io *
io_excpt (Left errs)        = io_mapM_ (errStrLn . showexception) errs  >> exit 1       || print the errors and exit
io_excpt (Right (r, warns)) = io_mapM_ (errStrLn . showexception) warns >> io_pure r    || print the warnings and continue with the result

|| serialize a module to an ".x2" file
serialize :: globalEnv -> io moduleMap
serialize genv
    = serialModule m [] |> writeFile fx >> io_pure mm
      where
        m  = view genvMod genv
        mm = view genvModMap genv
        fs = view modFile m
        fx = fullFileName fs |> withSuffix "x2"

|| either parse the .am file or deserialize the .x2 file of a fileSpec, depending
|| upon their relative modification times, forcing a parse if force is True
parseOrDeserial :: bool -> fileSpec -> io module
parseOrDeserial force f
    = mtimeFile fm >>= exists
      where
        fn         = fullFileName f
        fm         = withSuffix "am" fn
        fx         = withSuffix "x2" fn
        initModule = emptyModule f builtinEnv
        doDeserial = readFile fx >>= deserialModule .> fst .> io_pure
        doParse    = putStrLn ("parsing  " ++ fn) >> readFile fm >>= parse initModule .> io_excpt

        exists tsm
            = io_excpt (ex_error err emptyLocInfo), if tsm < 0
            = doParse,                              if force
            = mtimeFile fx >>= x2exists tsm,        otherwise
              where
                err = Info $ fm ++ " required, but not found"

        x2exists tsm tsx
            = doDeserial, if tsx >= tsm
            = doParse,    otherwise

|| parse or deserialize the modules from a list of file specs
readModules :: [fileSpec] -> io moduleMap
readModules files
    = go m_empty files
      where
        go modules [] = io_pure modules
        go modules (f : fs)
            = go modules fs,                          if m_member cmpstring mn modules    || already parsed
            = parseOrDeserial False f >>= addImports, otherwise
              where
                mn = fileSpecName f
                addImports mdl
                    = go modules' (fs ++ imports)
                      where
                        modules' = m_insert cmpstring mn mdl modules
                        imports  = modImportFiles mdl

|| build a module and insert into the module map, by making a globalEnvironment
|| and passing that through a sequence of compilation passes
buildModule :: moduleMap -> string -> io moduleMap
buildModule mm n
    = putStrLn ("building " ++ n) >> io_foldM doPass genv passes >>= setBuilt .> serialize
      where
        Just m        = m_lookup cmpstring n mm
        notData d     = ~isDefData d & ~isConstructor (defnName d)
        doPass genv p = io_excpt (p genv)
        setBuilt      = over genvMod (set modBuildStatus Built) .> updateEnv
        genv          = (m, mm, 20)       || the gen value must be larger than the largest number of free variables in the type signature for any function,
                                          || otherwise the requirement that new free vars cannot conflict with any existing ones during type checking
                                          || can be violated
        || for bootstrap build, comment out:
        ||     analyzeWarn, typecheck, streamSubst, inline
        || note that this must be done by commenting out the functions, here, rather than relying upon a
        || config parameter for bootstrapBuild, because runtime-qualification of a call will not be dead-code
        || eliminated in the final bootstrapBuild, because inlining is disabled.
        passes =
            [ reifyImports                || reify all the exports from imported modules
            , reifyDefns isDefData        || reify data type and constructor names early for desugaring constructor patterns
            , deriveInstances             || derive any missing instances for show, ord from the DefData and DefSyn defns
            , desugar                     || desugar complex pats, list comprehensions, conditionals, etc.
            , reifyDefns notData          || reify all the desugared fn and pat definitions
            , rename                      || qualify or uniquely rename as Internal all Unqualified names
            , analyze                     || free var analysis for rewrite
            , rewrite                     || organize Elets for typecheck, cleanup and general optimizations
            , analyzeWarn                 || re-do free var analysis after rewrite and check for unused variables and non-exhaustive patterns
            , reifySyns                   || expand type synonyms to base types, checking for cycles
            , reifyTypes                  || expand specs and dataDefs with expanded type synonyms
            , typecheck                   || type check the module
            , streamSubst                 || do stream-based substitution of standard list-based functions
            , inline                      || do inlining of small, non-recursive functions, ast simplification
            , normalize                   || rewrite to A-Normal Form and saturate calls to known functions
            , analyze                     || final free var analysis for STG (normalization may have created new thunks)
            , reifyDefAbs                 || hide abstype implementations
            , reifyExports                || process export libParts and create export nameMap
            ]

|| build the modules in dependency order, transitively forcing rebuilds on any deserialized module which had
|| any of its import dependencies rebuilt
build :: moduleMap -> io moduleMap
build mm
    = eitherf cycleErr (io_foldM checkBuild mm) morder
      where
        depGraph = m_fmap (modImportFiles .> map fileSpecName) mm |> m_toList |> makeDependencyGraph cmpstring
        morder   = dependencyOrder cmpstring depGraph

        cycleErr cyc = showCycles cyc |> DepCycle |> ($ex_error emptyLocInfo) |> io_excpt

        showCycles cs
            = shows "module imports: " . showsCommaList showsCycle cs $ ""
              where
                showsCycle ns = showsInParens $ showsCommaList shows ns

        getComponent lns mm mn
            = m_lookup cmpstring mn mm |> fromJust |> view lns

        || force a rebuild of the modules directly dependent upon mn
        forceDepBuilds mn mm
            = foldl forceBuild mm deps
              where
                deps = edges cmpstring rev mn depGraph

                forceBuild mm n = m_adjust cmpstring (over modBuildStatus clrBuilt) n mm

                clrBuilt Built = Rebuild
                clrBuilt bs    = bs

        || check the buildStatus of mn and build or reparse and build, if required
        checkBuild mm mn
            = case getComponent modBuildStatus mm mn of
                Unbuilt -> forceDepBuilds mn mm |> ($buildModule mn)
                Rebuild -> getComponent modFile mm mn |> parseOrDeserial True >>= ins .> ($checkBuild mn)
                _       -> io_pure mm
              where
                ins m = m_insert cmpstring (view modName m) m mm

compile :: [string] -> io moduleMap
compile files
    = map fileSpecFromString files |> catMaybes |> (map mkStd stdMods ++) |> readModules >>= build
      where
        stdMods  = [stdlibModuleName, streamModuleName], if useStreamFusion
                 = [stdlibModuleName],                   otherwise
        mkStd s  = FileSpec stdlibPath s

|| generate an asm file for the module specified by "s" with entry function name "entry"
|| then compile and link it with the runtime code
gen :: fileSpec -> string -> io ()
gen fs entry
    = compile [fn] >>= genStg >>= reportInsns >>= genCode >> link >> io_pure ()
      where
        fn     = fullFileName fs
        mn     = fileSpecName fs
        qentry = Qualified mn entry
        qstart = Qualified mn "!start"
        asm    = withSuffix "s" fn
        rt     = fullFileName $ FileSpec stdlibPath runtimeName

        || generate the STG code from the module map
        genStg mm
            = putStr "generating STG code " >> io_pure (buildStg qentry genv)
              where
                m      = fromJust $ m_lookup cmpstring mn mm
                genv   = (m, mm, 0)

        || tally total insns generated to force evaluation of build before gen
        reportInsns stg
            = putStrLn (showint n ++ " STG insns") >> io_pure stg
              where
                (_, c, _) = stg
                n         = sum . map (length . snd) . m_elems . fst $ c

        || generate the asm code
        genCode stg
            = putStrLn "generating asm code" >> (writeFile asm . codegen qstart) stg

        || link with the runtime
        link = putStrLn "linking with runtime" >> systemCmd (intercalate " " [cCompilerName, ccOpts, "-o", fn, asm, rt])

main :: io ()
main
    = getArgs >>= go
      where
        go []          = err
        go (fn : args) = fileSpecFromString fn |> fromMaybef err (check args)

        check []      fs = gen fs "main"
        check [start] fs = gen fs start
        check _       fs = err

        err  = error "usage: amc <file name> {entry name}"
