|| typecheck.am -- Hindly-Milner type checker (with Milner-Mycroft typability allowing polymorphic recursion)
||
|| Milner-Mycroft polymorphic recursion allows the definition of datatypes like finger trees where a type parameter
|| can change with each recursive invocation (no monomorphic restriction)
||
|| version that uses substitution maps instead of compositions of substitution functions (O(logN) instead of O(N))
|| and applicative functors on tcSt
||
|| to do: add check for trying pass an unboxed word# to a polymorphic function, or storing one in a polymorphic data type
||        should check for trying to bind a word# in a let be moved to the let/letrec, instead of in defPat?


%export typecheck

%import <base>
%import <lens>
%import <map>           qualified as m
%import <maybe>         as mb           -pure -(>>=) -(<<) -(>>) -(<&>) -mapM -foldM
%import <maybe>         qualified as mb
%import <maybeState>    as mst
%import <set>           qualified as s
%import <state>         qualified as st
%import "ast"
%import "dependency"
%import "exception"     as ex           -pure -(>>=) -(<&>) -foldM
%import "grammar"
%import "module"
%import "name"
%import "predef"
%import "pretty"


|| a substMap is a map from a Tvar number to a texpr which substitutes for it
tvSet    == s.set int
substMap == m.map int texpr

id_subst :: substMap
id_subst = m.empty

|| apply a substitution to a Tvar number
subst :: substMap -> int -> texpr
subst sm n = m.findWithDefault cmpint (Tvar n) n sm

|| apply a substitution to a texpr
t_subst :: substMap -> texpr -> texpr
t_subst sm t
    = astRewriteTD subt t sm |> fst
      where
        subt (Tvar n) sm = (subst sm n, sm)
        subt t        sm = (t, sm)

|| find the free Tvars in a texpr
t_ftv :: texpr -> tvSet
t_ftv t
    = astAccumTD ftv t s.empty
      where
        ftv (Tvar v) s = s.insert cmpint v s
        ftv a        s = s

|| compose substitutions
subComp :: substMap -> substMap -> substMap
subComp sm sm' = sm' m.<&> t_subst sm |> m.union cmpint sm

|| normalize the Tvars used in a texpr to the lowest unique values
normalize :: texpr -> texpr
normalize t
    = astRewriteTD norm t (m.empty, 1) |> fst
      where
        norm (Tvar n) (m, gen)
            = (Tvar gen, (m.insert cmpint n gen m, gen + 1)), if isNothing mn'
            = (Tvar n', (m, gen)),                            otherwise
              where
                mn' = m.lookup cmpint n m
                n'  = fromJust mn'
        norm t s = (t, s)

|| type hole checking
isTWild, hasTypeHole :: texpr -> bool
isTWild (Tname n _) = isWildcard n
isTWild _           = False

hasTypeHole t = astAccumTD hole t False where hole t s = isTWild t \/ s


|| a type scheme has a set of schematic variables which may be freely instantiated to
|| conform with the type constraints on the various occurrences of that variable.
|| all other (non-schematic) variables in a type scheme are constrained, and must not
|| be instantiated when instantiating the type scheme
scheme ::= Forall tvSet texpr

|| make a scheme from a DefSpec or texpr
mkScheme :: texpr -> scheme
mkScheme (DefSpec tf te an) = Forall (t_ftv te) te
mkScheme te                 = Forall (t_ftv te) te

|| extract the texpr from a scheme
unScheme :: scheme -> texpr
unScheme (Forall ts te) = te

|| apply a substitution to a scheme
s_subst :: substMap -> scheme -> scheme
s_subst sm (Forall as t)
    = t_subst sm' t |> Forall as
      where
        sm' = foldr (m.delete cmpint) sm (s.toList as)  || remove the schematic variables from the substitution

|| find the free Tvars in a scheme
s_ftv :: scheme -> tvSet
s_ftv (Forall as t) = s.difference cmpint (t_ftv t) as


|| schemeMap operations

typeMap   == m.map name texpr
schemeMap == m.map name scheme

|| perform a substitution on a schemeMap
sm_subst :: substMap -> schemeMap -> schemeMap
sm_subst sm = s_subst sm |> (m.<$>)

|| find free tvars in a schemeMap
sm_ftv :: schemeMap -> tvSet
sm_ftv m = m.elems m |> map s_ftv |> foldl (s.union cmpint) s.empty


|| typeEnv operations

typeEnv == [schemeMap]  || using a lexical stack of schemeMaps, instead of merging into one large schemeMap, is faster overall

|| apply a substitution to a type environment
te_subst :: substMap -> typeEnv -> typeEnv
te_subst sm = sm_subst sm |> map

|| find free Tvars in a type environment
te_ftv :: typeEnv -> tvSet
te_ftv e = map sm_ftv e |> foldl (s.union cmpint) s.empty


|| state passed through typecheck
|| dynamic state:
|| genv:    global environment
|| schemes: schemes dynamically created from referenced type specs
|| fvars:   free variables in top level texpr of a subsume
|| errs:    exceptions collected during traversal
||
|| lexically-scoped state:
|| loc: location info from enclosing definition
|| env: lexical type environment
tcDynSt == (globalEnv, schemeMap, tvSet, [exception])
tcLexSt == (locInfo, typeEnv)
tcSt    == (tcDynSt, tcLexSt)

|| lenses for tcSt fields
tcDyn   = lensFst
tcLex   = lensSnd
tcGenv  = composeLens tcDyn  lensTup4_0
tcScms  = composeLens tcDyn  lensTup4_1
tcFvars = composeLens tcDyn  lensTup4_2
tcErrs  = composeLens tcDyn  lensTup4_3
tcLoc   = composeLens tcLex  lensFst
tcEnv   = composeLens tcLex  lensSnd
tcGen   = composeLens tcGenv lensTup3_2
tcSpecs = tcGenv $composeLens genvMod $composeLens modSpecs

initTcSt :: globalEnv -> tcSt
initTcSt genv = ((genv, m.empty, s.empty, []), (emptyLocInfo, []))

addTcNote, addTcWarn, addTcErr, attachTcNote :: exceptionInfo -> locInfo -> tcSt -> tcSt
addTcNote ei loc = lens.over tcErrs ((Note,  ei, loc) :)
addTcWarn ei loc = lens.over tcErrs ((Warn,  ei, loc) :)
addTcErr  ei loc = lens.over tcErrs ((Error, ei, loc) :)

|| attach additional info to the most recent exception, or create a new Note
attachTcNote info loc
    = lens.over tcErrs attach
      where
        attach []                          = [(Note, info, loc)]
        attach ((et, ExMult eis, el) : es) = (et, ExMult (eis ++ [info]), el) : es
        attach ((et, ei, el) : es)         = (et, ExMult [ei, info], el) : es


tcState * == maybeState tcSt *

|| alternative interface
|| note: this cannot simply be an alias to (<|>), because we need to keep the exceptions generated
|| in the primary leg and pass them to the secondary leg
(<|>) :: tcState * -> tcState * -> tcState *
ma <|> mb
    = go
      where
        go s = runState ma s |> alt
               where
                 alt (Nothing, s') = lens.set tcErrs (lens.view tcErrs s') s |> runState mb
                 alt ra            = ra

|| add an error to the state and fail with Nothing
tc_error, tc_errorNote  :: exceptionInfo -> tcState *
tc_error     ei st = (Nothing, addTcErr     ei (lens.view tcLoc st) st)
tc_errorNote ei st = (Nothing, attachTcNote ei (lens.view tcLoc st) st)

|| add a note to the state
tc_note :: exceptionInfo -> tcState ()
tc_note ei st = (Just (), addTcNote ei (lens.view tcLoc st) st)


|| lookup a scheme in the current environment
lookupEnv :: name -> typeEnv -> maybe scheme
lookupEnv n = foldr (m.lookup cmpname n .> (mb.<|>)) Nothing

|| lookup (or dynamically create) the type scheme for a name in the global environment
|| note: caching schemes in tcScms doesn't appear to speed things up (3% slower in compiling advent2021 suite) -- remove to make simpler?
lookupScheme :: name -> tcState scheme
lookupScheme n st
    = liftMaybe msl st,          if isJust msl
    = liftMaybe msd st,          if isJust msd
    = pure  scm st',             if isJust msp
    = tc_error (Undefined n) st, if isNothing mtd & isNothing mtb
    = tc_error (TypeIdent n) st, if isJust mtd & (isDefSyn def \/ isDefData def \/ isDefAbs def) \/ isJust mtb
    = tc_error (WrongType n) st, otherwise      || inferred spec for an un-spec'd defn was not installed prior
      where
        genv = lens.view tcGenv st
        msl  = lookupEnv n (lens.view tcEnv st)         || search current lexical environment
        msd  = m.lookup cmpname n (lens.view tcScms st) || search global schemes
        msp  = lookupSpec  genv n                       || lookup type spec in global environment
        scm  = mkScheme  (fromJust msp)                 || and install in the global schemes, if found
        mtd  = lookupDefn genv n                        || lookup defn in global environment
        def  = fromJust mtd
        mtb  = m.lookup cmpname (unqualifyName n) builtinEnv
        st'  = lens.over tcScms (m.insert cmpname n scm) st


|| type inference

|| generate a new Tvar number from the state
newTvar :: tcState texpr
newTvar = mst.view tcGen <&> Tvar << mst.over tcGen (+ 1)

|| create a new instance of a type scheme by creating new Tvars for the schematic vars
instantiate :: scheme -> tcState (texpr, substMap)
instantiate (Forall as t)
    = mapM (const newTvar) asl >>= mkSm
      where
        asl = s.toList as
        mkSm asl'
            = pure (t_subst sm t, id_subst)
              where
                sm = zip2 asl asl' |> m.fromList cmpint

|| generalize a texpr to a scheme
generalize :: typeEnv -> texpr -> scheme
generalize env t
    = Forall as t
      where
        as = s.difference cmpint (t_ftv t) (te_ftv env)


|| perform an inference in a new lexical environment, restoring the environment afterwards
|| note: inference may result in an exception, so explicitly manipulate the state rather than
|| use mst_ applicatives so that we guarantee the lex state is restored
inLexEnv :: schemeMap -> (* -> tcState **) -> * -> tcState **
inLexEnv env action e st
    = (r, lens.set tcLex lex st')
      where
        lex      = lens.view tcLex st
        (r, st') = st |> lens.over tcEnv (env :) |> action e

|| capture and restore the lexical state around an inference
lexMono, lexPoly :: typeMap -> (* -> tcState **) -> * -> tcState **

|| lexMono uses monomorphic bindings for the new environment frame
lexMono tmap inf e
    = inLexEnv smap inf e
      where
        smap = tmap m.<&> Forall s.empty

|| lexPoly uses polymorphic bindings for the new environment frame
lexPoly tmap inf e
    = mst.view tcEnv >>= f
      where
        f env
            = inLexEnv smap inf e
              where
                smap = tmap m.<&> generalize env


|| generate a typeMap of new Tvars from a defnMap
genTypeMap :: defnMap -> tcState typeMap
genTypeMap dm
    = mapM (const newTvar) ds <&> mkMap
      where
        (ks, ds) = m.toList dm |> unzip2
        mkMap    = zip2 ks .> m.fromList cmpname

|| make a typeMap from a list of patterns and corresponding texprs
|| filter out any non-Pvar (wildcard) patterns from the typeMap
mkTypeMap :: [pat] -> [texpr] -> typeMap
mkTypeMap ps ts = zip2 ps ts |> filter (fst .> isPvar) |> map (mapFst unPvar) |> m.fromList cmpname

|| extract the types of the pats from the defn's DefSpec, if available
|| this allows a form of bidirectional type checking where the user-defined top-level DefSpec
|| is preferred to the typechecker's inferred type, which makes error reporting more precise.
|| If no spec is found, or has fewer types than the number of vars, return new Tvars for the
|| vars without types.
typesFromSpec :: name -> [pat] -> tcState [texpr]
typesFromSpec n vars
    = (mst.view tcGenv >>= getSpec <|> pure []) >>= addMissing
      where
        nvars         = #vars
        getSpec genv  = lookupSpec genv n |> fromMaybef fail genScm         || find the typeSpec for a name
        genScm s      = mkScheme s |> instantiate >>= genTs                     || generate a new scheme from the spec
        genTs (s, _)  = typeList s |> fst |> take nvars |> pure             || collect the individual var types
        addMissing ts = mapM (const newTvar) [1 .. nvars - #ts] <&> (ts ++) ||  if spec is missing or has fewer types, pad with newTvars

|| report extra info when an error is encountered in mutual recursive definitions
mutRecErr :: [name] -> tcState *
mutRecErr ns
    = fail,              if #ns < 2    || don't add additional note if just a single (self-recursive) name
    = tc_errorNote info, otherwise
      where
        info = Info . shows "in mutually-recursive definition of " . showsCommaList showsExName ns $ ""


|| builtin type testing
isTypeWord, isTypePairWord, isTypeFnPair :: texpr -> bool

isTypeWord t = _eq cmptexpr t builtinTypeWord

isTypePairWord (Ttuple [a, b]) = isTypeWord a & isTypeWord b
isTypePairWord _               = False

isTypeFnPair (Ttuple [_, _] $Tarr _) = True
isTypeFnPair _                       = False


|| infer the type of an expr and return the inferred type and a substitution map, or report an error
|| note: infer performs an AST traversal, but we can't use the traversals provided in ast, because
|| typecheck uses a maybeState instead of just state.  Also, we aren't rewriting the ast, but we are
|| returning a value (rather than just the state value from accum), and we have to explicitly write
|| an infer for each different AST node, anyway.  So a custom traversal scheme is used, here
infer :: expr -> tcState (texpr, substMap)
infer (Eint n)        = pure (stdInt, id_subst)
infer (Echar c)       = pure (stdChar, id_subst)
infer (Estring s)     = pure (Tlist stdChar, id_subst)
infer (EprimInt n)    = pure (builtinTypeWord, id_subst)
infer (EprimChar c)   = pure (builtinTypeWord, id_subst)
infer (EprimString s) = pure (builtinTypeWord, id_subst)
infer (Evar n)        = lookupScheme n >>= instantiate

|| handle polymorphic pseudo-functions pack and sel
|| the constructor name to use for the function is passed as the first argument
infer (Tname n vars)
    = bind2 (mst.view tcEnv) (lookupScheme cn) f        || lookup the scheme for the constructor
      where
        (Tname cn []) = vars ! 0                        || constructor passed as first argument
        (EprimInt i)  = vars ! 1                        || index passed as second argument
        f env s
            = instantiate s'
              where
                (tl, bt) = unScheme s |> typeList       || the type components of the Ctor type (separated by Tarr)
                nt       = tl ! i                       || the type of the nth constructor argument
                s'       = generalize env (bt $Tarr nt), if _eq cmpname n builtinSelName
                         = s,                            otherwise

infer (Eap e1 e2)
    = bind2 newTvar (inferList [e1, e2]) f1
      where
        f1 tv ([t1, t2], sm) = unify t1 (t2 $Tarr tv) sm >>= f2 tv         || t1 == t2 -> *
        f1 _  _              = unreachable

        f2 tv sm             = pure (t_subst sm tv, sm)

infer (Ecall e args)
    = bind2 newTvar (inferList (e : args)) f1
      where
        f1 tv ((t : ts), sm) = (unify t (foldr Tarr tv ts) sm) <&> f2 tv  <|> err       || te = (t0 -> ... tn -> tv)
        f1 _  _              = unreachable

        f2 tv sm             = (t_subst sm tv, sm)
        err                  = Info ("in application of " ++ showAst e) |> tc_errorNote

infer (Ecase _ e alts an)
    = bind2 newTvar (inferList (e : alts)) f1
      where
        f1 tv ((t : ts), sm)
            = foldM unifyPairWord sm ts >>= f2 tv <|> err, if isTypePairWord t  || special case restriction for builtins returning a pair of words
            = foldM unifyAlt      sm ts >>= f2 tv <|> err, otherwise            || unify type of all alts to common type te -> *
              where
                t2t'          = t $Tarr tv
                err           = Info "case alternate types don't match" |> tc_errorNote
                unifyAlt sm t = unify t t2t' sm

                || caseAlts restricted to pair constructor patterns
                unifyPairWord sm t = unify t t2t' sm,     if isTypeFnPair t
                                   = tc_error NotPairPat, otherwise

        f1 _ _ = unreachable

        f2 tv sm = pure (t_subst sm tv, sm)

infer (CaseAlt (Pctor n vars) e an)
    = infer (Evar n) >>= f1     || infer the type of the constructor
      where
        f1 (spec, sm)
            = tc_error (CtorArity n),              if #vars ~= #ts || ctor patterns must be saturated
            = lexMono tdefs infer e >>= f2 bt sm, otherwise        || infer e in new monomorphic environment of arg types
              where
                (ts, bt) = typeList spec
                tdefs    = mkTypeMap vars ts

        f2 bt sm (t, sm') = pure (bt $Tarr t, subComp sm' sm)  || type of CaseAlt is base type of constructor -> te

infer (CaseAlt (Pvar n) e an)
    = newTvar >>= f1
      where
        f1 tv         = lexMono (m.singleton n tv) infer e >>= f2 tv
        f2 tv (t, sm) = pure (tv $Tarr t, sm)

infer (CaseAlt (Plit e1) e2 an)
    = inferList [e1, e2] >>= f1
      where
        f1 ([t1, t2], sm) = pure (t1 $Tarr t2, sm)
        f1 _              = unreachable

infer (CaseAlt Pwildcard e an)
    = bind2 newTvar (infer e) f
      where
         f tv (t, sm) = pure (tv $Tarr t, sm)       || inferred type is * -> t

|| Efatbar and Efail form a control scheme, with an Efail acting like a
|| non-local control transfer to the right branch of the enclosing Efatbar
|| It might be more correct to capture the right branch type scheme of an Efatbar (like in an Elet),
|| and then look it up for an Efail (like an Evar reference).  However, it works just to create
|| a new Tvar for its type and let inference figure it out
infer (Efail e)
    = newTvar >>= f
      where
        f tv = pure (tv, id_subst)                  || let inference figure out the result type

infer (Efatbar p e1 e2)
    = bind2 newTvar (inferList [e1, e2]) f1
      where
        f1 tv (ts, sm)
            = foldM unify' sm ts >>= f2 tv <|> err  || unify types of e1 and e2 to a common type *
              where
                unify' sm t = unify t tv sm
                err         = Info "function types don't match in function with multiple definitions" |> tc_errorNote

        f2 tv sm = pure (t_subst sm tv, sm)

|| non-recursive Let
infer (Elet False defs _ e)
    = inferMap defs >>= f1         || infer defs in defnMap
      where
        f1 (ts, sm)     = lexPoly ts infer e >>= f2 sm     || infer e in new polymorphic environment of def types
        f2 sm  (t, sm') = pure (t, subComp sm' sm)

|| recursive Let
infer (Elet True defs _ e)
    = genTypeMap defs >>= f1                       || generate a fresh Tvar for each of the defs
      where
        f1 ts1
            = lexMono ts1 inferMap defs >>= f2     || infer def types monomorphically
              where
                f2 (ts2, sm) = (unifyMaps Infer ts1 ts2 sm >>= f3 ts2) <|> mutRecErr (m.keys defs)

                f3 ts2 sm1
                    = mst.over tcEnv (te_subst sm1) >>
                      lexPoly ts2' infer e          >>=
                      f4 sm1
                      where
                        ts2' = ts2 m.<&> t_subst sm1

                f4 sm1 (t, sm2)  = pure (t, subComp sm2 sm1)

|| infer defns
infer d
    = inLexEnv m.empty locInfer d
      where
        loc        = defnLocInfo d
        locInfer d = mst.over tcLoc (mergeLocInfo loc) >> inferDef d

        inferDef (DefFn n vars e an)
            = typesFromSpec n vars >>= f1       || preferably use types from type spec, or infer with new Tvars
              where
                f1 ts = lexMono tdefs infer e >>= f2 ts || infer the type of the body in a new mono environment
                        where
                          tdefs = mkTypeMap vars ts

                f2 ts (t, sm) = pure (foldr (Tarr . t_subst sm) t ts, sm)   || final type is ts0 -> .. t

        inferDef (DefPat p e an)
            = infer e >>= f
              where
                f (t, sm) = tc_error UnboxedPat, if _eq cmptexpr t builtinTypeWord
                          = pure (t, sm),        otherwise

        inferDef d = defnName d |> TypeIdent |> tc_error

|| infer a (possibly mutually-recursive group) of definitions in a type environment
inferDefs :: [defn] -> tcState [texpr]
inferDefs defs
    = mst.view tcGenv >>= f
      where
        ndefs = #defs
        ns    = map defnName defs
        def   = hd defs
        rec   = lens.view astAnnoRec def

        || infer a single defn normally, if it isn't recursive or it has an existing spec
        || otherwise, infer the definition(s) monomorphically as a recursive group
        f genv = infer def >>= wrapSingle,                   if ndefs == 1 & (~rec \/ hasSpec)
               = mapM (const newTvar) defs >>= inferDefsRec, otherwise
                 where
                   hasSpec              = defnName def |> lookupSpec genv |> isJust     || polymorphic recursive fn (Milner-Mycroft Calculus)
                   wrapSingle (tdef, x) = pure [tdef]

        inferDefsRec ts1
            = lexMono tm1 inferList defs >>= f2
              where
                tm1          = zip2 ns ts1 |> m.fromList cmpname
                f2 (ts2, sm) = (unifyLists Infer ts1 ts2 sm >>= f3 ts2) <|> mutRecErr ns
                f3 ts2 sm'   = map (t_subst sm') ts2 |> pure

|| note: this cannot be performed with a mapM, because it is bidirectional:
|| going forward, the phi's are computed for each expr and the environment schemes are
|| updated with them, so that the types of subsequent exprs are infered with those prior
|| constraints.  Then going backward, each prior inferred type has the subsequent phi's
|| folded into their type, to get the fixpoint for the constraints.
|| it could be performed with a right-fold version of foldM, but that wouldn't be simpler than this.
inferList :: [expr] -> tcState ([texpr], substMap)
inferList [] = pure ([], id_subst)
inferList (e : es)
    = infer e >>= f1
      where
        f1 (t, sm)        = mst.over tcEnv (te_subst sm) >> (inferList es >>= f2 t sm)
        f2 t sm (ts, sm') = pure (t_subst sm' t : ts, subComp sm' sm)

inferMap :: defnMap -> tcState (typeMap, substMap)
inferMap dm
    = inferList defs >>= f
      where
        (ks, defs) = m.toList dm |> unzip2
        f (ts, sm) = pure (m.fromList cmpname (zip2 ks ts), sm)


|| type unification

|| unification can either be for inference, or checking that the inferred type subsumes the specified type
unifyMode ::= Infer | Check

|| extend a substMap  with a substitution, possibly reporting an error
|| if unifyMode is Check, check for an Occurs error against the free variables
|| of the original second type, which have been saved in the tcSt
extend :: unifyMode -> substMap -> int -> texpr -> tcState substMap
extend um sm tvn t
    = mst.view tcFvars >>= f
      where
        f oFvars
            = pure sm,               if _eq cmptexpr t tv                   || no extension for equal texprs
            = tc_error (Occurs tvn' t'), if s.member cmpint tvn $ fvars um  || tvn occurs in free vars of t, which implies an infinite type
            = pure  extended,        otherwise                              || extend sm with tvn ~ t
              where
                sm'         = m.singleton tvn t
                mapped      = sm m.<&> t_subst sm'
                extended    = m.union cmpint mapped sm'
                tv          = Tvar tvn
                Tarr tv' t' = Tarr tv t |> normalize
                Tvar tvn'   = tv'

                fvars Infer = t_ftv t
                fvars Check = oFvars

|| unify two texprs by possibly extending the substitution, or report an error
|| tcSt is passed in to provide info for error reporting, but is unmodified
unify' :: unifyMode -> texpr -> texpr -> substMap -> tcState substMap
unify' um t1 t2 sm
    = go t1 t2
      where
        go (Tvar tvn)    t2            = go t1' t2',           if m.member cmpint tvn sm        || unify
                                       = extend um sm tvn t2', otherwise                        || extend
                                           where
                                             t1' = subst sm tvn
                                             t2' = t_subst sm t2
        go t1            (Tvar tvn)    = go (Tvar tvn) t1,       if _eq cmpunifyMode um Infer   || Infer is bidirectional; Check is one-sided
        go (Tname n1 ta) (Tname n2 tb) = unifyLists um ta tb sm, if _eq cmpname n1 n2 & #ta == #tb
        go (Ttuple ta)   (Ttuple tb)   = unifyLists um ta tb sm, if #ta == #tb
        go (Tlist ta)    (Tlist tb)    = go ta tb
        go (Tarr ta tb)  (Tarr tc td)  = unifyLists um [ta, tb] [tc, td] sm
        go (Tstrict ta)  (Tstrict tb)  = go ta tb
        go t1            t2            = tc_note (TypeHole nt2) >> pure sm, if isTWild t1
                                       = tc_note (TypeHole nt1) >> pure sm, if isTWild t2
                                       = tc_error $ Unify nt1 nt2,          otherwise
                                         where
                                           nt1 = normalize t1
                                           nt2 = normalize t2

|| unify a pair of texpr lists
unifyLists :: unifyMode -> [texpr] -> [texpr] -> substMap -> tcState substMap
unifyLists um ts1 ts2 sm
    = zip2 ts1 ts2 |> foldM unifyPair sm
      where
        unifyPair sm (t1, t2) = unify' um t1 t2 sm

|| unify a pair of texpr maps
unifyMaps :: unifyMode -> typeMap -> typeMap -> substMap -> tcState substMap
unifyMaps um ts1 ts2 sm
    = unifyLists um (m.elems ts1) (m.elems ts2) sm

unify :: texpr -> texpr -> substMap -> tcState substMap
unify t1 t2 sm
    = unify' Infer t1 t2 sm <|>
      tc_errorNote (Unify (normalize t1) (normalize t2))    || add additional error info for the top-level unification types

subsumes :: texpr -> texpr -> substMap -> tcState substMap
subsumes t1 t2 sm
    = mst.set tcFvars (t_ftv t2) >>
      (unify' Check t1 t2 sm <|>
      tc_errorNote (Unify (normalize t1) (normalize t2)))   || add additional error info for the top-level unification types


|| typecheck a group of mutually-recursive definitions (singleton if not recursive)
|| and validate existing specs or install new specs
|| note: some trickiness in typing used, here -- final return type is tcState (), because failures can occur
||       in inferDefs, which will return Nothing.  If they return a list of types to matchSpecs, then matchSpecs
||       runs matchOrAdd in an st monad (rather than a tc monad) to collect info from
||       all type results, rather than short-circuiting on the first failure from subsumes, then wraps the result
||       state with a pure (), to match the final return type
typecheckGroup :: [name] -> tcState ()
typecheckGroup ns
    = mst.view tcGenv >>= f
      where
        f genv
            = inferDefs defs >>= matchSpecs
              where
                defs          = map (fromJust . lookupDefn genv) ns     || guaranteed to exist
                matchSpecs ts = pure () st.<< st.mapM_ matchOrAdd (zip2 ns ts)

        matchOrAdd (n, t)
            = mst.view tcGenv >>= f
              where
                f genv
                  = installSpec,                                         if isNothing mspec   || install the inferred spec if not specified
                  = inLexEnv m.empty locSubsumes id_subst st.>>= verify, otherwise            || verify inferred against specified type
                    where
                      mspec          = lookupSpec genv n
                      spec           = fromJust mspec
                      DefSpec _ t' _ = spec
                      normt          = normalize t
                      spec'          = DefSpec (Tname n []) normt (genvAnno genv)
                      loc            = defnLocInfo spec

                      verify Nothing = typeSpecError
                      verify _       = installSpec, if hasTypeHole spec || install the inferred spec, if the spec matches but has a type hole
                                     = pure (),     otherwise

                      installSpec    = mst.over tcSpecs (m.insert cmpname n spec')
                      typeSpecError  = mst.over tcErrs ((Error, TypeSpec spec spec', loc) :)
                      locSubsumes sm = mst.over tcLoc (mergeLocInfo loc) st.>> subsumes t t' sm


|| divide top-level definitions into mutually-recursive groups and typecheck each
|| group in dependency-order
typecheck :: globalEnv -> excpt globalEnv
typecheck genv
    = ex.return genv' warns, if null errs
    = ex.errs   errs,        otherwise
      where
        m              = lens.view genvMod genv
        defs           = m.filter cmpname isDefFnPat (lens.view modDefns m)
        specs          = m.elems (lens.view modSpecs m)
        st             = foldr addNoDefWarn (initTcSt genv) (filter noDef specs)
        deps           = makeDefnDependencyList defs
        sccs           = makeDependencyGraph cmpname deps |> findSCCs cmpname
        st'            = st.mapM_ typecheckGroup sccs st  |> snd        || note: st.mapM_ to run typecheck on all groups
        genv'          = lens.view tcGenv st'
        (errs, warns)  = partition isError (lens.view tcErrs st')

        noDef d        = ~m.member cmpname (defnName d) defs
        addNoDefWarn d = addTcWarn (SpecNoDef (defnName d)) (locOnlyInfo (lens.view astAnnoLoc d))
