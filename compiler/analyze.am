|| analyze.am -- performs the following analyses to annotate definitions:
||
||    * free-variable analysis for closure creation, recursive determination, etc.
||    * complexity analysis for inlining heuristics
||    * use analysis for error reporting, dead-code elimination, and no-update thunk optimization
||
|| use analysis is exact for reporting unused (Uzero) Let-bound Defs
|| use analysis is conservative (no false positives, possible false negatives) for reporting affine
|| (Uzero or Uone) uses of Let-bound DefPats (thunks)


%export analyze analyzeWarn analyzeDefns analyzeExprCpx analyzeExprFree

%import <base>
%import <bitSet>
%import <lens>
%import <map>
%import <maybe>                 (<|>)/mb_alt
%import <maybe> qualified as mb (<&>)/mb_rfmap
%import <state>                 (>>=)/st_bind (<&>)/st_rfmap (<<)/st_left (>>)/st_right
%import "ast"
%import "exception"
%import "grammar"
%import "module"
%import "name"
%import "predef"

affineMap  == m_map name bitSet
useInfoMap == m_map name useInfo

appendUseInfo :: useInfo -> useInfo -> useInfo
appendUseInfo Uone Uone = Umany                         || two single uses add to Umany
appendUseInfo ua   ub   = max2 cmpuseInfo ua ub         || all others add to max of the two

|| merge useInfo maps using merge function
mergeUsesWith :: (useInfo -> useInfo -> useInfo) -> useInfoMap -> useInfoMap -> useInfoMap
mergeUsesWith f ma mb
    = m_toList mb |> foldl mergeEntry ma
      where
        mergeEntry m (k, v) = m_insertWith cmpname f k v m


|| state passed through analyze:
|| dynamic state:
|| Note:      the name keys in uses are lexically-managed, but the use-counts need to be cumulative within overall scopes, so "uses"
||            must be dynamic state instead of automatically-managed lexical state
|| genv:      globalEnv
|| errs:      exceptions collected during traversal
|| uses:      useInfo for in-scope variable names, which will used to determine free variables and use counts of defns
|| affine:    map from name to affine use bitSet for defn
|| cpx:       ast complexity
||
|| lexically-scoped state:
|| loc:       location info from enclosing definitions
|| defName:   defn name of enclosing defn (can't use top of loc name stack, since it ignores defn names beginning with "`")

azDynSt   == (globalEnv, [exception], useInfoMap, affineMap, int)
azLexSt   == (locInfo, maybe name)
azSt      == (azDynSt, azLexSt)

|| lenses for azSt fields
azDyn       = lensFst
azLex       = lensSnd
azGenv      = composeLens azDyn lensTup5_0
azErrs      = composeLens azDyn lensTup5_1
azUses      = composeLens azDyn lensTup5_2
azAffine    = composeLens azDyn lensTup5_3
azCpx       = composeLens azDyn lensTup5_4
azLoc       = composeLens azLex lensFst
azDefName   = composeLens azLex lensSnd
azDefnPath  = composeLens azLoc locInfoDefnPath

initAzSt :: globalEnv -> azSt
initAzSt genv = ((genv, [], m_empty, m_empty, 0), (emptyLocInfo, Nothing))

addAzWarn :: exceptionInfo -> state azSt ()
addAzWarn ei = st_view azLoc >>= \loc -> st_over azErrs ((Warn, ei, loc) :)

|| check name for match with stdCaseFail to report non-exhaustive patterns in function definition
checkFail :: name -> state azSt ()
checkFail n
    = addAzWarn NonExhaustive, if _eq cmpname n stdCaseFailName
    = st_pure (),              otherwise

clrUses, clrCpxUses :: state azSt ()
clrUses    = st_set azUses m_empty
clrCpxUses = st_set azCpx 0 >> st_set azUses m_empty

incCpx :: state azSt ()
incCpx = st_over azCpx (+ 1)

addUse :: name -> useInfo -> state azSt ()
addUse n u = st_over azUses (m_insertWith cmpname appendUseInfo n u)

|| add a Tname use to the useInfoMap
|| required for detecting dependency cycles in type synonyms
addTUse :: name -> state azSt ()
addTUse n
    = st_pure (),    if isConstructor n || ignore ctors encoded as Tname for builtinPack, builtinSel
    = addUse n Uone, otherwise

|| delete a list of names from the one of the maps in the anno (to remove variable
|| names after they go out of scope). Note that this can be done by deleting keys,
|| since renaming has guaranteed that all names are now unique, so we can keep them
|| in a single map, rather than lexically scope them
delNames :: lens azSt (m_map name *) -> [name] -> state azSt ()
delNames lns ns
    = st_over lns delNames
      where
        delNames m  = foldl delName m ns
        delName m n = m_delete cmpname n m

|| remove any uses of locally-bound Pvars for the ast when going out of scope
removeLocalUses :: ast -> state azSt ()
removeLocalUses a
    = getPatNames a |> delNames azUses
      where
        getPatNames (Efatbar p _ _)    = patNames p
        getPatNames (CaseAlt p _ _)    = patNames p
        getPatNames (Qgen pats _)      = concatMap patNames pats
        getPatNames (Qrecur p _ _)     = patNames p
        getPatNames (Pctor _ pats)     = concatMap patNames pats
        getPatNames (DefFn _ pats _ _) = concatMap patNames pats
        getPatNames _                  = []

lookupAffineInfo :: expr -> state azSt bitSet
lookupAffineInfo (Evar n)
    = st_liftA2 getInfo (st_view azAffine) (st_view azGenv)
      where
        getInfo am genv
            = fromMaybe bs_empty check
              where
                check = Nothing,        if isConstructor n      || ctors don't use any args, but escape all of them, so mark as all non-affine
                      = checkBuiltin,   if isBuiltin n
                      = checkAffineMap, otherwise

                checkAffineMap = m_lookup cmpname n am <|> lookupDefn genv n mb.<&> view astAnnoAffine
                checkBuiltin   = lookupArity genv n mb.<&> checkOp (getName n)

                || builtins are Uone in all arguments except for array write operations,
                || which are Umany in their last argument
                checkOp ns aty
                    = bs_all (aty - 1), if ns ==$ "writeArray#" \/ ns ==$ "fillArray#"
                    = bs_all aty,       otherwise

|| handle affineInfo for builtinSel and builtinPack
lookupAffineInfo (Tname n args)
    = st_pure $ bs_singleton 0, if _eq cmpname n builtinSelName || builtinSel uses its source arg once
    = st_pure $ bs_empty,       otherwise                       || builtinPack doesn't use any of its args, but is only used in ctors, which
                                                                || escape all the args, so just mark as all non-affine
lookupAffineInfo _ = st_pure bs_empty


analyzeAst :: astRewriteTraverser azSt

analyzeAst k (Evar n)
    = addUse n Uone >> checkFail n >> incCpx >> st_pure (Evar n)

analyzeAst k (Tname n args)
    = addTUse n >> incCpx >> k (Tname n args)

|| an Ecase strictly evaluates its scrutinee expr, but will only evaluate one of the alts. Compute useInfo
|| by analyzing alts separately, then merging to find max use
analyzeAst k (Ecase cs e alts an)
    = st_bind4 (st_view azCpx) (st_view azUses) (analyzeSingle e) (st_mapM analyzeAlt alts) updateCase
      where
        analyzeSingle a = st_liftA3 triple (clrCpxUses >> astRewriteLex analyzeAst a) (st_view azCpx) (st_view azUses)
        analyzeAlt    a = analyzeSingle a <&> updateAlt

        updateAlt (a, c, u) = (set astAnnoCpx c a |> set astAnnoFree (m_keys u), c, u)

        updateCase inCpx inUses (e', eCpx, eUse) altCpxUses
            = st_set azCpx cpx >> st_set azUses uses >> st_pure (Ecase cs e' alts' an')
              where
                (alts', altCpxs, altUses) = unzip3 altCpxUses

                maxUses  = foldl1 (mergeUsesWith (max2 cmpuseInfo)) altUses
                caseCpx  = eCpx + sum altCpxs + 1
                caseUses = mergeUsesWith appendUseInfo maxUses eUse
                an'      = set annoCpx caseCpx an |> set annoFree (m_keys caseUses)
                cpx      = inCpx + caseCpx
                uses     = mergeUsesWith appendUseInfo inUses caseUses

analyzeAst k a
    = setLexInfo >> analyzeDefn,          if isDefn a
    = k a >>= updateCall,                 if isCall a
    = k a >>= updateLet,                  if isLet  a
    = k a << removeLocalUses a << incCpx, otherwise
      where
        || capture incoming cpx and uses to pass to updateDefn, then clearCpxUses and analyze def
        setLexInfo  = st_set azDefName (Just $ defnName a) >> st_set azLoc (defnLocInfo a)
        analyzeDefn = st_bind3 (st_view azCpx) (st_view azUses) (clrCpxUses >> checkTdef k a) updateDefn

|| type defns should not have their defn Tforms analyzed, as we can't tell defining Tnames vs used Tnames as with Pvar vs Evar
checkTdef k (DefSyn  tf te an)    = astRewriteLex analyzeAst te           <&> \te' -> DefSyn tf te' an
checkTdef k (DefData tf ts an)    = st_mapM (astRewriteLex analyzeAst) ts <&> \ts' -> DefData tf ts' an
checkTdef k (DefSpec tf te an)    = astRewriteLex analyzeAst te           <&> \te' -> DefSpec tf te' an
checkTdef k (DefAbs  tf ds te an) = astRewriteLex analyzeAst te           <&> \te' -> DefAbs tf ds te' an
checkTdef k a                     = k a || analyze full defn for non-type defns

|| update rec, cpx, free, and affineUse fields in astAnno, and merge inCpx and inUses
updateDefn :: int -> useInfoMap -> defn -> state azSt defn
updateDefn inCpx inUses d
    = st_bind3 (st_view azCpx) (st_view azUses) (removeLocalUses d >> st_view azUses) updateAnno
      where
        updateAnno cpx uses free
            = st_set azCpx (inCpx + cpx + 1)                           >>
              st_set azUses (mergeUsesWith appendUseInfo inUses free') >>
              st_over azAffine (m_insert cmpname n aff)                >> st_pure d'
              where
                n   = defnName d
                fvn = fnVars d |> concatMap patNames
                fvu = map (\n -> m_findWithDefault cmpname Uzero n uses) fvn
                aff = enumerate fvu |> filter (snd .> usedAffine) |> map fst |> bs_fromList
                rec = m_member cmpname n free
                d'  = set astAnno (view astAnnoLoc d, rec \/ view astAnnoRec d, cpx, Umany, m_keys free', aff) d

                free' = m_fmap (const Umany) free |> adjustForFn, if rec                || recursive defs capture all free vars
                      = free,                                     otherwise

                adjustForFn = m_insert cmpname n Uzero, if isDefFn d    || count defn as Uzero for use in DefFn
                            = id,                       otherwise       || count defn as Umany for DefPat

|| check to see if Evar arguments passed to a function are usedAffine by the function,
|| and adjust the useInfoMap accordingly
updateCall :: expr -> state azSt expr
updateCall (Ecall f args)
    = lookupAffineInfo f >>= \ai ->
      enumerate args |> st_mapM_ (checkAffine ai) >> incCpx >> st_pure (Ecall f args)
      where
        checkAffine ai (i, (Evar n))
            = st_over azUses (m_insertWith cmpname (max2 cmpuseInfo) n use)
              where
                use = if' (bs_member i ai) Uone Umany

        checkAffine ai _ = st_pure ()

updateCall _ = unreachable

|| update the astAnno useInfo field for each of the defns in the Elet's defnMap
|| if the expression e is an Evar, mark all the names that can escape as Umany
updateLet :: expr -> state azSt expr
updateLet (Elet rec defs pats e)
    = st_view azUses >>= addEscapes .> \ui ->
      astRewriteMap (checkUpdate ui) defs >>= \defs' ->
      st_set azUses ui >> delNames azUses ns >> delNames azAffine ns >> incCpx >> st_pure (Elet rec defs' pats e)
      where
        ns     = m_keys defs
        single = m_isSingleton defs    || multiple defs in a Let are mutually-recursive

        addEscapes m   = computeEscapes defs e |> foldl setUseMany m
        setUseMany m n = m_insert cmpname n Umany m

        computeEscapes defs (Evar n)
            = m_lookup cmpname n defs |> fromMaybef [] captured
              where
                captured d = n : view astAnnoFree d
        computeEscapes _ _ = []

        checkUpdate ui d
            = addAzWarn (Unused n) >> update, if usedZero u & isInternal n
            = update,                         otherwise
              where
                n      = defnName d
                u      = if' single (m_findWithDefault cmpname Uzero n ui) Umany
                update = set astAnnoUse u d |> st_pure

updateLet _ = unreachable


|| internal version of analyze, used by analyze and analyzeWarn
|| tally complexity, free variables, and use counts for each defn and update their annos
analyze' :: globalEnv -> (globalEnv, azSt)
analyze' genv
    = (genv', st)
      where
        m           = view genvMod genv
        defs        = view modDefns m
        (defs', st) = astRewriteMap (astRewriteLex analyzeAst) defs $ initAzSt genv
        genv'       = over genvMod (set modDefns defs') genv

|| run analysis, and report any unused variable and non-exhaustive pattern warnings
analyzeWarn :: globalEnv -> excpt globalEnv
analyzeWarn genv
    = ex_return genv' warns, if null errs
    = ex_errs errs,          otherwise
      where
        (genv', st)   = analyze' genv
        (errs, warns) = view azErrs st |> partition isError

|| run analysis, ignoring any unused variable warnings
analyze :: globalEnv -> excpt globalEnv
analyze genv
    = ex_return genv' []
      where
        genv' = analyze' genv |> fst

|| run analysis on a defnMap, but don't return any exceptions
analyzeDefns :: defnMap -> globalEnv -> defnMap
analyzeDefns defs genv
    = st_evalState (astRewriteMap (astRewriteLex analyzeAst) defs) $ initAzSt genv

|| run analysis on a single expr, collecting only the cpx info
analyzeExprCpx :: expr -> globalEnv -> int
analyzeExprCpx e genv
    = st_execState (astRewriteLex analyzeAst e) (initAzSt genv) |> view azCpx

|| run analysis on a single expr, collecting only the free variable info
analyzeExprFree :: expr -> globalEnv -> [name]
analyzeExprFree e genv
    = st_execState (astRewriteLex analyzeAst e) (initAzSt genv) |> view azUses |> m_keys
