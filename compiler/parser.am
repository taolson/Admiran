|| parser.am -- basic parser combinators for a stream of tokens with locations, based upon the maybeState monad
||
|| note: many parser function names shadow stdlib names, so parser should always be imported qualified


%export + get put modify pure fail (>>=) (<$>) (<&>) (<*>) (<<) (>>) liftA2 liftA3 liftA4 bind2 mapM foldM runState

%import <base>
%import <lens>
%import <maybe>                 -(>>=) -(<$>) -(<&>) -(<*>) -(<<) -(>>) -pure -liftA2 -mapM -foldM
%import <maybeState>            -view -set -over
%import <stdlib>        as std
%import "name"
%import "tokenizer"     as tok


|| Basic Parsing

psError == (string, int, int, int)              || err string, severity, line#, col#

|| custom comparison of psError that only looks at severity, line, and col
|| used to choose the parse state with the deepest error in a (<|>)
cmppsError :: ordI psError
cmppsError (_, s1, l1, c1) (_, s2, l2, c2)
    = cmpint s1 s2 $thenCmp cmpint l1 l2 $thenCmp cmpint c1 c2

emptyError :: psError
emptyError  =  ("", 0, 0, 0)

|| state passed through the various parsers
psSt    == (string, psError, [int], [tokloc])   || module name, deepest parse error, indent-level stack, stream of tokens and locations

|| lenses for psSt fields
psModName = lensTup4_0
psErr     = lensTup4_1
psErrStr  = composeLens lensTup4_1 lensTup4_0
psErrSev  = composeLens lensTup4_1 lensTup4_1
psErrLn   = composeLens lensTup4_1 lensTup4_2
psErrCn   = composeLens lensTup4_1 lensTup4_3
psIndLev  = lensTup4_2
psToks    = lensTup4_3

parser * == maybeState psSt *


|| parser error handling

|| report an error with a specified severity level and error string
|| the idea here is that in the case of multiple errors down different parse paths,
|| the most likely intended parse is either the one where we made unambiguous progress
|| (severity 2 from a expected parse), or the one where we've made the most progress
|| (higher line/char index)
error :: int -> string -> parser *
error sv es ps
    = (Nothing, ps')
      where
        (_, il, ic) = hd $ view psToks ps
        ps'         = over psErr (max2 cmppsError (es, sv, il, ic)) ps

|| add more info to the existing error, with severity 2 to indicate that
|| this error should have higher precedence than a regular error
errorInfo :: string -> parser *
errorInfo es ps
    = (Nothing, ps')
      where
        sv  = view psErrSev ps
        ps' = over psErrStr (es ++) . set psErrSev 2 $ ps, if sv < 2
            = ps,                                          otherwise

|| show the current token, or a string indicating an exception condition
|| (end of input, offside)
showCurrentToken :: parser string
showCurrentToken
    = get >>= go
      where
        go ps
            = pure "end of input", if isTend t
            = pure "OFFSIDE",      if _eq cmptoken t Toffside \/ offside
            = pure $ showtoken t,  otherwise
              where
                ls          = view psIndLev ps
                (t, _, ic)  = hd $ view psToks ps
                offside     = ~null ls & (isTend t \/ ic < hd ls)

|| report an error that we expected something that wasn't there
|| uses higher severity than unexpected so that it has priority with multiple errors
expected :: string -> parser *
expected s  = errorInfo ("expected " ++ s ++ ", but got ")

|| report an error that we got an unexpected token
unexpected :: parser *
unexpected = showCurrentToken >>= ("unexpected " ++) .> error 1

|| alternative interface
|| note: a simple alias to maybeState (mst.<|>) can't be used, here, because we need to run the
|| alternative leg with the error state of the primary leg to keep the deepest error
(<|>) :: parser * -> parser * -> parser *
(<|>) pa pb
    = go
      where
        go ps
            = alt $ runState pa ps
              where
                alt (Nothing, psa) = runState pb (set psErr (view psErr psa) ps)
                alt ra             = ra

|| peek and not check for the presence or absence of a token, but don't consume it
peek, not :: parser * -> parser ()
peek pa ps
    = (Just (), ps), if isJust ra
    = (Nothing, ps), otherwise
      where
        ra = fst $ pa ps

not pa ps
    = (Just (), ps), if isNothing ra
    = (Nothing, ps), otherwise
      where
        ra = fst $ pa ps

optional :: parser * -> parser (maybe *)
optional pa = (<$>) Just pa <|> pure Nothing

|| run a parser and check the result against a guard predicate.  If the guard
|| fails, rewind the parser to the original point (using (<|>)) and report
|| unexpected input
guard :: parser * -> (* -> parser **) -> parser **
guard p g
    = (p >>= g) <|> unexpected

|| parser for a token which satifies a condition
satisfy :: parser * -> (* -> bool) -> parser *
satisfy p tst
    = p $guard f
      where
        f x = pure x, if tst x
            = fail,   otherwise

|| 1 or more p
some :: parser * -> parser [*]
some p = liftA2 (:) p (many p)

|| 0 or more p
many :: parser * -> parser [*]
many p = some p <|> pure []

|| 1 or more p seperated by ps
someSepBy :: parser * -> parser ** -> parser [**]
someSepBy ps p = liftA2 (:) p (many (ps >> p))

|| 0 or more p seperated by ps
manySepBy :: parser * -> parser ** -> parser [**]
manySepBy ps p = someSepBy ps p <|> pure []


|| token parsers

|| parser which accepts any token
|| also handle offside detection by inserting a Toffside token into the token stream
|| Note: since any always accepts a token, any subsequent guard or check for validity
|| should use "fail" for the failure, and use a (<|>) to rewind the token stream to the
|| original position to correctly report the error location and token
any :: parser tok.token
any ps
    = unexpected ps,    if isTend t & null ls || end of token stream
    = error 2 err ps,   if isTerror t         || error from lexer
    = (Just t', ps'),     otherwise
      where
        ls                = view psIndLev ps
        (t, _, ic) : ts'  = view psToks ps
        Terror err        = t
        offside           = ~null ls & (isTend t \/ ic < hd ls)
        t'                = Toffside,          if offside
                          = t,                 otherwise
        ps'               = ps,                if offside
                          = set psToks ts' ps, otherwise

|| parser which passes only at end of input
end :: parser ()
end = not any

|| parser which matches a specific token or posts an error
token :: tok.token -> parser tok.token
token t = any $satisfy (_eq cmptoken t)

|| parser which matches a specific character
char :: std.char -> parser tok.token
char c = token (Tchar c)

|| parser which matches a specific identifier string
ident :: string -> parser tok.token
ident s = token (Tident (Unqualified s))

|| parser which matches a specific symbol
sym :: string -> parser tok.token
sym s = token (Tsymbol (Unqualified s))

semi, comma, equal, eqeq, minus, percent, colons, lArrow, rArrow, vBar, terminator :: parser tok.token
semi       = char ';'
comma      = char ','
equal      = sym "="
eqeq       = sym "=="
minus      = sym "-"
percent    = sym "%"
colons     = sym "::"
lArrow     = sym "<-"
rArrow     = sym "->"
vBar       = sym "|"
terminator = token Toffside <|> semi


|| structure parsers

|| ( parser )
inParens :: parser * -> parser *
inParens p = char '(' >> p << char ')'

|| [ parser ]
inBrackets :: parser * -> parser *
inBrackets p = char '[' >> p << char ']'

|| { parser }
inBraces :: parser * -> parser *
inBraces p = char '{' >> p << char '}'

|| < parser >
inAngles :: parser * -> parser *
inAngles p = sym "<" >> p << sym ">"

|| block layout parser
inLayout :: parser * -> parser *
inLayout p = indent >> p << outdent

|| push the current token column on the indent level stack in the parser state
indent :: parser ()
indent ps
    = (Just (), over psIndLev (ic :) ps)
      where
        (_, _, ic) = hd $ view psToks ps        || get current token indent column ic

|| check for separator and pop the indent level stack in the parser state
outdent :: parser ()
outdent
    = terminator >> get >>= over psIndLev popLev .> put
      where
        popLev []       = []
        popLev (x : xs) = xs
