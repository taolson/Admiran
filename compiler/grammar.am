|| grammar.am -- Admiran expression, type, and definition grammars


%export +  -opPrecRepr -precAssocTable

%import <base>
%import <bitSet>
%import <lens>
%import <map>
%import <maybe>
%import <set>
%import "name"


|| Admiran grammar
||
|| The grammar has a unified AST to allow for easy traversal and rewriting, but these
|| types are synonyms to document the actual types

expr    == ast
cond    == ast
caseAlt == ast
qual    == ast
pat     == ast
texpr   == ast
tform   == ast
defn    == ast

nameMap == m_map name name              || map for renaming a name
defnMap == m_map name defn              || map from Qualified name to top-level definition in module
envMap  == m_map name [name]            || map from an Unqualified or Unresolved name to Qualified name(s) in modules where it is defined

ast ::=
    || expr
    Evar        name                        |
    Eint        int                         |
    Echar       char                        |
    Estring     string                      |
    EprimInt    int                         |   || represents an unboxed Int#
    EprimChar   char                        |   || represents an unboxed Char#
    EprimString string                      |   || represents an unboxed Addr# for a primitive C String
    Eap         expr expr                   |
    Ecall       expr [expr]                 |   || folded version of Eap e1 (Eap e2 ..) -- call a fn with arguments
    Econd       [cond]                      |   || conditional expr
    Ecase       caseSel expr [caseAlt] anno |   || caseSel is case selection type for selecting a caseAlt
    Efail       expr                        |   || non-local jump to expr of the enclosing Efatbar
    Efatbar     pat  expr expr              |   || expr1, if not FAIL; expr2 otherwise
    Elet        bool defnMap [defn] expr    |   || bool selects Elet or EletRec, defnMap for DefFns, [defn] for DefPats, initially
    ElistComp   expr [qual] anno            |   || location used to report any errors encountered during desugaring

    || cond
    Cif         expr expr                   |
    Cdefault    expr                        |

    || caseAlt
    CaseAlt     pat expr anno               |

    || qual
    Qgen        [pat] expr                  |   || list comprehension generator, e.g. x <- [1 .. 10]
    Qrecur      pat   expr expr             |   || list comprehension recurrence, e.g. x <- 1, 2 * x ...
    Qguard      expr                        |   || list comprehension guard, e.g. x > 5

    || pat
    Pvar        name                        |   || pattern is a variable to bind (irrefutable)
    Plit        expr                        |   || pattern is a literal to match against
    Pctor       name [pat]                  |   || pattern is a constructor to match against
    Pwildcard                               |   || pattern is an ignored wildcard (irrefutable)

    || texpr, tform
    Tname       name    [texpr]             |   || named constant type with optional list of Tvars (for defn tforms)
                                                || or a fully-saturated application of a higher-kinded type

    Tvar        int                         |   || type variable
    Ttuple      [texpr]                     |   || n-tuple type
    Tlist       texpr                       |   || list type
    Tarr        texpr   texpr               |   || arrow (function type) e.g. int -> char
    Tstrict     texpr                       |   || strict form, used in constructor arguments

    || defn
    DefFn       name    [pat]  expr  anno   |   || name, vars, rhs
    DefMult     multSel [defn]              |   || grouping for multiple DefFns of the same name or a DefPat and its accessors
    DefPat      pat     expr         anno   |   || pattern to match, rhs
    DefSyn      tform   texpr        anno   |   || type synonym e.g. tform == (string, [texpr])
    DefData     tform   [tform]      anno   |   || constructor type
    DefSpec     tform   texpr        anno   |   || type specification
    DefAbs      tform   [defn] texpr anno       || abstract type definition, along with its implementation type

|| don't auto-derive showI and ordI instances for ast, since they are very large. Instead, use
|| the functions in the pretty module for showing an ast, and the two specialized comparisons
|| cmplit and cmptexpr.

showast :: showI ast
showast a = undef

cmpast :: ordI expr
cmpast = undef

|| custom ordI instance for literals
cmplit :: ordI expr
cmplit (Eint a)        (Eint b)        = cmpint    a b
cmplit (EprimInt a)    (EprimInt b)    = cmpint    a b
cmplit (Echar a)       (Echar b)       = cmpchar   a b
cmplit (EprimChar a)   (EprimChar b)   = cmpchar   a b
cmplit (Estring a)     (Estring b)     = cmpstring a b
cmplit (EprimString a) (EprimString b) = cmpstring a b
cmplit a               b               = cmpTags   a b

cmptexpr :: ordI texpr
cmptexpr (Tname n tes) (Tname n' tes') = cmpname n n' $thenCmp (cmplist cmptexpr) tes tes'
cmptexpr (Tvar n)      (Tvar n')       = cmpint n n'
cmptexpr (Ttuple tes)  (Ttuple tes')   = cmplist cmptexpr tes tes'
cmptexpr (Tlist te)    (Tlist te')     = cmptexpr te te'
cmptexpr (Tarr ta tb)  (Tarr tc td)    = cmptexpr ta tc $thenCmp cmptexpr tb td
cmptexpr (Tstrict te)  (Tstrict te')   = cmptexpr te te'
cmptexpr a             b               = cmpTags  a  b

|| case selection type
|| generated during desugaring to qualify an Ecase and its CaseAlts
caseSel ::=
    Cnone       |       || no selection type specified
    Csingle     |       || single case alt
    Cpriority   |       || priority selection on case-by-case basis (for non-saturated alts list or for a too-large alt list)
    Cvectored           || vectored selection of a saturated case

|| mult selection type
|| DefMults are used to collect together fnforms of the same function name (which eventually get desugared to a single DefFn),
|| and collect together a pattern DefPat and its accessor patterns during pattern desugaring.  This type is used to differentiate
|| them, rather than having separate DefMultFn and DefMultPat constructors.
multSel ::=
    Mfun        |       || mult for DefFn
    Mpat                || mult for DefPat (and its accessor functions)

|| defn use info, for informing free-variable collection, dead-code elimination and no-update thunk optimizations
useInfo ::=
    Uzero |     || defn unused in enclosing Elet scope
    Uone  |     || defn has single use in enclosing Elet scope
    Umany       || defn has more than one use, or escapes its Elet scope and has an unknown number of uses

usedZero, usedAffine :: useInfo -> bool
usedZero Uzero   = True
usedZero _       = False

|| usedAffine is used 0 or 1 times
usedAffine Umany = False
usedAffine _     = True

|| annotation added to certain asts (defns, case exprs and case alts)
|| anno is a union of all the possible values used to annotate an ast; not all
|| fields are relevant for all asts
anno == (location, bool, int, useInfo, [name], bitSet)  || loc, recursive, complexity, useInfo, free vars, affine use info

|| don't auto-derive showI and ordI for anno
showanno = undef
cmpanno  = undef

|| lenses for annotation fields
annoLoc    = lensTup6_0
annoRec    = lensTup6_1
annoCpx    = lensTup6_2   || defn complexity
annoUse    = lensTup6_3   || defn useInfo
annoFree   = lensTup6_4   || defn free vars
annoAffine = lensTup6_5   || fn vars usedAffine, as a bitSet

emptyAnno :: anno
emptyAnno = (emptyLocation, False, 0, Uzero, [], bs_empty)

emptyAnnoLoc :: location -> anno
emptyAnnoLoc loc = set annoLoc loc emptyAnno


|| module name, line no for error reporting
location == (string, int, int)

emptyLocation :: location
emptyLocation = ("", 0, 0)

initLocation :: string -> location
initLocation mn = (mn, 0, 0)

|| lenses for anno field, to allow view / set / over operations on annotation fields of an ast
viewAnno :: ast -> anno
viewAnno (Ecase   _ _ _ an)   = an
viewAnno (CaseAlt _ _ an)     = an
viewAnno (DefFn   _ _ _ an)   = an
viewAnno (DefMult _ (d : ds)) = viewAnno d
viewAnno (DefPat  _ _ an)     = an
viewAnno (DefSyn  _ _ an)     = an
viewAnno (DefData _ _ an)     = an
viewAnno (DefSpec _ _ an)     = an
viewAnno (DefAbs  _ _ _ an)   = an
viewAnno _                    = unreachable

overAnno fn (Ecase sel e alts an)  = Ecase sel e alts (fn an)
overAnno fn (CaseAlt p e an)       = CaseAlt p e (fn an)
overAnno fn (DefFn n vars e an)    = DefFn n vars e (fn an)
overAnno fn (DefMult m (d : ds))   = DefMult m (overAnno fn d : ds)
overAnno fn (DefPat (Pvar n) e an) = DefPat (Pvar n) e (fn an)
overAnno fn (DefSyn tf te an)      = DefSyn tf te (fn an)
overAnno fn (DefData tf ctors an)  = DefData tf ctors (fn an)
overAnno fn (DefSpec tf te an)     = DefSpec tf te (fn an)
overAnno fn (DefAbs tf ds t an)    = DefAbs tf ds t (fn an)
overAnno fn d                      = d

astAnno :: lens ast anno
astAnno = Lens viewAnno overAnno

astAnnoLoc    = composeLens astAnno annoLoc
astAnnoRec    = composeLens astAnno annoRec
astAnnoCpx    = composeLens astAnno annoCpx
astAnnoUse    = composeLens astAnno annoUse
astAnnoFree   = composeLens astAnno annoFree
astAnnoAffine = composeLens astAnno annoAffine


reservedNames :: s_set string
reservedNames = s_fromList cmpstring ["if", "otherwise", "type", "where", "abstype", "with", "case", "of", "=", "::", "::=", "..", "|", "<-", "->"]


|| common name operations

isConstructor, isTvarSymbol, isVar, isPrefix, isWildcard, isSymbol :: name -> bool
isConstructor n = getName n |> safeHd |> fromMaybef False (\c -> c ==. ':' \/ isUpper c)
isTvarSymbol  n = getName n |> all (==. '*')
isVar         n = ~isConstructor n
isPrefix      n = opPrecAssoc n |> snd |> _eq cmpassoc AssocPrefix

isWildcard n
    = getName n |> check
      where
        check ['_'] = True
        check _     = False

isSymbol n
    = getName n |> check
      where
        check []         = False
        check ('_' : cs) = False
        check ('`' : cs) = check cs     || ignore prefix '`' which are used to mark names of inlined defns
        check (c   : cs) = ~letter c


|| common expr operations

isEvar, isLit, isUnboxed, isCase, isFail, isCall, isLet, isCaseAlt, isSimpleExpr :: expr -> bool
isEvar (Evar _) = True
isEvar _        = False

isLit (Eint _)        = True
isLit (Echar _)       = True
isLit (Estring _)     = True
isLit (EprimInt _)    = True
isLit (EprimChar _)   = True
isLit (EprimString _) = True
isLit _               = False

isUnboxed (EprimInt _)    = True
isUnboxed (EprimChar _)   = True
isUnboxed (EprimString _) = True
isUnboxed _               = False

isCase (Ecase _ _ _ _) = True
isCase _               = False

isFail (Efail _) = True
isFail _         = False

isCall (Ecall _ _) = True
isCall _           = False

isLet (Elet _ _ _ _) = True
isLet _              = False

isCaseAlt (CaseAlt _ _ _) = True
isCaseAlt _               = False

isSimpleExpr a = isEvar a \/ isUnboxed a \/ isTname a \/ isFail a

|| apply a function to two operands
ap2 :: expr -> expr -> expr -> expr
ap2 f e1 e2 = Eap (Eap f e1) e2


|| common pat operations

isPvar, isPlit, isPctor, isPwildcard, isPvarOrWild :: ast -> bool
isPvar (Pvar _) = True
isPvar _        = False

isPlit (Plit _) = True
isPlit _        = False

isPctor (Pctor _ _)  = True
isPctor _            = False

isPwildcard Pwildcard = True
isPwildcard _         = False

isPvarOrWild (Pvar _)  = True
isPvarOrWild Pwildcard = True
isPvarOrWild _         = False

unPvar :: texpr -> name
unPvar (Pvar n) = n
unPvar _        = unreachable

unTvar :: texpr -> int
unTvar (Tvar n) = n
unTvar _        = unreachable

ctorName :: ast -> name
ctorName (Pctor n _) = n
ctorName _           = unreachable

ctorVars :: ast -> [ast]
ctorVars (Pctor _ vars) = vars
ctorVars _              = []

samePatType :: ast -> ast -> bool
samePatType (Pvar _)    (Pvar _)    = True
samePatType (Pctor _ _) (Pctor _ _) = True
samePatType (Plit l1)   (Plit l2)   = _eq cmplit l1 l2
samePatType Pwildcard   Pwildcard   = True
samePatType p1          p2          = False

qualifyPat :: string -> ast -> ast
qualifyPat modName (Pvar n) = Pvar $ qualifyName modName n
qualifyPat modName p        = p

|| names used for lexical bindings
patNames :: ast -> [name]
patNames (Pvar n)       = [n]
patNames (Pctor _ vars) = concatMap patNames vars
patNames _              = []


|| common texpr and tform operations

isTname :: ast -> bool
isTname (Tname _ _) = True
isTname _           = False

isTvar :: ast -> bool
isTvar (Tvar _) = True
isTvar _        = False

isTarr :: ast -> bool
isTarr (Tarr _ _) = True
isTarr _          = False

tformName :: ast -> name
tformName (Tname n _) = n
tformName _           = unreachable

tformVars :: ast -> [ast]
tformVars (Tname _ vars) = vars
tformVars _              = unreachable

qualifyTform :: string -> ast -> ast
qualifyTform modName (Tname n vars) = Tname (qualifyName modName n) vars
qualifyTform modName a              = unreachable

typeName :: texpr -> name
typeName (Tname n _)  = n
typeName (Ttuple tes) = Builtin $ "tuple" ++ showint (#tes)
typeName (Tlist  te)  = Builtin $ "[" ++ getName (typeName te) ++ "]"
typeName (Tarr t1 t2) = Builtin $ "(" ++ getName (typeName t1) ++ " -> " ++ getName (typeName t2) ++ ")"
typeName (Tstrict t)  = typeName t
typeName (Tvar n)     = Builtin "type"
typeName _            = unreachable

isStrict :: ast -> bool
isStrict (Tstrict _) = True
isStrict _           = False

unStrict :: ast -> ast
unStrict (Tstrict t) = t
unStrict t           = t

|| return the individual components of a Tarr expr as a list, along with the final base type
typeList :: texpr -> ([texpr], texpr)
typeList (Tarr t1 t2)
    = (t1 : tl, bt)
      where
        (tl, bt) = typeList t2

typeList t = ([], t)

|| return the final type in a Tarr texpr
baseType :: texpr -> texpr
baseType t = snd $ typeList t

|| return the nth type in a Tarr texpr
nthType :: int -> texpr -> texpr
nthType i t = fst (typeList t) ! i


|| common defn operations

isDefn :: ast -> bool
isDefn (DefFn   _ _ _ _) = True
isDefn (DefMult _ _)     = True
isDefn (DefPat  _ _ _)   = True
isDefn (DefSyn  _ _ _)   = True
isDefn (DefData _ _ _)   = True
isDefn (DefSpec _ _ _)   = True
isDefn (DefAbs  _ _ _ _) = True
isDefn _                 = False

|| used to differentiate defn types
isDefFn, isDefPat, isDefFnPat, isDefMult, isDefData, isDefSyn, isDefSpec, isDefAbs, isDefType, isSyn :: ast -> bool

isDefFn (DefFn   _ _ _ _)     = True
isDefFn (DefMult _ (d : ds))  = isDefFn d
isDefFn _                     = False

isDefPat (DefPat  _ _ _)      = True
isDefPat (DefMult _ (d : ds)) = isDefPat d
isDefPat _                    = False

isDefFnPat (DefFn   _ _ _ _)  = True
isDefFnPat (DefPat  _ _ _)    = True
isDefFnPat (DefMult _ _)      = True
isDefFnPat _                  = False

isDefMult (DefMult _ _)       = True
isDefMult _                   = False

isDefData (DefData _ _ _)     = True
isDefData _                   = False

isDefSyn (DefSyn _ _ _)       = True
isDefSyn _                    = False

isDefSpec (DefSpec _ _ _)     = True
isDefSpec _                   = False

isDefAbs (DefAbs _ _ _ _)     = True
isDefAbs _                    = False

isDefType (DefData _ _ _)     = True
isDefType (DefSyn  _ _ _)     = True
isDefType (DefAbs  _ _ _ _)   = True
isDefType _                   = False

|| DefAbs act like DefSyns during synonym expansion
isSyn a = isDefSyn a \/ isDefAbs a

defnName :: ast -> name
defnName (DefFn   n _ _ _)    = n
defnName (DefMult _ (d : ds)) = defnName d
defnName (DefPat  p _ _)      = unPvar p,    if isPvar p
                              = ctorName p,  if isPctor p
                              = Builtin "_", if isPwildcard p
defnName (DefSyn  tf _ _)     = tformName tf
defnName (DefData tf _ _)     = tformName tf
defnName (DefSpec tf _ _ )    = tformName tf
defnName (DefAbs  tf _ _ _)   = tformName tf
defnName _                    = unreachable

|| lens for accessing a definition's tform and type
defnTform :: lens defn tform
defnTform
    = Lens getf overf
      where
        getf (DefSyn tf  _ _)   = tf
        getf (DefData tf _ _)   = tf
        getf (DefSpec tf _ _)   = tf
        getf (DefAbs tf  _ _ _) = tf
        getf _                  = unreachable

        overf fn (DefSyn tf te an)     = DefSyn (fn tf) te an
        overf fn (DefData tf ctors an) = DefData (fn tf) ctors an
        overf fn (DefSpec tf te an)    = DefSpec (fn tf) te an
        overf fn (DefAbs tf ds te an)  = DefAbs (fn tf) ds te an
        overf fn d                     = d

defnType :: lens defn texpr
defnType
    = Lens getf overf
      where
        getf (DefSyn  _ te _)   = te
        getf (DefSpec _ te _)   = te
        getf (DefAbs  _ _ te _) = te
        getf _                  = unreachable

        overf fn (DefSyn tf te an)    = DefSyn tf (fn te) an
        overf fn (DefSpec tf te an)   = DefSpec tf (fn te) an
        overf fn (DefAbs tf ds te an) = DefAbs tf ds (fn te) an
        overf fn d                    = d

dataCtors :: lens defn [tform]
dataCtors
    = Lens getf overf
      where
        getf (DefData _ ctors _) = ctors
        getf _                   = unreachable

        overf fn (DefData tf ctors an) = DefData tf (fn ctors) an
        overf fn d                     = d

fnVars :: ast -> [ast]
fnVars (DefFn   _ vars _ _) = vars
fnVars (DefMult _ (d : ds)) = fnVars d
fnVars d                    = []

fnExpr :: ast -> ast
fnExpr (DefFn   _ _ e _)    = e
fnExpr (DefPat  _ e _)      = e
fnExpr (DefMult _ (d : ds)) = fnExpr d
fnExpr _                    = unreachable

|| get the arity of a fn or spec defn -- special handling for constructors, where the arity is encoded in the builtinPack
fnArity :: ast -> int
fnArity (DefFn n vars e an)
    = ctorArity e, if isConstructor n
    = #vars,       otherwise
      where
        ctorArity (Tname pn [cn, t, EprimInt aty]) = aty
        ctorArity e                                = 0

fnArity (DefSpec tf te an)
    = countArrs te 0
      where
        countArrs (Tarr t1 t2) n = countArrs t2 $! n + 1
        countArrs t            n = n

fnArity (DefMult _ (d : ds)) = fnArity d
fnArity d                    = 0

|| flatten a list of definitions
flattenDefns :: [ast] -> [ast]
flattenDefns
    = concatMap exp
      where
        exp (DefMult m defs) = defs
        exp d                = [d]

|| make definition name(s) at the top level qualified with the module name
qualifyDefn :: string -> ast -> ast
qualifyDefn modName (DefFn n vars e an)    = DefFn   (qualifyName modName n) vars e an
qualifyDefn modName (DefMult m defs)       = DefMult m $ map (qualifyDefn modName) defs
qualifyDefn modName (DefPat p expr an)     = DefPat  (qualifyPat modName p) expr an
qualifyDefn modName (DefSyn tf te an)      = DefSyn  (qualifyTform modName tf) te an
qualifyDefn modName (DefData tf ctors an)  = DefData (qualifyTform modName tf) (map (qualifyTform modName) ctors) an
qualifyDefn modName (DefSpec tf te an)     = DefSpec (qualifyTform modName tf) te an
qualifyDefn modName (DefAbs tf ds t an)    = DefAbs  (qualifyTform modName tf) ds t an
qualifyDefn modName d                      = d


|| operator precedence and associativity
|| note: this sets up a fixed precedence and associativity for common operators; all others
|| are treated as the default of highest precedence (apPrec) and AssocRight
|| eventually this should be migrated to an ability to define the prec and assoc of an operator
|| when the operator is defined, but that requires some work to the module, admiranParser, and
|| reify modules

|| assocCompare allows comparison operators to be associative by chaining them with an '&'
|| e.g. 1 < a < 10 is rewritten as 1 < a & a < 10
assoc ::= AssocLeft | AssocRight | AssocPrefix | AssocCompare

|| Compact representation of operator precedence and associativity: each line represents
|| operators of equal precendence, with lines ordered from lowest to highest precedence.
|| Operators on a line are space-separated, and begin with a 'R', 'L', 'C', or 'P' to specify
|| associativity of all operators on the line.
|| Binary operators that are non-strict in their right operand should be right-associative.
opPrecRepr
    = [ || application, alternative
        "R $ $! <|>"

      || reverse application, functor / applicative / monad operators
      , "L |> !> >>= >> << <$> <&> <*>"

        || booleans
      , "R \\/"
      , "R &"
      , "P ~"

        || comparisons
      , "C == ~= < > <= >= ==. ~=. <. >. <=. >=. ==$ ~=$ <$ >$ <=$ >=$ ==% ~=% <% >% <=% >=%"

        || list operations
      , "R : ++ --"

        || bit-wise
      , "L .|."
      , "L .^."
      , "L .&."
      , "L .<<. .>>."

        || arithmetic
      , "L + - +% -%"
      , "P neg"
      , "L * quotrem divmod quot rem div mod / *% /%"
      , "R ^"

        || function composition
      , "R ."
      , "L .>"

        || list length
      , "P #"

        || list and array indexing
      , "L ! !!"
      ]

|| dynamically-built precAssocTable and value for application precedence, built from
|| parsing the lines in opPrecRepr
(precAssocTable, apPrec)
    = foldl insLevel (m_empty, 0) opPrecRepr
      where
        insLevel (m, prec) (a : s) = (words s |> foldl (ins prec (toAssoc a)) m, prec + 1)
        insLevel _         _       = unreachable

        ins prec a m op = m_insert cmpstring op (prec, a) m

        toAssoc 'L' = AssocLeft
        toAssoc 'R' = AssocRight
        toAssoc 'C' = AssocCompare
        toAssoc 'P' = AssocPrefix
        toAssoc _   = unreachable

|| look up operator in prec/assoc table, first removing any module qualifier
opPrecAssoc :: name -> (int, assoc)
opPrecAssoc op
    = m_findWithDefault cmpstring (apPrec, AssocRight) (getName op) precAssocTable
