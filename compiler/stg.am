|| stg.am -- convert AST to Spineless Tagless G-Machine VM representation, using eval-apply model


%export codeObj codePtr stgCode heapInfo heapObj heapPtr stgHeap stackObj stgStack continuation value
        refSpace ref r0Ref r1Ref r2Ref e0Ref opr r0Opr r1Opr r2Opr e0Opr
        applyToEnvPtr enterEnv0Ptr selRetPtr selApplyPtr blackHolePtr
        localEnv stgInsn showvalue cmpopr showopr showstgInsn showheapObj showstackObj
        buildStg heapObjWords stringWords

%import <base>
%import <lens>
%import <map>           qualified as m
%import <maybe>                         -(>>=) -(<$>) -(<&>) -(<*>) -(<<) -(>>)
%import <maybe>         qualified as mb
%import <state>         as st
%import "analyze"
%import "config"
%import "dependency"
%import "exception"                     -(>>=) -(<$>) -(<&>) -(<*>) -error
%import "grammar"
%import "module"
%import "name"
%import "predef"
%import "pretty"


|| a code object is a locInfo and a list of STG instructions
codeObj  == (locInfo, [stgInsn])                || source fn name and loc info, stg code
codePtr  == int                                 || index into the stgCode map
stgCode  == (m.map codePtr codeObj, codePtr)    || code map, next unused codePtr value

|| a heap object consists of a heapInfo tag along with a list of free-variable environment values
heapInfo ::=
    || these heapObjects can be applied directly if the arities match the #args
    Hfun    codePtr int |       || function with arity int, env values are free variable values of the function
    Hthunk  codePtr     |       || thunk (arity 0)
    Hfwd    heapPtr     |       || forward to another heapPtr (used when an Hthunk is updated to its computed value)

    || these heapObjects need a more general helper function to apply
    Hpap    heapPtr     |       || partial application of Hfun at heapPtr; env values are the under-applied arguments
    Halt    codePtr     |       || fatbar alternate; env values are the captured runtime stack and env pointers to restore

    || these heapObjects are data only (no codePtr)
    Hstream [char]      |       || a byteStream holding a packed list of chars
    Harray  int                 || a contiguous array of size int, starting with the next word

heapObj     == (heapInfo, [value])
closure     == heapObj                          || type synonym for a heapObj
closureInfo == (codePtr, int, bool, bool)       || codePtr, arity, free vars empty, isDefFun
heapPtr     == int                              || index into the stgHeap map
stgHeap     == (m.map heapPtr heapObj, heapPtr) || heap map, next unused heapPtr value (and top of statically-allocated heap)

|| compute the number of 8-byte words each heap object requires, including the tag/info word
heapObjWords :: heapObj -> int
heapObjWords (info, env)
    = hwords info + #env
      where
        hwords (Hstream s) = stringWords s + 1  || tag word plus words for string
        hwords (Harray n)  = n + 1              || tag word plus n words for the values
        hwords info        = 2                  || all other heapObjs contain a pointer plus the tag word

|| compute the number of 8-byte words each packed string requires
stringWords :: string -> int
stringWords s = case quotrem (#s) 8 of (q, r) -> q + if' (r > 0) 1 0

|| a stack object (continuation) consists of a continuation codePtr and a list of free variable environment values
stackObj     == (codePtr, [value])
continuation == stackObj         || type synonym for stackObj
stgStack     == [continuation]

|| values are either unboxed Words, codePtrs, or heapPtrs
value ::= Word int | Caddr codePtr | Haddr heapPtr

|| a ref represents a variable holding a value, and is an index into a particular refSpace
|| note: Stk space (for continuation closures) is a separate space from Env (for heap closures),
|| even though they share the same runtime Env base ptr, because Stk space grows downwards,
|| and to allow continuation closures to be appended, the runtime Env base pointer points to the top
|| of the stack closure space, with Stk indices treated as negative offsets, while heap Env spaces grows
|| upward in memory, with Env indices treated as positive offsets.
refSpace ::=
    Arg |       || incoming arguments vector
    Env |       || free variable environment vector in the current closure
    Stk |       || free variable environment vector on the stack (current continuation closure)
    Frm |       || contiguous region of heap space allocated with AllocFrame to use in building and referencing local closures from Elets
    Reg         || registers vector holding special values and temps:
                || Reg 0 holds returned tag / value in case evaluations
                || Reg 1 holds arity of args (from arity of returned ctor, used when having to create a Pvar binding to the entire returned ctor)
                || Reg 2 holds the base of the current closure (env base for heap closures, stack base for continuation closures)
                || Reg 3 .. are general registers

ref == (refSpace, int)

r0Ref, r1Ref, r2Ref, e0Ref :: ref
r0Ref = (Reg, 0)        || tag of ctor or word value when returning to a context closure
r1Ref = (Reg, 1)        || arity of ctor when returning to a context closure (needed for Vclosure & Update to capture correct number of args)
r2Ref = (Reg, 2)        || heapPtr of owning closure (for updates and closure env references)
e0Ref = (Env, 0)

|| an instruction operand is either an immediate value or a ref
opr ::= Imm value | Ref ref

|| special reg oprs
r0Opr, r1Opr, r2Opr, e0Opr :: opr
r0Opr = Ref r0Ref
r1Opr = Ref r1Ref
r2Opr = Ref r2Ref
e0Opr = Ref e0Ref

isStkOpr, isFrmOpr :: opr -> bool
isStkOpr (Ref (Stk, _)) = True
isStkOpr _              = False

isFrmOpr (Ref (Frm, _)) = True
isFrmOpr _              = False

|| make an opr from an integer
makeImmOpr :: int -> opr
makeImmOpr n = Imm (Word n)


|| STG instructions, chosen as a balance between lowering the representation closer to native code, and efficient interpretation
stgInsn ::=

    || control flow
    Call        codePtr [opr]           |    || tail call known codePtr (no free vars), copying [opr] .. to args
    Enter       heapPtr [opr]           |    || enter known closure hp with arguments [opr ..]
    EnterInd    opr     [opr]           |    || enter known closure (indirectly referencing hp from opr0) with arguments [opr1..]
    Apply       opr     [opr]           |    || apply unknown closure [opr0] to arguments [opr1 ..], may be over- or under-saturated
    ApplyToEnv                          |    || apply unknown closure [Reg 0] to arguments [env], may be over- or under-saturated
    Fail        opr                     |    || opr points to an Halt; restore the stack and env ptrs from the env and jump to Halt code ptr
    Ret         opr     opr             |    || copy [opr0,1] to Reg 0,1, pop a continuation from the stack, and enter it with current args vector
    RetEnv                              |    || copy env to Reg 0,1, args[0 .. #env-1], pop a continuation closure from the stack, and enter it
    CaseVec     opr     [codePtr]       |    || use [opr] as an index into the codePtrs and jump to that codePtr
    Jmp                 codePtr         |    || unconditional jump to codePtr
    Jeq         opr opr codePtr         |    || compare [opr0] with [opr1], and jump to codePtr if ==

    || stack manipulation
    PushCont    codePtr [opr]           |    || push a continuation closure on the stack with codePtr and environment [[opr0] ..]
    PopCont     int                     |    || pop N slots from the stack (deallocate continuation environment space)
    SetEnv      int                     |    || set Env base to the current stack ptr + N slots for Stk refs and oprs (top of closure environment)

    || heap manipulation
    AllocFrame  int                     |    || allocate int contiguous heapPtrs and store the base in the runtime frame ptr
    Fclosure    ref codePtr int [opr]   |    || ref := addr of new Hfun closure; int is arity of fn
    Tclosure    ref codePtr [opr]       |    || ref := addr of new Hthunk closure
    Aclosure    ref codePtr int [opr]   |    || ref := addr of new Halt closure (env also includes runtime stack ptr adjusted by int)
    Vclosure    ref codePtr             |    || ref := addr of new Hthunk closure, with env = r0, r1, args[0..r1-1]
    Update      opr opr                 |    || update the closure pointed to by opr0 to the codePtr referenced by opr1,
                                             || with Reg 0, Reg 1 and current args vector as the environment vars

    || primitive operations on words
    Mov         ref opr                 |    || ref := [opr1]
    Add         ref opr opr             |    || ref := [opr1] +    [opr2]
    Sub         ref opr opr             |    || ref := [opr1] -    [opr2]
    Mul         ref opr opr             |    || ref := [opr1] *    [opr2]
    QuotRem     ref ref opr opr         |    || (ref1, ref2) := [opr1] $quotrem [opr2] -- division truncate to zero
    DivMod      ref ref opr opr         |    || (ref1, ref2) := [opr1] $divmod  [opr2] -- division truncate to -infinity
    Cmp         ref opr opr             |    || ref := [opr1] $cmp [opr2]   -- returns 0# -> EQ, 1# -> LT, 2# -> GT
    Sel         ref opr                 |    || ref := args[opr] -- the value in opr is a word which is used to index into the args vector

    || primitive bit-wise operations on words
    Band        ref opr opr             |    || ref := [opr1] .&. [opr2]
    Bor         ref opr opr             |    || ref := [opr1] .|. [opr2]
    Bxor        ref opr opr             |    || ref := [opr1] xor [opr2]
    Bnot        ref opr                 |    || ref := complement [opr1]
    Bshl        ref opr opr             |    || ref := [opr1] .<<. [opr2]
    Bshr        ref opr opr             |    || ref := [opr1] .>>. [opr2]

    || primitive operations on byte streams
    AllocStream ref opr opr             |    || ref := new byteStream ref with fd field opr0 and size opr1
    ReadStream  ref opr                 |    || ref := read a byte from the byteStream ref in opr1
    WriteStream ref opr opr             |    || write byte in opr1 to the byteStream ref in opr0, returning success/fail indication in ref

    || primitive operations on arrays
    AllocArray  ref opr                 |    || ref := new array ref for an array of size [opr]
    FillArray   opr opr                 |    || fill array [opr1] with value [opr2]
    CopyArray   opr opr                 |    || copy contents of array [opr1] to array [opr2] (sizes assumed to be the same!)
    ReadArray   ref opr opr             |    || ref := value from the array ref [opr1] at index [opr2]
    WriteArray  opr opr opr             |    || write value [opr3] to array ref [opr1] at index [opr2]

    || primitive system operations           ||  0: exit
                                             ||  1: openFileRead
                                             ||  2: openFileWrite
                                             ||  3: openFileAppend
                                             ||  4: closeFile
                                             ||  5: readFile
                                             ||  6: writeFile
                                             ||  7: mtimeFile
                                             ||  8: getArg
                                             ||  9: systemCmd
                                             || 10: clock
    SystemOp    int ref opr

|| don't derive ordI for stgInsn, since we don't use it and it would be large
cmpstgInsn = undef


|| state passed through buildStg:
|| dynamic state:
|| genv:      global environment
|| code:      stgCode
|| heap:      stgHeap
||
|| lexically-scoped state:
|| lenv:      local environment, mapping a name to an opr (an Imm value, heap ptr for top-level defns, or a ref for binding locations)
|| lcls:      local closure info, mapping a name to a closure's codePtr and arity for use in directly calling/entering a closure
|| loc:       locInfo
|| regGen:    next temp reg to allocate
|| frmGen:    next frame slot to allocate
|| stkGen:    next stack slot to allocate (also used as current Stk frame size in SetEnv)
|| builtin:   currently evaluating a builtin (used in caseAlt code generation optimization of Pvar)
|| caseAlt:   currently evaluating a caseAlt (used to qualify adding PopEnv to discard the continuation frames on a tail call)
||            Note: these are state variables because it would be more difficult to pass these little-used booleans thoroughout the
||            buildCode functions; they must be set correctly lexically any time we are building caseAlts
localEnv == m.map name opr
localCls == m.map name closureInfo
bdDynSt  == (globalEnv, stgCode, stgHeap)
bdLexSt  == (localEnv, localCls, locInfo, int, int, int, bool, bool)
bdSt     == (bdDynSt, bdLexSt)

|| don't auto-derive bdLexSt, since they aren't needed and it would require writing tuple8 instances
cmpbdLexSt  = undef
showbdLexSt = undef

|| lenses for bdLexSt
lexLenv     = lensTup8_0
lexLcls     = lensTup8_1
lexLoc      = lensTup8_2
lexRegGen   = lensTup8_3
lexFrmGen   = lensTup8_4
lexStkGen   = lensTup8_5
lexBuiltin  = lensTup8_6
lexCaseAlt  = lensTup8_7

|| lenses for bdSt
bdDyn       = lensFst
bdLex       = lensSnd
bdGenv      = composeLens bdDyn  lensTup3_0
bdCode      = composeLens bdDyn  lensTup3_1
bdHeap      = composeLens bdDyn  lensTup3_2
bdCodeMap   = composeLens bdCode lensFst
bdCodePtr   = composeLens bdCode lensSnd
bdHeapMap   = composeLens bdHeap lensFst
bdHeapPtr   = composeLens bdHeap lensSnd
bdLenv      = composeLens bdLex  lexLenv
bdLcls      = composeLens bdLex  lexLcls
bdLoc       = composeLens bdLex  lexLoc
bdRegGen    = composeLens bdLex  lexRegGen
bdFrmGen    = composeLens bdLex  lexFrmGen
bdStkGen    = composeLens bdLex  lexStkGen
bdBuiltin   = composeLens bdLex  lexBuiltin
bdCaseAlt   = composeLens bdLex  lexCaseAlt

|| initial build state
|| fixed codePtrs for special generic operations, must ensure they match the order of the special routines in initBdSt
unpackPtr, updatePtr, selRetPtr, selApplyPtr :: codePtr
unpackPtr     = 0      || generic code to unpack an evaluated thunk into its tag (Reg 0), arity (Reg 1) and args (Arg 0 ..) from the thunk's env
updatePtr     = 1      || generic code to pack tag and args and update a thunk to return its evaluated value
applyToEnvPtr = 2      || generic code to apply [r0] to env, used to apply additional args to a partial application
enterEnv0Ptr  = 3      || generic code to perform an enter on env0, used to forward an updated thunk to the thunk holding its new value
selRetPtr     = 4      || generic code to perform a select on constructor arguments and return the corresponding word value
selApplyPtr   = 5      || generic code to perform a select on constructor arguments and apply the corresponding closure
blackHolePtr  = 6      || fixed location for the blackhole update "trampoline" for thunks

|| init resource allocation counters and status for building various AST types
initResources :: state bdSt ()
initResources = st.over bdLex $ lens.set lexRegGen 3 . lens.set lexFrmGen 0 . lens.set lexStkGen 0 . lens.set lexBuiltin False . lens.set lexCaseAlt False

initBdSt :: globalEnv -> bdSt
initBdSt genv
    = ((genv, code, heap), (m.empty, m.empty, emptyLocInfo, 3, 0, 0, False, False))
      where
        code = (m.fromList cmpcodePtr special, #special)    || code has special generic routines pre-installed
        heap = (m.empty, 0)

        || code for fixed code ptrs
        special  = [ (unpackPtr,     (builtinInfo "<unpack>",     [RetEnv]))                                                || unpack packed value to args
                   , (updatePtr,     (builtinInfo "<update>",     [Update e0Opr (Imm (Caddr unpackPtr)), Ret r0Opr r1Opr])) || pack args and update thunk
                   , (applyToEnvPtr, (builtinInfo "<applytoenv>", [ApplyToEnv]))                                            || apply r0 to args in env
                   , (enterEnv0Ptr,  (builtinInfo "<enterenv0>",  [EnterInd e0Opr []]))                                     || enter env0 for update fwd
                   , (selRetPtr,     (builtinInfo "<selret>",     [Sel r0Ref (Ref (Env, 0)), Ret r0Opr (makeImmOpr 0)]))    || sel for a word value
                   , (selApplyPtr,   (builtinInfo "<selapply>",   [Sel r0Ref (Ref (Env, 0)), Apply r0Opr []]))              || sel for a thunk value
                   , (blackHolePtr,  (builtinInfo "<blackhole>",  [Jmp blackHolePtr]))                                      || blackhole update "trampoline"
                   ]
        builtinInfo s = pathOnlyLocInfo $ Builtin s

|| alloc a int resource in bdSt strictly
allocResource :: lens bdSt int -> int -> state bdSt int
allocResource lns n
    = st.view lns >>= inc
      where
        inc r
            = r' $seq st.set lns r' >> st.pure r
              where r' = r + n

|| alloc a codePtr, to be updated later
allocCode :: state bdSt codePtr
allocCode = allocResource bdCodePtr 1

|| set stgCode[codePtr] to codeObj
updateCode :: codePtr -> codeObj -> state bdSt codePtr
updateCode cp obj = st.over bdCodeMap (m.insert cmpcodePtr cp obj) >> st.pure cp

|| make a codeObj from a list of stgInsns
makeCode :: [stgInsn] -> state bdSt codePtr
makeCode ins
    = st.bind2 (st.view bdLoc) allocCode mkObj
      where
        mkObj loc cp = updateCode cp (loc, ins)

|| alloc contiguous space in the stgHeap and return its base value
allocHeap :: int -> state bdSt heapPtr
allocHeap = allocResource bdHeapPtr

|| set stgHeap[heapPtr] to heapObj
updateHeap :: heapPtr -> heapObj -> state bdSt heapPtr
updateHeap hp obj = st.over bdHeapMap (m.insert cmpheapPtr hp obj) >> st.pure hp

lookupHeap :: heapPtr -> state bdSt heapObj
lookupHeap hp = st.view bdHeapMap <&> m.lookup cmpheapPtr hp .> fromJust

|| alloc contiguous space in the stack and return its base value
allocStack :: int -> state bdSt int
allocStack n = allocResource bdStkGen n

|| allocate a reg
allocReg :: state bdSt ref
allocReg = allocResource bdRegGen 1 <&> pair Reg

|| Allocate a contiguous region of frame slots, adding 2 words to
|| account for the tag word and the code ptr in each Hfun/Hthunk heap object.
|| This allocates all of the frame slots for a sequence of Elets at once, to allow
|| mutually-recursive functions / thunks to reference each other.  However, note that
|| this requires that all slots be initialized before any other heap allocation can occur,
|| to prevent a possible GC that traces through uninitialized memory.  Because of this,
|| allocations that may not be reached or aren't immediately initalized must either allocate
|| to Reg destinations, or require a new AllocFrame by initializing frmGen to 0
allocFrmSlots :: int -> state bdSt ref
allocFrmSlots n = allocResource bdFrmGen (n + 2) <&> pair Frm

lookupOpr :: name -> state bdSt opr
lookupOpr n = st.view bdLenv <&> m.lookup cmpname n .> fromJust

|| return the (name, opr) pairs for the names that have opr bindings matching the predicate
lookupOprsMatching :: (opr -> bool) -> [name] -> state bdSt [(name, opr)]
lookupOprsMatching p ns
    = st.view bdLenv <&> doLookups <&> filter (snd .> p)
      where
        doLookups lenv = map (\n -> m.lookup cmpname n lenv |> fromJust |> pair n) ns

|| make an operand from an expr
makeOpr :: expr -> state bdSt opr
makeOpr (Evar n)      = lookupOpr n
makeOpr (EprimInt n)  = Word n |> Imm |> st.pure
makeOpr (EprimChar c) = code c |> Word |> Imm |> st.pure

|| create a byteStream heap object for primitive strings
makeOpr (EprimString s)
    = allocHeap (stringWords s + 1) >>= mkByteStream
      where
        mkByteStream hp = updateHeap hp (Hstream s, []) >> (st.pure . Imm . Haddr) hp

makeOpr _ = unreachable

|| add possible arity info for variable names of a defn, using a new closureInfo
|| We can sometimes infer the arity to use for each of a defn's vars when evaluating them, based upon the
|| corresponding portion of the defn's DefSpec (if present). This allows a var to be evaluated with a
|| cheaper EnterInd, rather than a general Apply.  The arity is known to be 0 if the DefSpec portion for that
|| var is a value type (not a Tarr fn type) and the baseType is not a Tvar (universally qualified unknown type).
|| Otherwise, due to currying and how definitions can be written with fewer vars than the spec implies, the arity
|| can't be determined.
addVarArityInfo :: name -> [pat] -> state bdSt ()
addVarArityInfo dn vars
    = st.view bdGenv >>= go
      where
        go genv = lookupSpec genv dn |> addInfo

        addInfo Nothing = st.pure ()                            || no DefSpec for the defn name, can't infer arity
        addInfo (Just spec)
            = map typeList ts |> zip2 vars |> st.mapM_ insInfo
              where
                ts = lens.view defnType spec |> typeList |> fst

        || insert a dummy closureInfo for the arg n with inferred arity 0, if it is a value type that isn't universally qualified (Tvar)
        insInfo (Pvar n, ([], bt))
            = st.over bdLcls $ m.insert cmpname n (0, 0, False, False), if ~isTvar bt

        insInfo _ = st.pure ()

|| lookup possible closureInfo for an expr
lookupClosureInfo :: expr -> state bdSt (maybe closureInfo)
lookupClosureInfo (Evar n) = st.view bdLcls <&> m.lookup cmpname n
lookupClosureInfo e        = st.pure Nothing

|| allocate a new reg ref and bind a Pvar name to it, if the pat is a Pvar
makeRef :: pat -> state bdSt ref
makeRef p
    = allocReg >>= checkPat p
      where
        checkPat Pwildcard r = st.pure r
        checkPat (Pvar n)  r = st.pure r << st.over bdLenv (m.insert cmpname n (Ref r))
        checkPat _         _ = unreachable

|| bind Pvar names to Arg references and install in the lenv
|| skip over any non-Pvar pats (e.g. Pwildcard) which don't provide a name to bind
bindArgs :: [pat] -> state bdSt ()
bindArgs ps
    = st.over bdLenv $ \m -> foldl addBinding m binds
      where
        binds = enumerate ps |> filter (snd .> isPvar) .> map (\(i, p) -> (unPvar p, Ref (Arg, i)))

        addBinding m (k, v) = m.insert cmpname k v m

|| bind names to Env references and install in the lenv
bindEnvs :: [name] -> state bdSt ()
bindEnvs ns
    = st.over bdLenv $ \m -> foldl addBinding m binds
      where
        binds = enumerate ns |> map (\(i, n) -> (n, Ref (Env, i)))

        addBinding m (k, v) = m.insert cmpname k v m

|| bind names to new Stk references and install in the lenv
bindStks :: [name] -> state bdSt ()
bindStks ns
    = allocStack (#ns) >>= doBind
      where
        doBind sBase
            = st.over bdLenv $ \lenv -> foldl addBinding lenv binds
              where
                binds = zip2 [sBase ..] ns |> map (\(i, n) -> (n, Ref (Stk, i)))

                addBinding m (k, v) = m.insert cmpname k v m

|| rebind names that are currently bound to Oprs matching predicate p to new Reg references,
|| install in the lenv, and return a list of Mov insns that perform the runtime action of the rebinding
|| this rebinding / copy is needed when we might over-write Stk-bound references with a new closure before
|| a tail-call, or lose existing Frm-bound references when allocating a new Frame
rebindToRegs :: (opr -> bool) -> [name] -> state bdSt [stgInsn]
rebindToRegs p ns
    = st.bind2 (st.view bdLenv) (lookupOprsMatching p ns) doAlloc
      where
        doAlloc lenv nsOprs
            = st.mapM (const allocReg) nsOprs >>= doBinds .> \(lenv', movs) -> st.set bdLenv lenv' >> st.pure movs
              where
                doBinds rs = zip2 nsOprs rs |> foldl addBinding (lenv, [])

                addBinding (m, mvs) ((n, v), r) = (m.insert cmpname n (Ref r) m, Mov r v : mvs)

|| run a build function in a new lexical environment, restoring the environment afterwards.
inLexEnv :: state bdSt ** -> state bdSt **
inLexEnv ma = st.view bdLex >>= \lex -> ma << st.set bdLex lex

|| run a build function in a new environment of Arg refs and Env refs for a Defn
inDefEnv :: locInfo -> [pat] -> [name] -> state bdSt [stgInsn] -> state bdSt [stgInsn]
inDefEnv loc pvs fns ma
    = inLexEnv $ initEnv >> ma
      where
        initEnv = initResources >>
                  bindArgs pvs  >>
                  bindEnvs fns  >>
                  st.over bdLoc (mergeLocInfo loc)

|| run a build function in a new environment of Stk refs for a continuation
inContEnv :: [name] -> state bdSt [stgInsn] -> state bdSt [stgInsn]
inContEnv fns ma
    = inLexEnv $ initRes >> bindStks fns >> ma
      where
        initRes = st.over bdLex $ lens.set lexRegGen 3 . lens.set lexBuiltin False . lens.set lexCaseAlt False

|| run a build function for a builtin function
inBuiltinEnv :: state bdSt [stgInsn] -> state bdSt [stgInsn]
inBuiltinEnv ma
    = inLexEnv $ initRes >> ma
      where
        initRes = st.over bdLex $ lens.set lexBuiltin True . lens.set lexCaseAlt False

|| run a build function in a new environment of Arg refs for a caseAlt
inAltEnv :: [pat] -> state bdSt [stgInsn] -> state bdSt [stgInsn]
inAltEnv pvs ma
    = inLexEnv (initRes >> bindArgs pvs >> ma)
      where
        initRes = st.over bdLex $ lens.set lexFrmGen 0 . lens.set lexCaseAlt True

|| run a build function in a new environment of Env refs for a fatbar alt
inFbAltEnv :: [name] -> state bdSt [stgInsn] -> state bdSt [stgInsn]
inFbAltEnv fns ma
    = inLexEnv (initResources >> bindEnvs fns >> ma)

unPrimInt :: expr -> maybe int
unPrimInt (EprimInt n) = Just n
unPrimInt _            = Nothing

internalFreeNames :: ast -> [name]
internalFreeNames a = lens.view astAnnoFree a |> filter isInternal

|| possibly add a popCont to remove a continuation env before a return or a tail call with no continuation
popCont :: [stgInsn] -> state bdSt [stgInsn]
popCont xs
    = st.liftA2 check (st.view bdCaseAlt) (st.view bdStkGen)
      where
        check inCaseAlt sc
            = PopCont sc : xs, if inCaseAlt & sc > 0
            = xs,              otherwise

|| build the code for a caseAlt
buildCodeAlt :: caseAlt -> state bdSt [stgInsn]

|| bind the Pvar name to an opr, either r0 if we are building for a builtin result,
|| or a new reg operand for a Vclosure that captures the current r0, r1, and args and unpacks them when called
|| Note: this code uses the bdBuiltin state var to determine if we are currently working inside a builtin; this
|| must be set lexically whenever we enter a new Ecase
buildCodeAlt (CaseAlt (Pvar n) e an)
    = inAltEnv [] $ st.view bdBuiltin >>= doAlt
      where
        doAlt inBuiltin
            = popCont [Ret r0Opr r1Opr], if matchVar n e        || return result bound to the Pvar
            = buildCode e,               if inBuiltin           || dest reg already allocated (r0) for builtin
            = mkVclosure,                otherwise              || allocate a new result dest and create a Vclosure for the alt

        matchVar n (Evar n') = _eq cmpname n n'
        matchVar _ _         = False

        mkVclosure
            = allocReg >>= \reg ->
              st.over bdLenv (m.insert cmpname n (Ref reg)) >>
              buildCode e <&> \eins ->
              Vclosure reg unpackPtr : eins

buildCodeAlt (CaseAlt (Pctor cn vars) e an)
    = inAltEnv vars $ addVarArityInfo cn vars >> buildCode e

buildCodeAlt (CaseAlt p e an)
    = inAltEnv [] $ buildCode e

buildCodeAlt _ = unreachable

|| convert a list of CaseAlts to the stgInsns to match against them,
|| based upon the caseSel of the Ecase and the tag opr, and return the code
|| note that the alts all share a common context with the same env (union of all free vars)
buildCodeAlts :: caseSel -> opr -> [caseAlt] -> state bdSt [stgInsn]

buildCodeAlts Csingle topr [alt]
    = buildCodeAlt alt

buildCodeAlts Cvectored topr alts
    = st.mapM buildCodeAlt alts >>= st.mapM makeCode <&> \cps -> [CaseVec topr cps]

|| create a sequence of Jeq topr <tag> <codeptr> insns up to the first
|| irrefutable alt, then fall through to its insns
buildCodeAlts Cpriority topr alts
    = st.bind2 (st.view bdGenv) (st.mapM buildCodeAlt alts) go
      where
        go genv bbs
            = foldr doAlt (st.pure [Jmp blackHolePtr]) (zip2 alts bbs)  || the Jmp blackHolePtr should never be encountered,
              where                                                     || but it is an easy insn to have as "bottom"
                doAlt (a, bb) k
                  = st.pure bb,          if isPvarOrWild p              || irrefutable (unconditional) case; early-outs
                  = st.liftA2 (:) tst k, otherwise                      || refutable (conditional) case; add Jeq of tag
                    where
                      CaseAlt p _ _ = a
                      tst           = makeCode bb <&> Jeq topr (mkTagOpr p)

                mkTagOpr (Plit (EprimInt n))  = makeImmOpr n
                mkTagOpr (Plit (EprimChar c)) = makeImmOpr (code c)
                mkTagOpr (Pctor cn vars)      = findMatching cn |> makeImmOpr
                mkTagOpr p                    = topr

                findMatching n
                    = lookupCtorNames genv n |> fromMaybe [] |> map getName |> elemIndex (==$ ns) |> fromMaybe 0
                      where
                        ns = getName n

buildCodeAlts _ _ _ = unreachable

|| build the code to handle a call to a builtin function; these will all be single stgInsns
|| the destination ref to use is passed in, as it can be optimized to a new Reg ref in
|| certain cases (see buildCode for Ecase)
buildCodeCallBuiltin :: name -> [expr] -> [ref] -> state bdSt stgInsn
buildCodeCallBuiltin n args dsts
    = go (getName n)
      where
        opr0 = makeOpr (args ! 0)
        opr1 = makeOpr (args ! 1)
        opr2 = makeOpr (args ! 2)
        zero = makeImmOpr 0

        dst0 = dsts ! 0
        dst1 = dsts ! 1

        opD0  op = op dst0 r0Opr |> st.pure
        opDS  op = op dst0       <$>        opr0
        opDZS op = op dst0 zero  <$>        opr0
        opDSS op = st.liftA2 (op dst0)      opr0 opr1
        opPSS op = st.liftA2 (op dst0 dst1) opr0 opr1
        opSS  op = st.liftA2 op             opr0 opr1
        opSSS op = st.liftA3 op             opr0 opr1 opr2

        || primitive arithmetic operations on word#
        go "+#"       = opDSS Add
        go "-#"       = opDSS Sub
        go "*#"       = opDSS Mul
        go "quotrem#" = opPSS QuotRem
        go "divmod#"  = opPSS DivMod
        go "cmp#"     = opDSS Cmp
        go "getTag#"  = opD0  Mov

        || primitive bit operations on word#
        go "band#" = opDSS Band
        go "bor#"  = opDSS Bor
        go "bxor#" = opDSS Bxor
        go "bnot#" = opDS  Bnot
        go "bshl#" = opDSS Bshl
        go "bshr#" = opDSS Bshr

        || operations on packed byte streams
        go "allocByteStream#" = opDZS AllocStream
        go "allocFileStream#" = opDSS AllocStream       || a FileStream uses the same Hstream obj as a ByteStream, only with the fd field specified
        go "readByteStream#"  = opDS  ReadStream
        go "writeByteStream#" = opDSS WriteStream

        || operations on arrays
        go "allocArray#" = opDS  AllocArray
        go "fillArray#"  = opSS  FillArray
        go "copyArray#"  = opSS  CopyArray
        go "readArray#"  = opDSS ReadArray
        go "writeArray#" = opSSS WriteArray

        || system and file operations
        go "exit#"           = opDS  (SystemOp 0)
        go "openFileRead#"   = opDS  (SystemOp 1)
        go "openFileWrite#"  = opDS  (SystemOp 2)
        go "openFileAppend#" = opDS  (SystemOp 3)
        go "closeFile#"      = opDS  (SystemOp 4)
        go "readFile#"       = opDS  (SystemOp 5)
        go "writeFile#"      = opDS  (SystemOp 6)
        go "mtimeFile#"      = opDS  (SystemOp 7)
        go "getArg#"         = opDS  (SystemOp 8)
        go "systemCmd#"      = opDS  (SystemOp 9)
        go "clock#"          = opDS  (SystemOp 10)

        go _ = unreachable

|| build code for an Ecall (function) or an Evar (thunk), based upon info from the call fopr and any closureInfo
buildCodeCall :: expr -> [expr] -> state bdSt [stgInsn]

buildCodeCall (Evar f) args
    = buildCodeCallBuiltin f args [r0Ref] <&> singleton, if isBuiltin f & ~isConstructor f

buildCodeCall fe args
    = st.bind3 (makeOpr fe) (st.mapM makeOpr args) (lookupClosureInfo fe) mkCall
      where
        mkCall fopr aoprs minfo
            = checkImm fopr >>= popCont
              where
                || check the fopr for an immediate address (known code/heap ptr)
                checkImm (Imm (Caddr cp)) = st.pure [Call cp aoprs]
                checkImm (Imm (Haddr hp)) = lookupHeap hp >>= checkHobj hp
                checkImm _                = checkInfo minfo

                || use the known heapObj info
                checkHobj hp (Hfun cp arity, env) = mkDirect (Just hp) cp arity (null env) True
                checkHobj hp (Hthunk cp, env)     = mkDirect (Just hp) cp 0     (null env) False
                checkHobj hp hObj                 = mkGeneral

                || check for closureInfo associated with the fopr
                checkInfo Nothing                      = mkGeneral
                checkInfo (Just (cp, arity, ef, isFn)) = mkDirect Nothing cp arity ef isFn

                || use known codePtr and arity to check for over/under application and choose call form
                mkDirect mhp cp arity emptyEnv isFn
                    = tryBind fopr aoprs
                      where
                        || fopr and aoprs are args, here, because mkOverApp may end up remapping them to
                        || Regs if they are Stk operands that might get destroyed by a subsequent push,
                        || before restarting tryBind, again
                        tryBind fopr aoprs
                            = st.pure [Ret fopr (makeImmOpr 0)],    if noprs == 0 & arity > 0   || un-applied fn evaluates to self
                            = mkOverApp tryBind fopr arity aoprs,   if noprs > arity            || over-applied fn split in two
                            = st.pure [Apply fopr aoprs],           if noprs < arity            || under-applied fn handled at runtime with Apply
                            = st.pure [Call cp aoprs],              if isFn & emptyEnv          || can call cp directly if it is a fn with empty env
                            = st.pure [Enter (fromJust mhp) aoprs], if isJust mhp               || can enter a closure directly if heapPtr known
                            = st.pure [EnterInd fopr aoprs],        otherwise                   || enter closure indirectly from fopr
                              where
                                noprs = #aoprs

                || push an applyToEnv continuation for the over-applied args, then perform the call
                || with the correct initial args. If the call is a tail-call without a continuation,
                || a PopCont will be prepended so the continuation can overwrite Stk args. To prevent this,
                || fe and args that are currently mapped to Stk oprs are remapped to Regs and Mov insns are
                || generated to handle the remapping at runtime
                mkOverApp tryBind fopr arity aoprs
                    = st.view bdCaseAlt >>= splitRemap >>= doSplit
                      where
                        varName (Evar n, _) = n
                        varName _           = unreachable

                        mkRemap movs (fopr' : aoprs') = (movs, fopr', splitAt arity aoprs')
                        mkRemap _    _                = unreachable

                        splitRemap False = st.pure ([], fopr, splitAt arity aoprs)
                        splitRemap True
                            = st.liftA2 mkRemap (rebindToRegs isStkOpr ns) (st.mapM makeOpr (fe : args))
                              where
                                ns = zip2 (fe : args) (fopr : aoprs) |> filter (snd .> isStkOpr) |> map varName

                        doSplit (movs, fopr', (aoprs1, aoprs2))
                            = tryBind fopr' aoprs1 <&> (movs ++ [PushCont applyToEnvPtr aoprs2] ++)

                || unknown closure; make a general Apply
                || Note: even if we are calling with null aoprs (nominally a Thunk that could be EnterInd),
                || we don't know the arity; it might have to return a partial application, so we always use Apply
                mkGeneral = st.pure [Apply fopr aoprs]


|| convert an expr to a list of stgInsns that will evaluate that expr at runtime
buildCode :: expr -> state bdSt [stgInsn]

buildCode (EprimInt n)  = popCont [Ret (makeImmOpr n) (makeImmOpr 0)]
buildCode (EprimChar c) = popCont [Ret (makeImmOpr n) (makeImmOpr 0)] where n = code c

|| convert an Evar reference to code to evaluate a thunk or self-evaluate a value
buildCode (Evar n) = buildCodeCall (Evar n) []

|| convert an Elet into code/heap bindings for its defns, insns to make Hfun / Hthunk closures at runtime
|| for those bindings, and the insns for the Elet's expr
buildCode (Elet _ defs _ e)
    = st.view bdFrmGen >>= fFrm || get the current frm count to determine if we need to add an AllocFrame insn or not
      where
        defl = m.toList defs

        || defs converted in parallel in two phases: allocate & bind, then create and update,
        || so that mutually-recursive references can lookup their values in the bdLenv
        fFrm fg = st.mapM allocObj defl >>= st.mapM createDefnCode >>= createExprCode fg e

        || allocate a codePtr and a frame slot ref, and insert the ref and closure info into the lenv for the name n
        allocObj (n, d)
            = st.bind2 (allocFrmSlots nslots) allocCode mkObj
              where
                fns    = internalFreeNames d
                nfns   = #fns
                nslots = if' (isDefFn d) nfns (max2 cmpint nfns 1)      || always allocate at least 1 slot for use by Update

                mkObj rf cp
                    = st.pure (d, cp, rf, fns)                     <<
                      st.over bdLenv (m.insert cmpname n (Ref rf)) <<
                      st.over bdLcls (m.insert cmpname n clsInfo)
                      where
                        clsInfo = (cp, fnArity d, null fns, isDefFn d)

        || create the code (stgInsns) and free var references for the defn and update the object's codePtr
        createDefnCode (d, cp, rf, fns)
            = st.bind3 (buildCode d) (st.mapM (makeOpr . Evar) fns) (st.view bdLoc) updateObj
              where
                updateObj ins frs loc
                    = st.pure (d, cp, rf, frs) << updateCode cp (loc', ins)
                      where
                        loc' = mergeLocInfo (defnLocInfo d) loc

        || create the code for the expr, adding any Frm Mov insns and Fclosure/Tclosure instrs for the defns
        createExprCode fg e objs
            = buildCode e >>= addInsns >>= addFrame fg
              where
                mkClosure (d, cp, rf, frs)
                    = Fclosure rf cp (fnArity d) frs, if isDefFn d
                    = Tclosure rf cp frs,             otherwise

                addInsns ins = st.liftA2 pair (st.pure $ map mkClosure objs ++ ins) (st.view bdFrmGen)

                || add the AllocFrame insn for a set of allocations (only add to the top-level of a set of nested
                || Elets by checking that the initial frmGen count is zero)
                addFrame fg1 (ins, fg2)
                    = st.pure (AllocFrame fg2 : ins), if fg1 == 0
                    = st.pure ins,                    otherwise

|| match case evaluation of (non constructor) builtin primitives to an stgInsn, and bind the result
|| to a newly-allocated ref or multiple refs. Evaluation of the scrutinee is a single instruction with word#
|| operands that doesn't require a continuation to capture free vars. Also, builtin primitives
|| only return word# results (value, tag, or tuple of words), so a Csingle caseAlt with all Pvar vars
|| is optimized here to a allocate new Regs, rather than creating a new thunk closure to hold the result
||
|| if any caseAlt will perform an AllocFrm due to an Elet, rebind any existing Frm-bound free vars to Regs
|| so that they may be referenced correctly
buildCode (Ecase sel (Ecall (Evar fn) args) alts an)
    = st.bind2 (rebindToRegs isFrmOpr fns) (mkDsts sel alts) mkCode, if isBuiltin fn & ~isConstructor fn
      where
        fns = filter needsFrm alts |> concatMap internalFreeNames |> nub cmpname

        needsFrm (CaseAlt _ (Elet _ _ _ _) _) = True        || caseAlt has an Elet, which allocs Frm slots
        needsFrm _                            = False

        mkDsts Csingle [CaseAlt p e an]            =         makeRef p  <&> singleton .> pair (Just e), if isPvarOrWild p
        mkDsts Csingle [CaseAlt (Pctor c ps) e an] = st.mapM makeRef ps <&>              pair (Just e), if isBuiltinTuple c & all isPvarOrWild ps
        mkDsts _       _                           = st.pure [r0Ref]    <&>              pair Nothing   || multiple alts (cmp#)

        mkCode movs (me, dsts)
            = st.liftA2 insMovs (buildCodeCallBuiltin fn args dsts) (buildAlts me)
              where
                buildAlts Nothing  = buildCodeAlts sel r0Opr alts
                buildAlts (Just e) = buildCode e

                insMovs bi ais = movs ++ (bi : ais)

|| general case evaluation
|| make a new context of non-Stk free vars for all the caseAlts, then append that to any existing continuation
|| closure with a PushCont
buildCode (Ecase sel e alts an)
    = lookupOprsMatching (isStkOpr .> not) fns >>= mkCode
      where
        fns = concatMap internalFreeNames alts |> nub cmpname

        addSetEnv 0 ins = ins
        addSetEnv n ins = SetEnv n : ins

        mkCode nOprs
            = st.bind3 (st.view bdStkGen) buildScrut buildAlts insStkAdj
              where
                (fns', foprs') = unzip2 nOprs
                buildScrut     = st.set bdCaseAlt False >> buildCode e
                buildAlts      = inContEnv fns' (buildCodeAlts sel r0Opr alts)

                insStkAdj sg eis ais
                    = makeCode (addSetEnv (sg + #fns') ais) <&> \cp -> [PushCont cp foprs'] ++ eis

|| Handle the polymorphic psuedo-function <pack>, which is represented as a Tname.
|| While it is nominally packing together args for a constructor, most of the time we are just
|| dynamically returning to a case continuation, so <pack> just becomes a Ret with the constructor's
|| tag in r0 and it's arity in r1, and the existing constructor args already in place in the args
|| array.  Actual packing of these in a new Hthunk heapObj is left to the Update instruction,
|| which allows thunks that don't require updates to leave it out.
buildCode (Tname f as)
    = st.pure [Ret (cvtArg 1) (cvtArg 2)], if _eq cmpname f builtinPackName
      where
        cvtArg i = as !? i mb.>>= unPrimInt |> fromMaybe 0 |> makeImmOpr

|| handle polymorphic pseudo-function <sel>, by pushing a sel continuation with the index
|| NOTE: if the inliner is allowed to inline constructors, the <pack> will get inlined to
|| an Ecall Tname like for <sel>, which is handled here, as well
buildCode (Ecall (Tname f as) args)
    = st.liftA2 mkSel (st.view bdGenv) (buildCode e), if _eq cmpname f builtinSelName
    = buildCodeCall (Evar cn) args,                   otherwise
      where
        e  = safeHd args |> fromMaybe builtinFail
        cn = safeHd as   |> fromMaybe builtinFail |> tformName
        i  = as !? 1 mb.>>= unPrimInt |> fromMaybe 0

        mkSel genv eis
            = PushCont selPtr [makeImmOpr i] : eis
              where
                t       = lookupSpec genv cn |> fromJust |> lens.view defnType |> nthType i  || get the individual types of the ctor
                selPtr  = selRetPtr,   if _eq cmptexpr t builtinTypeWord                || if we are selecting a word#, use Sel followed by a Ret
                        = selApplyPtr, otherwise                                        || otherwise it is a thunk; use Sel followed by an Apply

|| general case for Ecall: make oprs from the fn and the args,
|| then either generate an Apply or Enter or Call insn, depending
|| upon the lenv value of f
buildCode (Ecall f args) = buildCodeCall f args

|| alloc a closure for the fatbar alt, capturing the free vars in the alt, along with the
|| current stkGen value to perform the effect of the required PopCont if the closure is invoked.
|| then bind the closure to the fatbar's Pvar and generate the insns for the primary
buildCode (Efatbar (Pvar n) e1 e2)
    = st.bind3 (st.view bdGenv) (st.view bdFrmGen) (st.view bdStkGen) build
      where
        build genv fg sg
            = allocClosure >>= \cls -> st.liftA3 mkClosure (st.mapM lookupOpr fns) (mkPrim cls) mkAlt
              where
                fns        = analyzeExprFree e2 genv |> filter isInternal
                mkAlt      = inFbAltEnv fns (buildCode e2) >>= makeCode
                mkPrim cls = st.over bdLenv (m.insert cmpname n (Ref cls)) >> buildCode e1 <&> pair cls

                allocClosure
                    = allocReg,                 if fg == 0      || no existing frame, so alloc to a reg
                    = allocFrmSlots $ #fns + 1, otherwise       || allocate slots for free vars + stack ptr

                mkClosure fvs (ref, ins) altCp
                    = Aclosure ref altCp sg fvs : ins

|| an Efail invokes the Aclosure through the Fail insn
buildCode (Efail e)
    = makeOpr e <&> mkFail
      where
        mkFail fopr = [Fail fopr]

buildCode d
    = buildCodeDef d
      where
        loc = defnLocInfo d
        fns = internalFreeNames d

        buildCodeDef (DefFn n vars e an)
            = inDefEnv loc vars fns (addVarArityInfo n vars >> buildCode e)

        || DefPats are thunks which may need to be updated after their evaluation.  The code first updates the thunk to point to
        || the blackhole trampoline code, so that recursive evaluation reports a blackHole immediately.  Then, an update continuation
        || is pushed, so that when the evaluation returns, it first returns to the generic update code (Caddr 1) which performs
        || the update, capturing the returned value and changing the codePtr to point to the standard unpack code (Caddr 0).
        || The update continuation isn't required for thunks which are usedAffine (used zero or one time), as determined during
        || use analysis, and for any DefPat returning a constructor application, since that is already WHNF.  This applies to
        || constructors that have strict fields, as well, but that shouldn't be a big issue, since re-evaluating the strict field
        || should itself have been turned into a simple unpack of a thunk.
        buildCodeDef (DefPat p e an)
            = inDefEnv loc [] fns (buildCode e) <&> mkCode
              where
                bhInst     = Update r2Opr (Imm (Caddr blackHolePtr))            || update thunk to blackHole trampoline during evaluation
                contInst   = PushCont updatePtr [r2Opr]                         || push a continuation to update thunk with result
                noUpdate   = isCtorCall e \/ usedAffine (lens.view annoUse an)

                || don't perform updates on thunks that are simple constructor calls
                || since constructors are WHNF already and don't evaluate their args
                isCtorCall (Ecall (Evar n) args) = isConstructor n
                isCtorCall e                     = False

                mkCode eis = eis,                     if noUpdate
                           = bhInst : contInst : eis, if useBlackHole
                           = contInst : eis,          otherwise

        buildCodeDef _ = unreachable    || no other defn types should be reachable


|| convert one or a group of mutually-recursive top-level defns to their STG equivalent
|| and install it in the code/heap and environment
buildGroup :: globalEnv -> [name] -> state bdSt [value]
buildGroup genv ns
      || defs converted in parallel in two phases: allocate & bind, then create and update,
      || so that recursive references can lookup their values in the bdLenv
    = st.mapM allocObj ns >>= st.mapM createCode
      where

        || allocate a codePtr and heapPtr, create a heapObj and insert it in the heap and environment
        || Top-level functions have a heapPtr address, even though they don't have any free variables to
        || close over, because they may be passed as higher-order functions to other functions.  Any direct
        || use will be optimized to a direct call, though.
        allocObj n
            = st.bind2 allocCode (allocHeap nslots) (mkObj d) >>= insObj
              where
                d      = makeBuiltinCtorDef n,         if isBuiltin n
                       = fromJust (lookupDefn genv n), otherwise
                nslots = if' (isDefFn d) 2 3    || allocate an extra slot for use by Update

                mkObj d cp hp
                    = st.pure (n, cp, hp, d) << updateHeap hp (mkInfo d, [])
                      where
                        mkInfo (DefFn n args e an) = Hfun cp (fromJust (lookupArity genv n))    || not #args, because ctors have empty arg fields
                        mkInfo (DefPat p e an)     = Hthunk cp
                        mkInfo _                   = unreachable

                insObj (n, cp, hp, d)
                    = st.pure (cp, v, d) << st.over bdLenv (m.insert cmpname n (Imm v))
                      where
                        v = Haddr hp

        || create the code (stgInsns) for the defn and update the object's codePtr
        createCode (cp, v, d)
            = st.bind2 (buildCode d) (st.view bdLoc) updateObj
              where
                updateObj ins loc
                    = st.pure v << updateCode cp (loc', ins)
                      where
                        loc' = mergeLocInfo (defnLocInfo d) loc

|| collect all top-level defs and their top-level dependencies reachable from a starting list of names
|| also include stdlib.blackHole, since DefPat thunks implicitly use them during evaluation.
reachableFrom :: [name] -> globalEnv -> m.map name [name]
reachableFrom ns genv
    = walk m.empty (stdBlackHoleName : ns)
      where
        walk seen [] = seen
        walk seen (n : ns)
            = walk seen ns,             if m.member cmpname n seen
            = walk seen' (ns ++ deps'), if isBuiltin n \/ isJust md
            = errNotFound n,            otherwise
              where
                md            = lookupDefn genv n
                d             = fromJust md
                deps          = lens.view astAnnoFree d |> filter topLevel   || find all top-level and builtin constructor dependencies
                deps'         = if' (isBuiltin n) [] deps               || no deps for builtins
                seen'         = m.insert cmpname n deps' seen
                errNotFound n = error ("buildStg: " ++ showName n ++ " not found")

                topLevel n = isConstructor n \/ ~isInternal n & ~isBuiltin n

|| make a top-level start function which evaluates the entry function of type io ()
|| and then exits
makeStart :: name -> globalEnv -> (name, globalEnv)
makeStart n genv
    = errNoSpec,      if isNothing mspec
    = errNotIO,       if ~ioWorldSpec spec
    = (start, genv'), otherwise
      where
        mspec      = lookupSpec genv n
        spec       = fromJust mspec |> lens.view defnType
        errNoSpec  = error ("entry function " ++ showName n ++ " not found")
        errNotIO   = error ("entry function must be type 'io ()', but is type '" ++ showAst spec ++ "'")
        start      = Qualified (getModName n) "!start"
        fns        = [n, worldName, builtinExitName]
        anno       = lens.set annoFree fns (genvAnno genv)
        startFn    = Ecase Csingle (Ecall (Evar n) [world]) [CaseAlt Pwildcard (Ecall builtinExit [EprimInt 0]) emptyAnno] emptyAnno
        def        = DefPat (Pvar start) startFn anno
        genv'      = lens.over (composeLens genvMod modDefns) (insDefnMapUnchecked def) genv

        || world type and World token used by io to sequence io actions
        tWorld     = Tname (Qualified "io" "world") []
        worldName  = Qualified "io" "World"
        world      = Evar worldName

        || must be "io ()" or its equivalent type expansion "World -> ((), World)"
        ioWorldSpec t
            = _eq cmptexpr t (Tname (Qualified "io" "io") [builtinTypeUnit]) \/
              _eq cmptexpr t (Tarr tWorld (Ttuple [builtinTypeUnit, tWorld]))

|| build the STG code & heap reachable from the start name, and return the top-level
|| localEnv map, along with the stg code and heap
buildStg :: name -> globalEnv -> (localEnv, stgCode, stgHeap)
buildStg n genv
    = (lens.view bdLenv st', lens.view bdCode st', lens.view bdHeap st')
      where
        (start', genv') = makeStart n genv
        topLevel        = reachableFrom [start'] genv'
        sccs            = m.toList topLevel |> makeDependencyGraph cmpname |> findSCCs cmpname
        (_, st)         = st.mapM_ (buildGroup genv') sccs (initBdSt genv')
        Imm (Haddr bhp) = lens.view bdLenv st |> m.lookup cmpname stdBlackHoleName |> fromJust
        bhTramp         = lens.view bdCodeMap st |> m.lookup cmpcodePtr blackHolePtr |> fromJust     || get existing blackHole trampoline code obj
        bhTramp'        = setSnd [Enter bhp []] bhTramp                                         || update trampoline to enter actual blackHole closure
        st'             = lens.over bdCodeMap (m.insert cmpcodePtr blackHolePtr bhTramp') st         || replace with new trampoline code
